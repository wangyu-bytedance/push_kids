{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Push Kids 知识沉淀状态机",
    "locale": "zh-CN",
    "output": "docs/architecture/diagrams/current-knowledge-settlement-lifecycle.html",
    "viewBox": [1080, 640],
    "animation": "none",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "formalization-gate",
        "label": "正式化门禁",
        "focus": ["submission-queued", "submission-analyzing", "submission-pending", "submission-confirmed", "formal-knowledge"],
        "note": "AI 只产生候选；家长确认事务才创建正式知识、发生记录和复习项。"
      },
      {
        "id": "failure-recovery",
        "label": "失败与恢复",
        "focus": ["submission-analyzing", "submission-failed", "submission-queued"],
        "note": "最多自动尝试三次，最终失败后允许家长重试。"
      },
      {
        "id": "cancel-exit",
        "label": "取消退出",
        "focus": ["submission-pending", "submission-cancelled"],
        "note": "取消会清除 AI 提议，不写正式学习、知识和复习数据。"
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "从提交草稿到正式知识" },
    { "id": "exceptions", "label": "分析失败与恢复" },
    { "id": "terminal", "label": "取消退出" }
  ],
  "states": [
    {
      "id": "submission-queued",
      "type": "start",
      "label": "排队草稿",
      "sublabel": "Submission.queued",
      "tag": "尚无候选",
      "step": "K1",
      "lane": "main",
      "col": 0
    },
    {
      "id": "submission-analyzing",
      "type": "active",
      "label": "分析中",
      "sublabel": "Submission.analyzing",
      "tag": "Worker + Ark",
      "step": "K2",
      "lane": "main",
      "col": 1
    },
    {
      "id": "submission-pending",
      "type": "waiting",
      "label": "AI 候选知识",
      "sublabel": "proposal_json",
      "tag": "可编辑，非正式",
      "step": "K3",
      "lane": "main",
      "col": 2
    },
    {
      "id": "submission-confirmed",
      "type": "decision",
      "label": "家长已确认",
      "sublabel": "Submission.confirmed",
      "tag": "事务门禁",
      "step": "K4",
      "lane": "main",
      "col": 3
    },
    {
      "id": "formal-knowledge",
      "type": "success",
      "label": "正式 KnowledgeItem",
      "sublabel": "无 status",
      "tag": "复用身份 + Occurrence",
      "step": "K5",
      "lane": "main",
      "col": 4
    },
    {
      "id": "submission-failed",
      "type": "failure",
      "label": "failed",
      "sublabel": "三次分析仍失败",
      "tag": "可恢复",
      "lane": "exceptions",
      "col": 0,
      "yOffset": 78
    },
    {
      "id": "submission-cancelled",
      "type": "failure",
      "label": "cancelled",
      "sublabel": "清空提议，不写正式表",
      "tag": "退出",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "start-analysis",
      "from": "submission-queued",
      "to": "submission-analyzing",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "write-proposal",
      "from": "submission-analyzing",
      "to": "submission-pending",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "parent-confirm",
      "from": "submission-pending",
      "to": "submission-confirmed",
      "variant": "security",
      "route": "straight"
    },
    {
      "id": "transaction-persist",
      "from": "submission-confirmed",
      "to": "formal-knowledge",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "analysis-failed",
      "from": "submission-analyzing",
      "to": "submission-failed",
      "label": "重试耗尽",
      "variant": "security"
    },
    {
      "id": "manual-retry",
      "from": "submission-failed",
      "to": "submission-queued",
      "label": "家长重试",
      "variant": "emphasis",
      "route": "left-channel"
    },
    {
      "id": "discard-proposal",
      "from": "submission-pending",
      "to": "submission-cancelled",
      "label": "取消或删除草稿",
      "variant": "security"
    }
  ]
}
