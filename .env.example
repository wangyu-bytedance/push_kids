# 直接在宿主机运行 API 时复制为 .env。该文件只供本地开发，不提交 Git，也不复制进镜像。
# Docker Compose 使用独立的 .env.runtime，避免把 WECHAT_CLI_PRIVATE_KEY 等开发者凭据注入容器。
PUSH_KIDS_ENV=development
PUSH_KIDS_DATABASE_URL=sqlite:///./data/push_kids.db
PUSH_KIDS_MEDIA_ROOT=./uploads
PUSH_KIDS_MEDIA_BACKEND=local
PUSH_KIDS_AI_PROVIDER=ark
PUSH_KIDS_RUN_WORKER=true
PUSH_KIDS_CORS_ORIGINS=http://localhost:3000
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260628

# 微信云托管 staging（在控制台配置为容器运行时环境变量，不要在仓库或 Dockerfile 中填写真实密钥）
# PUSH_KIDS_ENV=cloud
# MYSQL_ADDRESS=内网主机:3306
# MYSQL_USERNAME=最小权限应用账号
# MYSQL_PASSWORD=
# MYSQL_DATABASE=push_kids
# CBR_ENV_ID=prod-d2g14rwoycac6b45d
# WECHAT_APP_ID=wx5d2e0014690bf285
# WECHAT_SERVICE_NAME=flask-ik19
# PUSH_KIDS_ACTOR_HMAC_KEY=至少32字符的随机密钥
# PUSH_KIDS_MEDIA_BACKEND=wechat_cloud
# WECHAT_STORAGE_BUCKET=控制台显示的对象存储桶
# WECHAT_STORAGE_REGION=ap-shanghai
# WECHAT_STORAGE_CLOUD_PREFIX=cloud://控制台显示的当前环境前缀
