+    小提琴: "ico-music-pri",
+    舞蹈: "ico-dance-pri",
+    武术: "ico-martial-pri",
+    跆拳道: "ico-martial-pri",
+    书法: "ico-brush-pri",
+    绘画: "ico-palette-pri",
+    编程: "ico-code-pri",
+    机器人: "ico-robot-pri"
+  };
+  const used = new Set();
+  Object.keys(catalog).forEach((name) => {
+    assert.equal(ui.activityIcon(name, "pri"), catalog[name]);
