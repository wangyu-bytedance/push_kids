+  assert.equal(ui.activityIcon("画画", "pri"), "ico-palette-pri");
+  assert.equal(ui.activityIcon("陶艺", "pri"), "ico-palette-pri");
+  assert.equal(ui.activityIcon("空手道", "pri"), "ico-martial-pri");
+  assert.equal(ui.activityIcon("陶笛演奏"), "ico-star");
