page {
  --canvas: #f5f3ec;
  --surface: #fffefa;
  --surface-soft: #e8f1ed;
  --primary: #2f766d;
  --primary-dark: #225b54;
  --ink: #1f2926;
  --muted: #707873;
  --line: #e2e4df;
  --warm: #f2e6cf;
  --warning: #9a641f;
  --danger: #a94f48;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.55;
}

.page { padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.page-head { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 28rpx; }
.eyebrow { color: var(--muted); font-size: 24rpx; }
.title { display: block; font-size: 44rpx; line-height: 1.2; font-weight: 700; letter-spacing: -1rpx; }
.section-title { display: block; margin: 34rpx 0 16rpx; font-size: 32rpx; font-weight: 700; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.card { background: var(--surface); border: 1rpx solid rgba(56, 76, 69, 0.06); border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 8rpx 30rpx rgba(50, 70, 64, 0.05); }
.hero { background: linear-gradient(145deg, #dcece7, #eef2e6); padding: 34rpx; }
.hero-number { font-size: 64rpx; line-height: 1; font-weight: 750; color: var(--primary-dark); }
.hero-copy { margin: 12rpx 0 28rpx; color: #4d625c; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.button { min-height: 88rpx; box-sizing: border-box; border: none; border-radius: 22rpx; padding: 0 28rpx; background: var(--primary); color: #fff; font-size: 29rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; }
.button::after { border: none; }
.button.secondary { background: var(--surface-soft); color: var(--primary-dark); }
.button.ghost { background: transparent; color: var(--primary); border: 1rpx solid #b9d2cb; }
.button.compact { min-height: 72rpx; padding: 0 22rpx; font-size: 26rpx; }
.button.danger { background: #f7e8e6; color: var(--danger); }
.pill { display: inline-flex; align-items: center; min-height: 52rpx; padding: 0 18rpx; border-radius: 999rpx; background: var(--surface-soft); color: var(--primary-dark); font-size: 24rpx; }
.pill.warm { background: var(--warm); color: #795921; }
.notice { padding: 22rpx 24rpx; border-radius: 20rpx; background: #fff4db; color: #74511c; margin-bottom: 20rpx; }
.notice.error { background: #f8e8e7; color: #873e39; }
.empty { text-align: center; padding: 64rpx 32rpx; }
.empty-mark { width: 96rpx; height: 96rpx; margin: 0 auto 24rpx; border-radius: 48rpx; background: var(--surface-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.skeleton { height: 160rpx; border-radius: 24rpx; margin-bottom: 20rpx; background: linear-gradient(90deg, #ebece8 25%, #f6f7f4 37%, #ebece8 63%); background-size: 400% 100%; animation: pulse 1.4s ease infinite; }
@keyframes pulse { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.field { margin-bottom: 26rpx; }
.label { display: block; margin-bottom: 10rpx; color: #46534f; font-size: 26rpx; font-weight: 600; }
.input, .textarea, .picker { width: 100%; box-sizing: border-box; border-radius: 20rpx; border: 1rpx solid var(--line); background: #fff; padding: 22rpx 24rpx; min-height: 88rpx; }
.textarea { min-height: 220rpx; }
.divider { height: 1rpx; background: var(--line); margin: 22rpx 0; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.metric { background: var(--surface); border-radius: 24rpx; padding: 24rpx; }
.metric-value { display: block; font-size: 42rpx; line-height: 1.2; font-weight: 720; }
.bar-track { height: 16rpx; border-radius: 8rpx; background: #e9ece8; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; background: var(--primary); }
.timeline { border-left: 3rpx solid #d6e5df; margin-left: 12rpx; padding-left: 30rpx; }
.timeline-item { position: relative; margin-bottom: 24rpx; }
.timeline-item::before { content: ""; position: absolute; width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--primary); left: -40rpx; top: 12rpx; }
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.photo { width: 100%; height: 190rpx; border-radius: 18rpx; object-fit: cover; }
.safe-bottom { height: calc(20rpx + env(safe-area-inset-bottom)); }
.compact-head { display:flex; align-items:center; justify-content:space-between; }
.child-trigger { min-height:72rpx; display:flex; align-items:center; gap:12rpx; padding:0 18rpx 0 10rpx; border:1rpx solid #D9DDD7; border-radius:36rpx; background:var(--surface); font-size:26rpx; font-weight:650; }
.avatar-small { width:52rpx; height:52rpx; line-height:52rpx; text-align:center; border-radius:50%; background:#E2F0EA; color:var(--primary-dark); }
.chevron { width:12rpx; height:12rpx; border-right:3rpx solid #53635D; border-bottom:3rpx solid #53635D; transform:rotate(45deg) translateY(-3rpx); transition:transform .16s ease; }
.chevron.up { transform:rotate(225deg) translate(-2rpx,-2rpx); }
.sheet-mask { position:fixed; inset:0; z-index:20; background:rgba(22,36,31,.42); }
.sheet { position:fixed; left:0; right:0; bottom:0; z-index:21; max-height:84vh; overflow:auto; box-sizing:border-box; padding:16rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:34rpx 34rpx 0 0; background:var(--surface); }
.sheet-handle { width:76rpx; height:8rpx; margin:0 auto 24rpx; border-radius:4rpx; background:#D4D8D3; }
.sheet-title { display:block; font-size:38rpx; font-weight:750; }.icon-button { width:72rpx;height:72rpx;padding:0;border:0;border-radius:50%;background:#F0F1ED;font-size:38rpx; }.icon-button::after{border:0}
.segmented { display:grid; grid-template-columns:repeat(3,1fr); padding:7rpx; margin:12rpx 0 22rpx; border-radius:18rpx; background:#ECEDE9; }.segmented button{min-height:76rpx;padding:0;border:0;background:transparent;font-size:26rpx}.segmented button::after{border:0}.segmented button.active{background:#fff;border-radius:14rpx;color:var(--primary-dark);font-weight:700;box-shadow:0 3rpx 12rpx rgba(36,55,48,.08)}
.repeat-row { min-height:92rpx; margin-bottom:22rpx; border-top:1rpx solid var(--line); border-bottom:1rpx solid var(--line); }.time-separator{margin-top:28rpx;color:var(--muted)}
