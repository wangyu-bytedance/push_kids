.renewal-overlay { position: fixed; inset: 0; z-index: 160; display: flex; align-items: flex-end; justify-content: center; }
.renewal-mask { position: absolute; inset: 0; background: var(--pk-overlay); }
.renewal-sheet { position: relative; width: 100%; max-width: 480px; max-height: 88vh; box-sizing: border-box; background: var(--pk-surface); border-radius: 40rpx 40rpx 0 0; padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; color: var(--pk-ink); }
.renewal-handle { flex: none; width: 36px; height: 4px; margin: 0 auto 16px; border-radius: 4px; background: var(--pk-line-strong); }
.renewal-body { flex: 1; min-height: 0; max-height: 60vh; }
.renewal-kicker { display: block; font-size: 14px; color: var(--pk-ink-2); }
.renewal-title { display: block; margin-bottom: 12px; font: 600 22px/1.45 var(--pk-serif); }
.renewal-copy { display: block; margin-bottom: 12px; font-size: 15px; line-height: 1.6; color: var(--pk-ink-2); }
.renewal-actions { flex: none; display: flex; flex-direction: column; gap: 10px; padding-top: 16px; }
.renewal-sheet .renewal-actions .renewal-primary, .renewal-sheet .renewal-actions .renewal-secondary { width: 100%; min-width: 0; max-width: none; margin-left: 0; margin-right: 0; box-sizing: border-box; padding: 10px 12px; border-radius: 24rpx; font-size: 16px; line-height: 1.5; }
.renewal-primary { min-height: 48px; background: var(--pk-primary); color: var(--pk-surface); font-weight: 600; }
.renewal-secondary { min-height: 44px; border: 1px solid var(--pk-line); background: var(--pk-surface); color: var(--pk-ink-2); }
