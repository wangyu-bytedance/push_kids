.renewal-overlay { position: fixed; inset: 0; z-index: 160; display: flex; align-items: flex-end; justify-content: center; }
.renewal-mask { position: absolute; inset: 0; background: rgba(34,38,31,.32); }
.renewal-sheet { position: relative; width: 100%; max-width: 480px; max-height: 88vh; box-sizing: border-box; background: #FFFDF8; border-radius: 40rpx 40rpx 0 0; padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; color: #22261F; }
.renewal-handle { flex: none; width: 36px; height: 4px; margin: 0 auto 16px; border-radius: 4px; background: #DDD6C4; }
.renewal-body { flex: 1; min-height: 0; max-height: 60vh; }
.renewal-kicker { display: block; font-size: 14px; color: #464E43; }
.renewal-title { display: block; margin-bottom: 12px; font: 600 22px/1.45 "Songti SC",serif; }
.renewal-copy { display: block; margin-bottom: 12px; font-size: 15px; line-height: 1.6; color: #464E43; }
.renewal-actions { flex: none; display: flex; flex-direction: column; gap: 10px; padding-top: 16px; }
.renewal-sheet .renewal-actions .renewal-primary, .renewal-sheet .renewal-actions .renewal-secondary { width: 100%; min-width: 0; max-width: none; margin-left: 0; margin-right: 0; box-sizing: border-box; padding: 10px 12px; border-radius: 24rpx; font-size: 16px; line-height: 1.5; }
.renewal-primary { min-height: 48px; background: #1F5B45; color: #FFFDF8; font-weight: 600; }
.renewal-secondary { min-height: 44px; border: 1px solid #EBE5D7; background: #FFFDF8; color: #464E43; }
