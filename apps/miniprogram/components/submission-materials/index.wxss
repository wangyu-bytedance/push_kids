.materials{border-top:1px solid #DFE4DB;margin:20px 0;color:#263D35;font-size:14px}.toggle{display:flex;justify-content:space-between;align-items:center;min-height:44px;width:100%;margin:0;padding:10px 0;background:transparent;font-size:16px;font-weight:600;text-align:left;box-sizing:border-box}.toggle::after{border:0}.toggle text{font-size:14px;color:#2F766D}.photos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:12px 0}.photos button{display:block;width:100%;min-width:0;min-height:80px;margin:0;padding:12px 6px;white-space:normal;background:#E8F1EB;line-height:1.6;font-size:14px;box-sizing:border-box}.photos image{width:100%;height:100px}.photos text{display:block}.hint{color:#65736C;font-size:14px}.original{display:block;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;margin:12px 0}.error{padding:12px;background:#FFF1EB;color:#963F2D}.error button{min-height:44px;font-size:14px}
