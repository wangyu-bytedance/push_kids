<view class="todo card {{group.optional ? 'optional' : ''}}">
  <view class="row between">
    <view>
      <text class="subject">{{group.subject_name}}</text>
      <text class="method">{{group.review_method}}</text>
    </view>
    <view><text class="minutes">约 {{group.estimated_minutes}} 分钟</text><button class="practice-action" bindtap="practice">带练提示</button></view>
  </view>
  <view class="points">
    <view class="point" wx:for="{{group.items}}" wx:key="review_id">
      <text class="point-name">{{item.knowledge_name}}</text>
      <view class="actions">
        <button class="action primary" data-review-id="{{item.review_id}}" data-action="complete" bindtap="feedback">完成</button>
        <button class="action" data-review-id="{{item.review_id}}" data-action="reinforce" bindtap="feedback">需加强</button>
        <button class="action" data-review-id="{{item.review_id}}" data-action="partial" bindtap="feedback">部分</button>
        <button class="action" data-review-id="{{item.review_id}}" data-action="defer" bindtap="feedback">稍后</button>
      </view>
    </view>
  </view>
</view>
