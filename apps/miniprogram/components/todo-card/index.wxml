<view class="todo {{view.optional ? 'opt' : ''}}">
  <view class="rail"></view>
  <view class="todo-top">
    <view class="sub-mark {{view.subjectClass}}">{{view.subjectMark}}</view>
    <view class="grow">
      <text class="todo-title">{{view.title}}</text>
      <text class="todo-meta">{{view.meta}}</text>
    </view>
    <view class="pill {{view.optional ? 'neutral' : ''}}">{{view.status}}</view>
  </view>
  <view class="todo-why" wx:if="{{view.reason}}">
    <view class="ico ico-info-mute xs"></view>
    <text class="why-txt">{{view.reason}}</text>
  </view>
  <view class="todo-points">
    <view class="todo-pt" wx:for="{{view.items}}" wx:key="reviewId">
      <view class="pt-row">
        <view class="pt-dot {{item.done ? 'on' : ''}}">
          <view class="ico ico-check-inv xs" wx:if="{{item.done}}"></view>
        </view>
        <text class="pt-n {{item.done ? 'is-done' : ''}}">{{item.name}}</text>
        <view class="pt-done" wx:if="{{item.done}}">
          <text>已完成</text>
        </view>
        <block wx:else>
          <button class="btn sm act-done" disabled="{{busyId === item.reviewId}}" data-review-id="{{item.reviewId}}" data-action="complete" bindtap="feedback">{{busyId === item.reviewId ? '记录中' : '完成'}}</button>
          <view class="act-more {{panelId === item.reviewId ? 'on' : ''}}" aria-role="button" aria-label="其他反馈" data-review-id="{{item.reviewId}}" bindtap="openMore">
            <view class="ico ico-more sm"></view>
          </view>
        </block>
      </view>
      <view class="fb-panel" wx:if="{{panelId === item.reviewId}}">
        <text class="fb-hd">刚才的实际情况是：</text>
        <view class="fb" wx:for="{{view.actions}}" wx:for-item="fb" wx:for-index="fbIndex" wx:key="action" data-review-id="{{item.reviewId}}" data-action="{{fb.action}}" bindtap="feedback">
          <view class="ico sm {{fb.icon}}"></view>
          <view class="grow">
            <text class="fb-t">{{fb.label}}</text>
            <text class="fb-s">{{fb.effect}}</text>
          </view>
          <view class="chev right"></view>
        </view>
        <view class="fb-cancel" aria-role="button" bindtap="closePanel">收起</view>
      </view>
    </view>
  </view>
  <view class="todo-foot" aria-role="button" aria-label="查看带练提示" bindtap="practice">
    <view class="ico ico-clock-mute xs"></view>
    <text class="foot-txt">{{view.hint}}</text>
    <view class="chev right"></view>
  </view>
</view>
