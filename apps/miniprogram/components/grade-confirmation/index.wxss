.grade-overlay { position: fixed; inset: 0; z-index: 160; display: flex; align-items: flex-end; justify-content: center; }
.grade-mask { position: absolute; inset: 0; background: var(--pk-overlay); }
.grade-sheet { position: relative; width: 100%; max-width: 480px; max-height: calc(100vh - 74px); box-sizing: border-box; background: var(--pk-surface); color: var(--pk-ink); border-radius: 40rpx 40rpx 0 0; padding: 14px 20px calc(20px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.grade-handle { flex: none; width: 36px; height: 4px; background: var(--pk-line-strong); border-radius: 4px; margin: 0 auto 20px; }
.grade-body { flex: 1; min-height: 0; max-height: 60vh; }
.grade-title, .grade-latest, .grade-error { display: block; }
.grade-title { font: 600 22px/1.45 var(--pk-serif); margin-bottom: 20px; overflow-wrap: anywhere; word-break: break-all; }
.grade-picker { min-height: 52px; box-sizing: border-box; padding: 12px 14px; border: 1px solid var(--pk-line-strong); border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; font-size: 18px; line-height: 26px; }
.grade-picker-disabled { background: var(--pk-surface-sunken); color: var(--pk-ink-2); }
.grade-chevron { width: 7px; height: 7px; border-right: 1.5px solid var(--pk-ink-2); border-bottom: 1.5px solid var(--pk-ink-2); transform: rotate(45deg); margin-right: 3px; }
.grade-latest { font-size: 20px; line-height: 1.5; }
.grade-actions { flex: none; display: flex; gap: 12px; margin-top: 20px; }
.grade-sheet .grade-actions .grade-primary, .grade-sheet .grade-actions .grade-secondary { width: 0; min-width: 44px; max-width: none; min-height: 48px; margin: 0; box-sizing: border-box; padding: 12px; border-radius: 24rpx; font-size: 16px; line-height: 24px; }
.grade-sheet .grade-actions .grade-primary { flex: 2; }
.grade-sheet .grade-actions .grade-secondary { flex: 1; }
.grade-primary::after, .grade-secondary::after { border: 0; }
.grade-primary { background: var(--pk-primary); color: var(--pk-surface); font-weight: 600; }
.grade-secondary { background: var(--pk-surface-sunken); color: var(--pk-ink-2); font-weight: 400; }
.grade-sheet .grade-actions .grade-disabled { background: var(--pk-surface-sunken); color: var(--pk-ink-2); }
.grade-error { font-size: 14px; line-height: 1.6; margin-top: 12px; color: var(--pk-danger-ink); }
.grade-info { color: var(--pk-info); }
