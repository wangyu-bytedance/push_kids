/* 日程（C1~C3）：WeekStrip / Timeline / FAB 复用 atoms，这里只补本页几何。 */
.calendar-page { min-height: 100vh; padding-top: 0; padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.pg-head .head-intro { flex: 1; min-width: 0; }
.child-chip .chip-nm { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.child-chip.single { padding-right: 28rpx; }

/* 周导航：左右各一个 88rpx 触控块，中间是原生日期 picker */
.wk-nav { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) 88rpx; align-items: center; margin-bottom: 20rpx; }
.wk-nav .icon-btn { flex: 0 0 88rpx; width: 88rpx; height: 88rpx; min-height: 88rpx; background: transparent; }
.wk-picker { min-width: 0; }
.wk-month { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 17px; line-height: 1.45; font-weight: 600; }
.chev.left { transform: rotate(-135deg); }

/* 7 列等宽，单元 124rpx，圆点表示这天有安排 */
.week { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 8rpx; width: 100%; box-sizing: border-box; }

.day-bar { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 40rpx 4rpx 24rpx; }
.day-bar .day-title { font-size: 17px; line-height: 1.45; font-weight: 600; }
.day-bar .day-count { flex: none; font-size: 13px; color: var(--pk-ink-3); }

.tl .tl-card .link-btn { min-height: 72rpx; }

/* 编辑半屏（C3） */
.editor-sheet .time-row { display: flex; align-items: center; gap: 20rpx; }
.editor-sheet .time-row .grow { flex: 1; min-width: 0; }
.editor-sheet .time-to { flex: none; font-size: 14px; color: var(--pk-ink-3); }
.editor-sheet .pk-picker.is-error { border-color: var(--pk-danger); }
.editor-sheet .repeat-card { margin-top: 32rpx; }
.editor-sheet .del-row { display: flex; justify-content: center; margin-top: 8rpx; }
.editor-sheet .del-link { color: var(--pk-danger); }

/* 孩子切换半屏 */
.child-sheet .rowitem.on { background: var(--pk-primary-tint); }
.child-sheet .ava-lg { flex: none; width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--pk-primary); color: #fff; font-size: 14px; font-weight: 600; line-height: 80rpx; text-align: center; }
