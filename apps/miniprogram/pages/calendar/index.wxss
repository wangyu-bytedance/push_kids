.calendar-page { min-height: 100vh; padding-bottom:190rpx; box-sizing: border-box; }
.compact-head { display:flex; justify-content:space-between; align-items:center; min-height:99rpx; margin-bottom:42rpx }.calendar-context .screen-intro{margin:0}
.calendar-card{padding:29rpx 19rpx;border:1rpx solid var(--line);border-radius:35rpx;background:var(--surface)}.week-nav{display:grid;grid-template-columns:85rpx 1fr 85rpx;align-items:center;margin-bottom:19rpx}.week-nav .week-arrow{display:flex;align-items:center;justify-content:center;width:85rpx!important;min-width:85rpx!important;max-width:85rpx!important;height:85rpx;min-height:85rpx;margin:0;padding:0;border:0;background:transparent;color:var(--primary);font-size:40rpx;line-height:1;box-sizing:border-box}.week-arrow::after{border:0}.date-picker{text-align:center;color:var(--ink);font-size:29rpx;font-weight:600}
.week-strip { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:2rpx; width:100%; padding:0; box-sizing:border-box; }
.week-strip .week-day { display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%!important; max-width:100%!important; min-width:0!important; min-height:146rpx; margin:0; padding:0; border:0; background:transparent; color:var(--muted); font-size:21rpx; line-height:1.2; box-sizing:border-box; overflow:visible; }
.week-day::after { border:0; }.week-day text { display:block; }.week-day .day-number { display:flex;align-items:center;justify-content:center;width:65rpx;height:65rpx;margin-top:13rpx;color:var(--ink);font-size:29rpx;font-weight:550;box-sizing:border-box }
.week-day.active .day-number { border-radius:50%; color:white; background:var(--primary); }.event-mark{width:6rpx;height:6rpx;margin-top:5rpx;border-radius:50%;background:#c47a3f}
.agenda-title{display:flex;align-items:center;justify-content:space-between;margin-top:46rpx}.agenda-title .section-title{margin:0}.agenda { margin-top:23rpx; }.agenda-row { display:grid; grid-template-columns:142rpx minmax(0,1fr); gap:0; min-height:171rpx; padding:0; margin-bottom:29rpx; overflow:hidden; border:1rpx solid var(--line);border-radius:35rpx;background:var(--surface);box-sizing:border-box }
.agenda-time { display:flex;align-items:flex-start;justify-content:flex-start;margin:27rpx 0;padding:17rpx 0 0 35rpx;border-right:4rpx solid #D68C51;font-weight:650;color:#B0642E;box-sizing:border-box }.agenda-card { position:relative; padding:35rpx 28rpx; border:0;background:transparent;border-radius:0; }
.agenda-name { display:block; font-weight:700; }.agenda-row.past { opacity:.48; filter:grayscale(.7); }.past-label { position:absolute; right:18rpx; top:18rpx; font-size:22rpx; }
.calendar-add{display:flex;align-items:center;justify-content:center;gap:16rpx;position:fixed;right:35rpx;bottom:calc(122rpx + env(safe-area-inset-bottom));width:auto!important;min-width:220rpx!important;height:92rpx;min-height:92rpx;margin:0;padding:0 38rpx;border:0;border-radius:23rpx;background:var(--primary);color:#fff;font-size:27rpx;font-weight:600;line-height:1;box-sizing:border-box;box-shadow:0 12rpx 30rpx rgba(33,107,88,.16);z-index:5}.calendar-add::after{border:0}.plain{background:transparent;padding-top:90rpx}.plain text{display:block}.top-gap{margin-top:16rpx}
