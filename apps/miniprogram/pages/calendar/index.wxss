.calendar-page { min-height: 100vh; padding-bottom:190rpx; box-sizing: border-box; }
.compact-head { display:flex; justify-content:space-between; align-items:center; min-height:112rpx; }.calendar-context .screen-intro{margin:0}
.calendar-card{padding:12rpx 18rpx 8rpx;border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface)}.week-nav{display:grid;grid-template-columns:72rpx 1fr 72rpx;align-items:center;margin-top:4rpx}.week-nav .week-arrow{display:flex;align-items:center;justify-content:center;width:72rpx!important;min-width:72rpx!important;max-width:72rpx!important;height:72rpx;min-height:72rpx;margin:0;padding:0;border:0;background:transparent;color:var(--primary);font-size:40rpx;line-height:1;box-sizing:border-box}.week-arrow::after{border:0}.date-picker{text-align:center;color:var(--ink);font-size:27rpx;font-weight:650}
.week-strip { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:2rpx; width:100%; padding:4rpx 0 14rpx; box-sizing:border-box; }
.week-strip .week-day { display:flex; flex-direction:column; align-items:center; width:100%!important; max-width:100%!important; min-width:0!important; min-height:92rpx; margin:0; padding:8rpx 0; border:0; background:transparent; color:var(--muted); font-size:22rpx; line-height:1.2; box-sizing:border-box; overflow:visible; }
.week-day::after { border:0; }.week-day text { display:block; }.week-day .day-number { margin-top:10rpx; color:var(--ink); font-size:28rpx; font-weight:650; }
.week-day.active .day-number { width:54rpx; height:54rpx; line-height:54rpx; margin:8rpx auto 0; border-radius:50%; color:white; background:var(--primary); }.event-mark{width:6rpx;height:6rpx;margin-top:5rpx;border-radius:50%;background:#c47a3f}
.agenda-title{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.agenda-title .section-title{margin:0}.agenda { margin-top:12rpx; }.agenda-row { display:grid; grid-template-columns:96rpx 1fr; gap:12rpx; padding:0; margin-bottom:18rpx; }
.agenda-time { padding-top:30rpx; font-weight:650; color:#B0642E; }.agenda-card { position:relative; padding:24rpx 28rpx; border:1rpx solid var(--line);border-left:4rpx solid #D68C51; background:var(--surface); border-radius:20rpx; }
.agenda-name { display:block; font-weight:700; }.agenda-row.past { opacity:.48; filter:grayscale(.7); }.past-label { position:absolute; right:18rpx; top:18rpx; font-size:22rpx; }
.calendar-add{display:flex;align-items:center;justify-content:center;position:fixed;right:34rpx;bottom:calc(38rpx + env(safe-area-inset-bottom));width:auto!important;min-width:220rpx!important;height:92rpx;min-height:92rpx;margin:0;padding:0 30rpx;border:0;border-radius:20rpx;background:var(--primary);color:#fff;font-size:27rpx;font-weight:650;line-height:1;box-sizing:border-box;box-shadow:0 12rpx 30rpx rgba(33,107,88,.16);z-index:5}.calendar-add::after{border:0}.plain{background:transparent;padding-top:90rpx}.plain text{display:block}.top-gap{margin-top:16rpx}
