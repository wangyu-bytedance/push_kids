.onboarding-page{padding-top:70rpx}.onboarding-mark{width:104rpx;height:104rpx;line-height:104rpx;margin-bottom:30rpx;border-radius:34rpx;background:var(--surface-soft);color:var(--primary);text-align:center;font-size:52rpx;font-weight:750}.intro{display:block;margin:18rpx 0 44rpx;color:var(--muted)}.choice{display:block;width:100%;min-height:164rpx;margin-bottom:20rpx;padding:28rpx;text-align:left;border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface);color:var(--ink);font-size:26rpx}.choice::after,.text-action::after{border:0}.choice.primary-choice{background:#E4F0EB;border-color:#B8D6CC}.choice-title{display:block;margin-bottom:8rpx;color:var(--primary-dark);font-size:34rpx;font-weight:730}.text-action{width:100%;min-height:88rpx;margin-top:12rpx;border:0;background:transparent;color:var(--primary);font-size:27rpx}.pending-card .button{margin-top:30rpx}.request-code{display:block;margin:12rpx 0;padding:12rpx 16rpx;border-radius:14rpx;background:var(--surface-soft);color:var(--primary-dark);font-weight:700;text-align:center}
