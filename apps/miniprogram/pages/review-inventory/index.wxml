<view class="inventory-page" bindtap="closeActionMenu">
  <text class="page-title">复习条目</text>
  <text class="muted intro">看看学过什么，安排接下来的复习</text>
  <view class="view-tabs">
    <button wx:for="{{views}}" wx:key="id" class="tab {{view === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="changeView" aria-label="{{item.label}}{{view === item.id ? '，已选中' : ''}}">{{item.label}}</button>
  </view>
  <view class="choices dates" wx:if="{{view === 'time'}}">
    <view class="choice-cell"><button class="choice {{offset === 1 ? 'on' : ''}}" data-offset="1" bindtap="selectDay">明天 · 预计</button></view>
    <view class="choice-cell"><button class="choice {{offset === 2 ? 'on' : ''}}" data-offset="2" bindtap="selectDay">后天 · 预计</button></view>
  </view>
  <block wx:elif="{{view === 'subject'}}">
    <view class="choices">
      <view class="choice-cell" wx:for="{{subjects}}" wx:key="id"><button class="choice {{subjectId === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="selectSubject">{{item.name}} {{item.count}}项</button></view>
    </view>
    <view class="pager" wx:if="{{subjectCursor || subjectHasPrevious}}"><button bindtap="firstSubjects" disabled="{{subjectLoading || !subjectHasPrevious}}">科目首页</button><button bindtap="nextSubjects" disabled="{{subjectLoading || !subjectCursor}}">下一页科目</button></view>
    <text class="muted" wx:if="{{subjectLoading}}">正在读取科目…</text>
    <view class="error" wx:if="{{subjectError}}"><text>{{subjectError}}</text><button bindtap="firstSubjects">重新加载科目</button></view>
  </block>
  <view class="choices" wx:else>
    <view class="choice-cell"><button class="choice {{count === null ? 'on' : ''}}" data-count="all" bindtap="selectCount">全部</button></view>
    <view class="choice-cell" wx:for="{{counts}}" wx:key="*this"><button class="choice {{count === item ? 'on' : ''}}" data-count="{{item}}" bindtap="selectCount">{{item}} 次</button></view>
    <view class="choice-cell"><button class="choice {{count > 3 || showCountInput ? 'on' : ''}}" bindtap="openCount">{{count > 3 ? count + '次' : '指定次数'}}</button></view>
  </view>
  <view class="count-entry" wx:if="{{view === 'count' && showCountInput}}">
    <label for="exact-count">输入要查看的复习次数</label>
    <view class="count-entry-row">
      <input id="exact-count" type="number" value="{{countDraft}}" maxlength="10" bindinput="inputCount" bindconfirm="confirmCount" confirm-type="done" aria-label="复习次数，0至2147483647的整数" />
      <button class="count-submit" bindtap="confirmCount">查看</button>
    </view>
    <text class="count-error" wx:if="{{countError}}" aria-live="polite">{{countError}}</text>
    <button class="count-cancel" bindtap="closeCount">取消</button>
  </view>
  <text class="notice" wx:if="{{notice}}" aria-live="polite">{{notice}}</text>
  <view class="error" wx:if="{{error}}"><text>{{error}}</text><button bindtap="retry">{{conflict ? '重新加载' : '重试'}}</button></view>
  <view class="loading" wx:if="{{loading && !loaded}}"><view class="sk"></view><view class="sk"></view><text class="muted">正在读取复习条目…</text></view>
  <block wx:if="{{loaded && !showCountInput}}">
    <view class="result-head" wx:if="{{items.length}}"><text class="result-title" wx:if="{{view === 'time'}}">{{offset === 1 ? '明天' : '后天'}}预计安排 · {{total}} 项</text><text class="result-title" wx:else>本页 {{items.length}} 项</text><text class="muted" wx:if="{{view === 'time'}}">约 {{minutes}} 分钟</text><text class="muted" wx:else>共 {{total}} 项</text><text class="muted" wx:if="{{loading}}">正在更新…</text></view>
    <text class="muted result-explain" wx:if="{{items.length && view === 'time'}}">这是未来预览；条目下方的状态表示今天的安排情况。</text>
    <text class="muted result-explain" wx:elif="{{items.length && view === 'subject'}}">组内按复习次数从少到多展示。</text>
    <text class="muted result-explain" wx:elif="{{items.length && view === 'count'}}">按科目分组；下一页继续显示剩余条目。</text>
    <text class="notice" wx:if="{{view === 'time' && overBudget}}">手动安排已保留，比日常 {{budget}} 分钟预算多 {{overBudget}} 分钟。</text>
    <text class="muted readonly" wx:if="{{!canWrite}}">当前为只读，可查看条目和安排。</text>
    <view class="group {{group.expanded ? 'open' : ''}} {{actionMenuGroup === group.key ? 'menu-open' : ''}}" wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="group-toggle" aria-role="button" aria-label="{{group.name}}，本页{{group.entries.length}}项，{{group.expanded ? '收起' : '展开'}}" aria-expanded="{{group.expanded}}" data-key="{{group.key}}" catchtap="toggleGroup">
        <view class="subject-mark {{group.tone}}">{{group.mark}}</view>
        <view class="group-heading"><text class="group-name">{{group.name}}</text><text class="group-sub">本页 {{group.entries.length}} 个知识条目</text></view>
        <text class="group-status" wx:if="{{view === 'time'}}">预计安排</text>
        <view class="chev {{group.expanded ? 'up' : ''}}"></view>
      </view>
      <view class="group-body" wx:if="{{group.expanded}}">
        <view class="item {{actionMenuId === entry.knowledge_id ? 'menu-host' : ''}}" wx:for="{{group.entries}}" wx:for-item="entry" wx:key="knowledge_id">
          <view class="item-top">
            <view class="item-main">
              <text class="item-title">{{entry.knowledge_name}}</text>
              <text class="item-meta">{{entry.review_count === null ? '复习次数待核实' : '已复习 ' + entry.review_count + ' 次'}} · 上次复习：{{entry.last_reviewed_on || '尚未复习'}}</text>
              <text class="item-meta" wx:if="{{entry.dateText}}">{{entry.dateText}}</text>
              <text class="item-state">{{entry.arrangementText}}</text>
            </view>
            <button id="more-{{entry.knowledge_id}}" class="more {{actionMenuId === entry.knowledge_id ? 'on' : ''}}" wx:if="{{canWrite}}" data-id="{{entry.knowledge_id}}" catchtap="openActions" disabled="{{loading || saving}}" aria-label="{{entry.knowledge_name}}的更多操作" aria-expanded="{{actionMenuId === entry.knowledge_id}}"><view class="ico ico-more sm"></view></button>
          </view>
          <view id="menu-{{entry.knowledge_id}}" class="action-menu {{actionMenuAbove ? 'above' : ''}}" wx:if="{{actionMenuId === entry.knowledge_id && canWrite}}" catchtap="ignore" aria-label="{{entry.knowledge_name}}的操作">
            <button class="menu-option" data-action="tomorrow" catchtap="schedule" disabled="{{saving || conflict || !entry.can_schedule || (entry.manually_scheduled && entry.in_tomorrow_plan)}}">{{entry.manually_scheduled && entry.in_tomorrow_plan ? '已手动安排到明天' : '加入明天复习'}}</button>
            <button class="menu-option" data-action="day_after" catchtap="schedule" disabled="{{saving || conflict || !entry.can_schedule || !entry.in_tomorrow_plan}}">改到后天复习</button>
            <button class="menu-option danger" catchtap="askDelete" disabled="{{saving}}">删除条目</button>
          </view>
          <view class="error item-error" wx:if="{{target && target.knowledge_id === entry.knowledge_id && actionError}}"><text>{{actionError}}</text><button wx:if="{{conflict}}" catchtap="reload">读取最新安排</button></view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!items.length && !error}}"><text>{{view === 'time' ? '这一天暂无预计安排' : (view === 'count' && count !== null ? '没有已复习 ' + count + ' 次的条目' : '暂无知识条目')}}</text><button wx:if="{{view === 'count' && count !== null}}" data-count="all" bindtap="selectCount">查看全部次数</button></view>
    <view class="pager" wx:if="{{pageNumber > 1 || nextCursor}}"><button bindtap="reload" disabled="{{loading || pageNumber === 1}}">回到首页</button><text>第 {{pageNumber}} 页</text><button bindtap="nextPage" disabled="{{loading || !nextCursor}}">下一页</button></view>
  </block>
</view>

<view class="overlay" wx:if="{{deleting && target}}" bindtap="closeActions" catchtouchmove="ignore">
  <view class="sheet" catchtap="ignore" aria-role="dialog" aria-label="确认删除条目">
    <scroll-view scroll-y class="sheet-scroll">
      <text class="sheet-title">删除这个条目？</text><text class="target-name">{{target.knowledge_name}}</text>
      <text class="muted">将永久删除这条知识、相关复习历史和后续计划。同批其他知识、原始记录和图片会保留。删除后无法恢复。</text><button class="danger confirm-delete" bindtap="confirmDelete" disabled="{{saving || conflict || !canWrite}}" loading="{{saving}}">确认删除</button>
      <text class="muted" wx:if="{{saving}}">正在保存…</text>
      <view class="error" wx:if="{{actionError}}"><text>{{actionError}}</text><button wx:if="{{conflict}}" bindtap="reload">读取最新安排</button></view>
      <button bindtap="closeActions" disabled="{{saving}}">取消</button>
    </scroll-view>
  </view>
</view>
