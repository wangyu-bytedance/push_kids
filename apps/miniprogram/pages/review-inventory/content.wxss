.inventory-page { max-width: 480px; min-height: 100vh; margin: 0 auto; padding: 6px 18px calc(48px + env(safe-area-inset-bottom)); box-sizing: border-box; color: var(--pk-ink); font-size: 14px; line-height: 1.5; }
.muted { color: var(--pk-ink-2); font-size: 14px; font-weight: normal; }
.inventory-button { min-height: 44px; margin: 0; padding: 8px 12px; font-size: 14px; line-height: 1.5; color: var(--pk-ink); background: transparent; border-radius: 0; white-space: normal; }
.inventory-button::after { border: none; }
.inventory-button:disabled { color: var(--pk-ink-3); background: transparent; }
.inventory-button:focus-visible { outline: 2px solid var(--pk-primary); outline-offset: 2px; }
.view-tabs { display: flex; border-bottom: var(--pk-border-line); }
.tab { flex: 1; min-width: 0; min-height: 54px; padding: 8px 0; color: var(--pk-ink-2); font-size: 15px; }
.tab.on { color: var(--pk-primary); font-weight: 600; border-bottom: 3px solid var(--pk-primary); }
.filter-row { position: relative; z-index: 10; margin: 14px 0 15px; }
.filter-host { display: flex; flex-direction: column; }
.segmented { display: flex; gap: 8px; width: 100%; height: 52px; min-height: 52px; padding: 3px; box-sizing: border-box; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); }
.segment { flex: 1; min-width: 0; height: 44px; min-height: 44px; padding: 6px 4px; box-sizing: border-box; border-radius: var(--pk-r-xs); font-size: 14px; }
.segment.on { color: var(--pk-primary); background: var(--pk-primary-tint); font-weight: 600; }
.status-row { margin: 12px 0 4px; }
.status-segment { flex: 1; min-width: 0; height: 44px; min-height: 44px; padding: 6px 4px; box-sizing: border-box; border-radius: var(--pk-r-xs); font-size: 14px; }
.status-segment.on { color: var(--pk-primary); background: var(--pk-primary-tint); font-weight: 600; }
.item-coverage { display: block; margin-top: 6px; color: var(--pk-ink-2); overflow-wrap: anywhere; font-size: 14px; }
.source-link { display: block; min-height: 44px; margin-top: 4px; padding-left: 0; color: var(--pk-primary); text-align: left; }
.filter-trigger { display: flex; align-items: center; width: 100%; max-width: none; min-height: 50px; margin-left: 0; margin-right: 0; box-sizing: border-box; padding: 8px 14px; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); text-align: left; }
.filter-label { flex: none; margin-right: 18px; color: var(--pk-ink-3); }
.filter-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.filter-chevron { flex: none; width: 9px; height: 9px; margin: -4px 4px 0 8px; border-right: 2px solid var(--pk-primary); border-bottom: 2px solid var(--pk-primary); transform: rotate(45deg); }
.filter-chevron.up { margin-top: 5px; transform: rotate(225deg); }
.filter-panel { position: absolute; top: calc(100% + 5px); left: 0; right: 0; z-index: 30; overflow: hidden; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); box-shadow: var(--pk-e3); }
.filter-scroll { max-height: 45vh; }
.filter-option { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: none; min-height: 48px; margin-left: 0; margin-right: 0; padding: 10px 16px; box-sizing: border-box; text-align: left; }
.filter-option + .filter-option { border-top: var(--pk-border-line); }
.filter-option.selected { color: var(--pk-primary); background: var(--pk-primary-tint); font-weight: 600; }
.filter-option-count { color: var(--pk-ink-3); font-weight: normal; }
.subject-pager { padding: 8px 12px; border-top: var(--pk-border-line); }
.count-entry { position: relative; z-index: 11; margin: -6px 0 16px; padding: 14px; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); }
.count-entry-label { display: block; margin-bottom: 8px; }
.count-entry-row { display: flex; gap: 8px; }
.count-entry-input { flex: 1; min-width: 0; height: 44px; box-sizing: border-box; padding: 7px 10px; border: var(--pk-border-line); border-radius: var(--pk-r-xs); background: var(--pk-surface); font-size: 16px; }
.count-submit { min-width: 72px; border-radius: var(--pk-r-xs); background: var(--pk-primary); color: var(--pk-ink-inv); }
.count-error { display: block; margin-top: 5px; color: var(--pk-danger); }
.count-cancel { display: block; margin: 2px 0 0 auto; color: var(--pk-primary); }
.result-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; margin: 4px 1px 0; }
.result-title { font-family: var(--pk-serif); font-size: 19px; font-weight: 600; line-height: 1.35; }
.result-explain { display: block; margin: 3px 1px 16px; color: var(--pk-ink-3); font-size: 14px; }
.group { position: relative; margin: 12px 0; overflow: visible; border: var(--pk-border-line); border-radius: var(--pk-r-xl); background: var(--pk-surface); box-shadow: var(--pk-e1); }
.group:not(.flat)::before { position: absolute; top: 16px; bottom: 16px; left: 0; width: 4px; border-radius: 4px; background: var(--pk-primary); content: ""; }
.group.menu-open { z-index: 5; }
.group-toggle { display: flex; align-items: center; gap: 10px; min-height: 61px; box-sizing: border-box; padding: 12px 15px; }
.subject-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--pk-r-md); background: var(--pk-sub-other-bg); color: var(--pk-sub-other); font-family: var(--pk-serif); font-size: 17px; font-weight: 600; }
.subject-mark.chinese { background: var(--pk-sub-chinese-bg); color: var(--pk-sub-chinese); }
.subject-mark.math { background: var(--pk-sub-math-bg); color: var(--pk-sub-math); }
.subject-mark.english { background: var(--pk-sub-english-bg); color: var(--pk-sub-english); }
.group-heading { flex: 1; min-width: 0; }
.group-name { display: block; overflow-wrap: anywhere; font-size: 16px; font-weight: 600; line-height: 1.4; }
.group-count { margin-left: 4px; color: var(--pk-ink-3); font-size: 14px; font-weight: normal; }
.chev { flex: none; width: 9px; height: 9px; margin: -4px 5px 0 0; border-right: 2px solid var(--pk-ink-3); border-bottom: 2px solid var(--pk-ink-3); transform: rotate(45deg); }
.chev.up { margin-top: 5px; transform: rotate(225deg); }
.group-body { padding: 0 15px 8px; }
.group.flat { margin-top: 13px; }
.group.flat .group-body { padding-top: 2px; }
.item { position: relative; padding: 13px 0 14px; }
.item + .item { border-top: var(--pk-border-line); }
.item.menu-host { z-index: 6; }
.item-top { display: flex; align-items: flex-start; gap: 8px; min-height: 44px; }
.item-main { flex: 1; min-width: 0; }
.item-title, .item-meta, .item-date, .item-state { display: block; overflow-wrap: anywhere; }
.item-title { font-size: 15px; line-height: 1.43; font-weight: 600; }
.item-meta { margin-top: 3px; color: var(--pk-ink-2); font-size: 14px; line-height: 1.45; }
.item-bottom { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; column-gap: 8px; margin-top: 3px; }
.item-date, .item-state { font-size: 14px; line-height: 1.45; }
.item-date { color: var(--pk-ink-3); }
.item-state { margin-left: auto; color: var(--pk-primary); }
.more { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; min-width: 44px; max-width: 44px; height: 44px; min-height: 44px; max-height: 44px; padding: 0; box-sizing: border-box; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); }
.more.on { border-color: var(--pk-primary); background: var(--pk-primary-tint); }
.action-menu { position: absolute; top: 60px; right: 0; z-index: 7; width: 220px; max-width: calc(100vw - 44px); box-sizing: border-box; padding: 5px; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); box-shadow: var(--pk-e3); }
.action-menu.above { top: auto; bottom: 100%; }
.menu-option { display: block; width: 100%; min-height: 48px; padding: 10px 12px; border-radius: var(--pk-r-xs); text-align: left; font-size: 14px; }
.menu-option + .menu-option { border-top: var(--pk-border-line); border-radius: 0; }
.menu-option.danger { color: var(--pk-danger); }
.item-error { margin-top: 8px; }
.notice, .readonly { display: block; padding: 12px 0; }
.notice { color: var(--pk-primary); }
.error { display: block; color: var(--pk-danger); margin: 12px 0; }
.error .inventory-button { color: var(--pk-primary); }
.inventory-pagination { display: grid; grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1fr); align-items: center; gap: 8px; margin: 16px 0; }
.inventory-pagination.subject-pager { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
.inventory-pagination .inventory-page-button { width: 100%; max-width: none; min-width: 0; min-height: 44px; margin: 0; padding: 10px 4px; box-sizing: border-box; border-radius: var(--pk-r-md); background: var(--pk-primary-tint); color: var(--pk-primary); box-shadow: none; font-size: 14px; line-height: 24px; }
.inventory-pagination .inventory-page-button[disabled] { color: var(--pk-ink-3); background: transparent; box-shadow: none; }
.inventory-page-label { min-width: 0; text-align: center; font-size: 14px; line-height: 20px; overflow-wrap: anywhere; }
.empty { margin: 18px 0; padding: 34px 18px; border: var(--pk-border-line); border-radius: var(--pk-r-xl); background: var(--pk-surface); text-align: center; color: var(--pk-ink-2); }
.empty .inventory-button { margin-top: 16px; color: var(--pk-primary); }
.loading .sk { height: 100px; margin: 16px 0; }
.overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(24, 28, 20, .44); }
.sheet { width: 100%; max-width: 480px; margin: 0 auto; background: var(--pk-surface); border-radius: var(--pk-r-lg) var(--pk-r-lg) 0 0; box-sizing: border-box; padding: 24px 20px calc(16px + env(safe-area-inset-bottom)); }
.sheet-scroll { max-height: 75vh; }
.sheet-title { display: block; font-family: var(--pk-serif); font-size: 22px; margin-bottom: 12px; }
.target-name { display: block; font-size: 18px; word-break: break-all; margin-bottom: 16px; }
.danger { color: var(--pk-danger); }
.confirm-delete { margin: 20px 0; border: 1px solid var(--pk-danger); border-radius: var(--pk-r-lg); }
@media (max-width: 340px) { .inventory-page { padding-left: 12px; padding-right: 12px; } .group-toggle { gap: 8px; padding: 12px; } .group-body { padding-left: 12px; padding-right: 12px; } .item-title { font-size: 14px; } }
