.inventory-page { max-width: 480px; margin: 0 auto; padding: 16px 16px calc(48px + env(safe-area-inset-bottom)); box-sizing: border-box; color: var(--pk-ink); font-size: 14px; line-height: 1.5; }
.page-title, .sheet-title { display: block; font-family: var(--pk-serif); font-size: 26px; font-weight: 600; }
.muted { color: var(--pk-ink-2); font-size: 14px; font-weight: normal; }
.intro { display: block; margin: 8px 0 16px; }
button { min-height: 44px; margin: 0; padding: 8px 12px; font-size: 14px; line-height: 1.5; color: var(--pk-ink); background: transparent; border-radius: 0; white-space: normal; word-break: break-all; }
button::after { border: none; }
button[disabled] { color: var(--pk-ink-3); background: transparent; }
button:focus-visible { outline: 2px solid var(--pk-primary); outline-offset: 2px; }
.view-tabs { display: flex; margin-top: 15px; border-bottom: var(--pk-border-line); }
.tab { flex: 1; min-width: 0; min-height: 48px; padding: 8px 0; font-size: 15px; color: var(--pk-ink-2); }
.tab.on { color: var(--pk-primary); font-weight: 600; border-bottom: 3px solid var(--pk-primary); }
.choices { display: flex; flex-wrap: wrap; align-items: stretch; margin: 14px -4px 8px; }
.choice-cell { display: flex; flex: 0 0 33.333333%; width: 33.333333%; min-width: 0; box-sizing: border-box; padding: 0 4px 8px; }
.dates .choice-cell { flex-basis: 50%; width: 50%; }
.choice { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: 7px 6px; box-sizing: border-box; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); text-align: center; font-size: 14px; word-break: break-word; overflow-wrap: anywhere; }
.choice.on { color: var(--pk-primary); font-weight: 600; border-color: var(--pk-primary); background: var(--pk-primary-tint); }
.count-entry { margin: -2px 0 16px; padding: 14px; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); }
.count-entry label { display: block; margin-bottom: 8px; }
.count-entry-row { display: flex; gap: 8px; }
.count-entry input { flex: 1; min-width: 0; height: 44px; box-sizing: border-box; padding: 7px 10px; border: var(--pk-border-line); border-radius: var(--pk-r-xs); background: var(--pk-surface); font-size: 16px; }
.count-submit { min-width: 72px; border-radius: var(--pk-r-xs); background: var(--pk-primary); color: var(--pk-ink-inv); }
.count-error { display: block; margin-top: 5px; color: var(--pk-danger); }
.count-cancel { display: block; margin: 2px 0 0 auto; color: var(--pk-primary); }
.result-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin: 5px 2px 2px; }
.result-title { font-size: 17px; font-weight: 600; line-height: 1.35; }
.result-explain { display: block; margin: 4px 2px 16px; color: var(--pk-ink-3); }
.group { position: relative; margin: 0 0 14px; border: var(--pk-border-line); border-left: 5px solid var(--pk-primary); border-radius: var(--pk-r-xl); background: var(--pk-surface); box-shadow: var(--pk-e1); }
.group.menu-open { z-index: 5; }
.group-toggle { display: flex; align-items: center; gap: 11px; min-height: 72px; box-sizing: border-box; padding: 15px 18px 15px 17px; }
.subject-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--pk-r-md); background: var(--pk-sub-other-bg); color: var(--pk-sub-other); font-family: var(--pk-serif); font-size: 18px; font-weight: 600; }
.subject-mark.chinese { background: var(--pk-sub-chinese-bg); color: var(--pk-sub-chinese); }
.subject-mark.math { background: var(--pk-sub-math-bg); color: var(--pk-sub-math); }
.subject-mark.english { background: var(--pk-sub-english-bg); color: var(--pk-sub-english); }
.group-heading { flex: 1; min-width: 0; }
.group-name, .group-sub { display: block; overflow-wrap: anywhere; }
.group-name { font-size: 17px; font-weight: 600; line-height: 1.4; }
.group-sub { color: var(--pk-ink-3); font-size: 14px; }
.group-status { flex: none; padding: 5px 9px; border-radius: var(--pk-r-pill); background: var(--pk-primary-tint); color: var(--pk-primary); font-size: 14px; }
.group-body { padding: 0 18px 8px 17px; }
.item { position: relative; padding: 13px 0 14px; }
.item + .item { border-top: var(--pk-border-line); }
.item.menu-host { z-index: 6; }
.item-top { position: relative; min-height: 44px; }
.item-main { width: 100%; min-width: 0; box-sizing: border-box; }
.item-title, .item-meta, .item-state { display: block; overflow-wrap: anywhere; }
.item-title { box-sizing: border-box; padding-right: 54px; font-size: 16px; line-height: 1.48; font-weight: 500; }
.item-meta { box-sizing: border-box; padding-right: 54px; margin-top: 6px; color: var(--pk-ink-3); font-size: 14px; line-height: 1.5; }
.item-meta + .item-meta { margin-top: 2px; }
.item-state { margin-top: 7px; color: var(--pk-primary); font-size: 14px; }
.more { position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 44px; min-width: 44px; max-width: 44px; height: 44px; min-height: 44px; max-height: 44px; margin: 0; padding: 0; box-sizing: border-box; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); }
.more.on { border-color: var(--pk-primary); background: var(--pk-primary-tint); }
.action-menu { position: absolute; top: 64px; right: 0; z-index: 7; width: 238px; max-width: calc(100vw - 56px); box-sizing: border-box; padding: 5px; border: var(--pk-border-line); border-radius: var(--pk-r-md); background: var(--pk-surface); box-shadow: var(--pk-e3); }
.action-menu.above { top: auto; bottom: calc(100% - 5px); }
.menu-option { display: block; width: 100%; min-height: 48px; padding: 10px 12px; border-radius: var(--pk-r-xs); text-align: left; font-size: 14px; }
.menu-option + .menu-option { border-top: var(--pk-border-line); border-radius: 0; }
.menu-option.danger { color: var(--pk-danger); }
.item-error { margin-top: 8px; }
.notice, .readonly { display: block; padding: 12px 0; }
.notice { color: var(--pk-primary); }
.error { display: block; color: var(--pk-danger); margin: 12px 0; }
.error button { color: var(--pk-primary); }
.pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 16px 0; }
.empty { margin: 18px 0; padding: 40px 18px; border: var(--pk-border-line); border-radius: var(--pk-r-xl); background: var(--pk-surface); text-align: center; color: var(--pk-ink-2); }
.empty button { margin-top: 16px; color: var(--pk-primary); }
.loading .sk { height: 140px; margin: 16px 0; }
.overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(24, 28, 20, .44); }
.sheet { width: 100%; max-width: 480px; margin: 0 auto; background: var(--pk-surface); border-radius: var(--pk-r-lg) var(--pk-r-lg) 0 0; box-sizing: border-box; padding: 24px 20px calc(16px + env(safe-area-inset-bottom)); }
.sheet-scroll { max-height: 75vh; }
.sheet-title { font-size: 22px; margin-bottom: 12px; }
.target-name { display: block; font-size: 18px; word-break: break-all; margin-bottom: 16px; }
.danger { color: var(--pk-danger); }
.confirm-delete { margin: 20px 0; border: 1px solid var(--pk-danger); border-radius: var(--pk-r-lg); }
@media (max-width: 340px) { .inventory-page { padding: 14px 12px 40px; } .group-toggle { gap: 8px; padding: 14px 12px 14px 13px; } .group-body { padding: 0 12px 6px 13px; } .subject-mark { width: 36px; height: 36px; } .group-status { padding: 4px 6px; } .item-title { font-size: 15px; } }
