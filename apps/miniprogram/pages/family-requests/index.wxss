.block{display:block}.tiny{font-size:20rpx}.request-card{margin-top:20rpx}.request-head{display:flex;align-items:flex-start;gap:12rpx}.request-title{margin:0}.request-code{flex:none;padding:7rpx 12rpx;border-radius:12rpx;background:var(--surface-soft);color:var(--primary-dark);font-size:20rpx;font-weight:700}.request-copy{margin-top:14rpx}.role-actions{display:grid;gap:12rpx;margin-top:24rpx}.role-actions button{width:100%;min-width:0;min-height:84rpx;margin:0;border:1rpx solid #B8D6CC;background:#E8F2EE;color:var(--primary-dark);font-size:26rpx;box-sizing:border-box}.role-actions button::after,.reject::after{border:0}.reject{width:100%;min-height:80rpx;margin:10rpx 0 0;border:0;background:transparent;color:var(--danger);font-size:25rpx}
