<import src="history.wxml" />
<view class="page record-page">
  <view class="compact-head"><view class="screen-intro"><text class="screen-kicker">照片和文字，都是成长的线索</text><text class="screen-heading">学习记录</text></view><picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view></picker></view>
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 点此重试</view>
  <view class="empty plain" wx:if="{{!loading && !children.length}}">尚未由后台配置学习档案</view>
  <block wx:if="{{children.length}}">
    <view class="segmented two history-switch"><button class="{{recordView === 'new' ? 'active' : ''}}" data-view="new" bindtap="changeRecordView">新增记录</button><button class="{{recordView === 'history' ? 'active' : ''}}" data-view="history" bindtap="changeRecordView">历史记录</button></view>
    <block wx:if="{{recordView === 'new' && canWrite}}">
    <button wx:if="{{pendingCount}}" class="notice history-notice" bindtap="openHistoryPending">有 {{pendingCount}} 条待处理 · 查看 ›</button>
    <button wx:if="{{submittedId}}" class="notice history-notice" bindtap="openSubmitted">已提交，等待处理 · 查看这条记录 ›</button>
    <view class="mode-tabs"><button class="{{mode === 'photo' ? 'active' : ''}}" data-mode="photo" bindtap="changeMode">拍照记录</button><button class="{{mode === 'text' ? 'active' : ''}}" data-mode="text" bindtap="changeMode">文字记录</button></view>
    <view class="time-summary"><view><text class="muted small">实际发生时间</text><text>{{date}} · {{time}}</text></view><view class="time-pickers"><picker mode="date" value="{{date}}" data-field="date" bindchange="setField"><text>日期</text></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="setField"><text>时间</text></picker></view></view>
    <view wx:if="{{mode === 'photo'}}"><view class="row between field-label"><text>学习照片</text><text class="muted small">{{photos.length}} / 9</text></view><view class="upload-actions" wx:if="{{!photos.length}}"><button bindtap="chooseCamera"><view class="upload-content"><text class="upload-icon">＋</text><text class="upload-label">拍摄一张</text></view></button><button bindtap="chooseAlbum"><view class="upload-content"><text class="album-icon"></text><text class="upload-label">从相册选择</text></view></button></view><view class="photo-grid" wx:else><view class="photo-wrap" wx:for="{{photos}}" wx:key="*this"><image class="photo" src="{{item}}" mode="aspectFill"></image><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto">×</button></view><button class="photo-add" bindtap="chooseAlbum">＋</button></view></view>
    <view class="field"><view class="row between"><text class="label">{{mode === 'photo' ? '补充内容' : '学习内容'}}</text><text class="muted small" wx:if="{{mode === 'photo'}}">选填</text></view><textarea class="textarea compact-textarea" value="{{text}}" data-field="text" bindinput="setField" maxlength="4000" placeholder="{{mode === 'photo' ? '例如：今天练习了乘法，重点是进位。' : '写下今天实际学过的内容'}}"></textarea></view>
    <text class="form-helper">{{mode === 'photo' ? '照片会整理成可编辑的草稿，由你确认后再存为学习记录。' : '文字会整理成可编辑的草稿，由你确认后再存为学习记录。'}}</text>
    <view class="action-row submit-row"><button class="button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? (mode === 'photo' ? '上传中 ' + uploadProgress + '%' : '提交中') : (mode === 'photo' ? '▧　选择照片后继续' : '继续整理草稿')}}</button></view>
    </block>
    <template wx:else is="history" data="{{historyView,historyItems,historyLoading,historyError,historyPage,historyNext,historyFilters,hasFilters,pendingCount,searchText,filterOpen,filterDraft,filterSubjects,filterSubjectIndex,filterError}}" />
  </block>
</view>
