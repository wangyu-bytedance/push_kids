<import src="history.wxml" />
<primary-nav></primary-nav>
<view class="page record-page {{canWrite && children.length ? 'sticky-cta' : ''}}">
  <view class="pg-head">
    <view class="grow">
      <text class="pg-title">一笔一画，都算数</text>
    </view>
    <picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild">
      <view class="child-chip {{children.length === 1 ? 'single' : ''}}">
        <text class="ava">{{children[childIndex].avatar}}</text>
        <text class="chip-nm">{{children[childIndex].name}}</text>
        <view class="chev" wx:if="{{children.length > 1}}"></view>
      </view>
    </picker>
  </view>

  <view class="pk-notice err" wx:if="{{error}}">
    <view class="ico ico-cloud-off-dan sm"></view>
    <text class="n-txt">{{error}}</text>
    <view class="ico ico-refresh-dan sm" aria-role="button" aria-label="重新读取" bindtap="load"></view>
  </view>

  <block wx:if="{{loading && !children.length}}">
    <view class="sk h20 mt3"></view>
    <view class="sk card-sk"></view>
    <view class="sk card-sk"></view>
  </block>

  <view class="pk-empty" wx:if="{{!loading && !children.length}}">
    <view class="em"><view class="ico ico-family-pri lg"></view></view>
    <text class="et">还没有学习档案</text>
    <text class="ec">学习档案由家庭管理员配置，配置好后就能在这里记录学习内容。</text>
  </view>

  <block wx:if="{{children.length}}">
    <block wx:if="{{canWrite}}">
      <view class="pk-notice mt3" wx:if="{{pendingCount}}" aria-role="button" aria-label="查看待处理记录" bindtap="openHistoryPending">
        <view class="ico ico-sparkle-att sm"></view>
        <text class="n-txt">有 {{pendingCount}} 条待处理 · 查看</text>
        <view class="chev right"></view>
      </view>
      <view class="pk-notice quiet mt3" wx:if="{{submittedId}}" aria-role="button" aria-label="查看刚提交的这条记录" bindtap="openSubmitted">
        <view class="ico ico-clock sm"></view>
        <text class="n-txt">已提交，正在整理 · 查看这条记录</text>
        <view class="chev right"></view>
      </view>

      <view class="pk-card tight time-card mt3">
        <view class="flex">
          <view class="ico ico-clock sm"></view>
          <view class="grow">
            <text class="t-cap c-ink-3">实际学习时间</text>
            <text class="time-val tnum">{{date}} · {{time}}</text>
          </view>
          <view class="btn sm neutral {{saving ? 'is-disabled' : ''}}" aria-role="button" aria-label="修改实际学习时间" bindtap="toggleTime">{{timeOpen ? '收起' : '修改'}}</view>
        </view>
        <view class="btn-row mt3" wx:if="{{timeOpen}}">
          <picker mode="date" value="{{date}}" end="{{today}}" data-field="date" bindchange="setField">
            <view class="pk-picker"><text class="tnum">{{dateLabel}}</text><view class="chev"></view></view>
          </picker>
          <picker mode="time" value="{{time}}" data-field="time" bindchange="setField">
            <view class="pk-picker"><text class="tnum">{{time}}</text><view class="chev"></view></view>
          </picker>
        </view>
      </view>

      <view class="pk-notice info mt2" wx:if="{{backfill}}">
        <view class="ico ico-info sm"></view>
        <text class="n-txt">历史补录只安排今天起的复习检查，不会补出过去的待办。</text>
      </view>

      <view class="flex between field-head">
        <text class="t-sub-m">学习照片</text>
        <text class="t-cap c-ink-3 tnum">{{photos.length}} / 9</text>
      </view>
      <view class="up-tile add-photo-tile" wx:if="{{!photos.length}}" aria-role="button"
        aria-label="添加学习照片，可拍摄或从相册选择" bindtap="addPhotos">
        <view class="ico ico-camera-pri lg"></view>
        <text>添加学习照片</text>
        <text class="us">拍摄或从相册选择</text>
      </view>
      <block wx:else>
        <view class="pgrid">
          <view class="pcell" wx:for="{{photos}}" wx:key="*this">
            <image class="pimg" src="{{item}}" mode="aspectFill"></image>
            <view class="idx tnum">照片 {{index + 1}}</view>
            <view class="rm" wx:if="{{!saving}}" aria-role="button" aria-label="移除第 {{index + 1}} 张照片" data-index="{{index}}" bindtap="removePhoto">
              <view class="ico ico-close-inv xs"></view>
            </view>
          </view>
          <view class="pcell add" wx:if="{{photos.length < 9 && !saving}}" aria-role="button"
            aria-label="继续添加照片，可拍摄或从相册选择" bindtap="addPhotos">
            <view class="ph-center"><view class="ico ico-plus"></view></view>
          </view>
        </view>
        <view class="mt3" wx:if="{{saving}}">
          <view class="prog-line"><view class="pf" style="width: {{uploadProgress}}%"></view></view>
          <view class="flex between mt1">
            <text class="t-cap c-ink-3">正在上传照片，别关掉这个页面</text>
            <text class="t-cap c-ink-3 tnum">{{uploadProgress}}%</text>
          </view>
        </view>
      </block>

      <view class="pk-field mt4">
        <text class="lbl">学习内容</text>
        <textarea class="pk-textarea text-input" value="{{text}}" data-field="text" bindinput="setField" maxlength="4000"
          adjust-position="{{true}}" placeholder="可补充照片里不明显的内容，也可以直接写下今天学了什么。" placeholder-class="pk-ph"></textarea>
        <text class="counter tnum text-counter">{{text.length}} / 4000</text>
      </view>

    </block>

    <view id="record-history" class="history-section {{historyExpanded ? 'expanded' : ''}}">
      <view class="pk-card tight history-toggle" aria-role="button" aria-label="{{historyExpanded ? '收起历史记录' : '展开历史记录'}}" aria-expanded="{{historyExpanded}}" bindtap="toggleHistory">
        <view class="flex">
          <view class="ico ico-clock sm"></view>
          <text class="t-sub-m grow">历史记录</text>
          <text class="t-cap c-ink-3" wx:if="{{pendingCount}}">{{pendingCount}} 条待处理</text>
          <view class="chev {{historyExpanded ? 'up' : ''}}"></view>
        </view>
      </view>
      <template wx:if="{{historyExpanded}}" is="history" data="{{historyView,historyItems,historyLoading,historyError,historyPage,historyNext,historyFilters,hasFilters,pendingCount,pendingProcessing,searchText,filterOpen,filterDraft,filterSubjects,filterSubjectIndex,filterError,sourceOptions,canWrite}}" />
    </view>
  </block>
</view>

<view class="pk-cta-bar record-cta" wx:if="{{children.length && canWrite}}">
  <view class="action-row submit-row">
    <view class="btn {{saving ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{saving ? (photos.length ? '正在上传照片' : '正在提交文字记录') : (photos.length ? '上传并整理' : (hasText ? '提交整理' : '添加照片或文字后继续'))}}" bindtap="save">
      <view class="ico ico-sparkle-inv sm" wx:if="{{!saving}}"></view>
      <text>{{saving ? (photos.length ? '上传中 ' + uploadProgress + '%' : '正在提交…') : (photos.length ? '上传并整理' : (hasText ? '提交整理' : '添加照片或文字后继续'))}}</text>
    </view>
  </view>
  <text class="help center">提交后会先生成待确认的草稿，确认后才进入学习档案。</text>
</view>
