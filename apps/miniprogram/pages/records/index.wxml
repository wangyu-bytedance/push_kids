<view class="page record-page">
  <view class="compact-head"><text class="eyebrow">记录已学内容</text><picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view></picker></view>
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 点此重试</view>
  <view class="empty plain" wx:if="{{!loading && !children.length}}">尚未由后台配置学习档案</view>
  <block wx:if="{{children.length}}">
    <view class="segmented two"><button class="{{mode === 'photo' ? 'active' : ''}}" data-mode="photo" bindtap="changeMode">拍照记录</button><button class="{{mode === 'text' ? 'active' : ''}}" data-mode="text" bindtap="changeMode">文字记录</button></view>
    <view class="time-summary"><view><text class="muted small">实际发生时间</text><text>{{date}} · {{time}}</text></view><view class="time-pickers"><picker mode="date" value="{{date}}" data-field="date" bindchange="setField"><text>日期</text></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="setField"><text>时间</text></picker></view></view>
    <view wx:if="{{mode === 'photo'}}"><view class="row between field-label"><text>学习照片</text><text class="muted small">{{photos.length}} / 9</text></view><view class="upload-actions" wx:if="{{!photos.length}}"><button bindtap="chooseCamera"><text class="upload-plus">＋</text><text>拍摄一张</text></button><button bindtap="chooseAlbum"><text class="upload-plus">▧</text><text>从相册选择</text></button></view><view class="photo-grid" wx:else><view class="photo-wrap" wx:for="{{photos}}" wx:key="*this"><image class="photo" src="{{item}}" mode="aspectFill"></image><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto">×</button></view><button class="photo-add" bindtap="chooseAlbum">＋</button></view></view>
    <view class="field"><text class="label">{{mode === 'photo' ? '补充内容' : '学习内容'}}</text><textarea class="textarea compact-textarea" value="{{text}}" data-field="text" bindinput="setField" maxlength="4000" placeholder="{{mode === 'photo' ? '选填，补充照片里不容易看出的内容' : '写下今天实际学过的内容'}}"></textarea></view>
    <button class="button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? (mode === 'photo' ? '上传中 ' + uploadProgress + '%' : '提交中') : '提交'}}</button>
    <view class="pending" wx:if="{{submissions.length}}"><text class="pending-title">等待处理</text><view class="pending-row" wx:for="{{submissions}}" wx:key="id" data-id="{{item.id}}" bindtap="openSubmission"><view class="grow"><text>{{item.source === 'photo' ? item.media_count + ' 张照片' : '文字记录'}}</text><text class="muted small">{{item.state_label}}</text></view><button wx:if="{{item.can_finalize_upload}}" class="small-action" data-id="{{item.id}}" catchtap="finalizePending">继续分析</button><button wx:if="{{item.can_finalize_upload}}" class="small-action muted-action" data-id="{{item.id}}" catchtap="cancelSubmission">取消</button><button wx:elif="{{item.state === 'failed'}}" class="small-action" data-id="{{item.id}}" catchtap="retry">重试</button><text wx:elif="{{item.state === 'pending_confirmation'}}">确认 ›</text></view></view>
  </block>
</view>
