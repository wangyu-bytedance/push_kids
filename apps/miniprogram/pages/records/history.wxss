/* 报表历史折叠区与列表；记录页只保留新增表单。 */
.history-section { margin-top: var(--pk-s4); }
.history-toggle { min-height: var(--pk-touch-min); }
.history-toggle .flex { width: 100%; min-height: var(--pk-touch-min); gap: var(--pk-s2); }
.history-section.expanded .history-toggle { margin-bottom: var(--pk-s3); }

/* ── 历史记录列表（D4 / D5） ───────────────────────────── */
.h-search { display: flex; align-items: center; gap: var(--pk-s2); }
.h-search .s-box { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; height: var(--pk-btn-md); padding: 0 var(--pk-s3); border: var(--pk-border); border-radius: var(--pk-r-pill); background: var(--pk-surface); box-sizing: border-box; }
.h-search .s-input { flex: 1; min-width: 0; height: var(--pk-btn-md); font-size: 14px; color: var(--pk-ink); }
.h-search .s-filter { position: relative; flex: none; gap: 8rpx; padding: 0 var(--pk-s3); }
.h-search .s-filter .dot { position: absolute; top: 10rpx; right: 10rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--pk-attention); }

.h-cap { margin-top: var(--pk-s3); min-height: 56rpx; }
.h-day { display: block; margin: var(--pk-s4) 0 var(--pk-s2); padding-left: 4rpx; font-size: 13px; font-weight: 600; color: var(--pk-ink-3); }

.h-card { margin-top: var(--pk-s3); }
.h-card.att { border-color: var(--pk-attention-line); background: rgba(248, 239, 220, .35); }
.h-card.dan { border-color: var(--pk-danger-line); background: rgba(247, 232, 226, .32); }
.h-card .h-title { display: block; font-size: 16px; font-weight: 600; line-height: 1.4; color: var(--pk-ink); overflow-wrap: anywhere; }
.h-card .h-sum { display: block; margin-top: 6rpx; font-size: 14px; line-height: 1.5; color: var(--pk-ink-2); overflow-wrap: anywhere; }
.h-card .h-meta { display: block; margin-top: 8rpx; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); overflow-wrap: anywhere; }
.h-card .h-note { display: block; margin-top: 8rpx; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); overflow-wrap: anywhere; }
.h-card .h-pills { gap: var(--pk-s1); margin-top: var(--pk-s3); }
.h-card .h-cta { margin-top: var(--pk-s3); }
.h-card .prog-line .pf.w45 { width: 45%; }

.h-pager { margin-top: var(--pk-s5); }

/* ── 筛选半屏（D6） ────────────────────────────────────── */
.filter-sheet .date-row { display: flex; align-items: center; gap: var(--pk-s2); }
.filter-sheet .date-row .pk-picker { min-width: 0; }
.filter-sheet .date-row > picker { flex: 1; min-width: 0; }
.filter-sheet .date-row > .t-cap { flex: none; }
