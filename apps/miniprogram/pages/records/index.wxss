.record-page{padding-bottom:120rpx}.compact-head{min-height:112rpx;margin-bottom:18rpx}.compact-head .screen-intro{margin:0}.segmented.two{grid-template-columns:repeat(2,minmax(0,1fr))}.time-summary{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);margin-bottom:28rpx}.time-summary text{display:block}.time-pickers{display:flex;gap:20rpx;color:var(--primary);font-size:24rpx}.mode-tabs{display:flex;gap:36rpx;margin:0 0 26rpx;border-bottom:1rpx solid var(--line)}.mode-tabs button{display:flex;align-items:center;min-height:76rpx;margin:0;padding:0;border:0;border-bottom:4rpx solid transparent;background:transparent;color:var(--muted);font-size:27rpx}.mode-tabs button::after{border:0}.mode-tabs button.active{border-color:var(--primary);color:var(--primary);font-weight:650}.field-label{margin-bottom:14rpx;font-weight:700}.upload-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-bottom:28rpx}.upload-actions button{display:flex;align-items:stretch;justify-content:stretch;width:100%;min-width:0;height:196rpx;min-height:196rpx;margin:0;padding:0;border:1rpx dashed #9ebca7;border-radius:24rpx;background:#f2f6ed;color:var(--primary-dark);font-size:26rpx;line-height:1.2;box-sizing:border-box}.upload-actions button::after{border:0}.upload-content{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;width:100%;min-width:0;height:100%;box-sizing:border-box}.upload-label{display:block;line-height:1.2}.upload-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;font-size:48rpx;line-height:1}.album-icon{display:block;width:42rpx;height:34rpx;border:3rpx solid var(--primary);box-sizing:border-box}.photo-wrap{position:relative}.photo-remove{display:flex;align-items:center;justify-content:center;position:absolute;right:8rpx;top:8rpx;width:48rpx;min-width:48rpx;height:48rpx;min-height:48rpx;margin:0;padding:0;border:0;border-radius:50%;background:rgba(24,36,32,.72);color:#fff;font-size:30rpx;line-height:1;box-sizing:border-box}.photo-remove::after,.photo-add::after{border:0}.photo-add{width:100%;min-width:0;height:190rpx;min-height:190rpx;margin:0;padding:0;border:1rpx dashed #92B8AB;background:#F2F8F5;color:var(--primary);font-size:48rpx;box-sizing:border-box}.compact-textarea{min-height:160rpx}.form-helper{display:block;margin:-8rpx 0 24rpx;color:var(--muted);font-size:22rpx;line-height:1.7}.submit-button{width:100%;margin-top:10rpx}.pending{margin-top:40rpx;border-top:1rpx solid var(--line)}.pending-title{display:block;padding:24rpx 0 10rpx;font-weight:700}.pending-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.pending-row text{display:block}.plain{padding:120rpx 0;color:var(--muted)}
.history-switch{margin-bottom:24rpx}.history-notice{display:block;width:100%;min-height:44px;text-align:left;white-space:normal;line-height:1.6;font-size:14px;box-sizing:border-box}
.history-search{display:flex;align-items:center;gap:8rpx}.history-search .input{flex:1;min-width:0}.history-search button,.history-caption button,.history-clear{flex:none;margin:0;padding:0 8px;min-height:44px;line-height:44px;font-size:14px;color:var(--primary);background:transparent}
.history-status{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;margin:16rpx 0}.history-status button{width:100%;min-width:0;margin:0;padding:8px 4px;min-height:44px;line-height:1.4;font-size:14px;background:transparent;color:var(--muted);white-space:normal;box-sizing:border-box}.history-status .selected{color:var(--primary-dark);background:#E8F1EB;font-weight:700}
.history-caption{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:14px;min-height:44px}.history-day{display:block;padding:22rpx 0 8rpx;font-size:14px;font-weight:700}.history-row{display:block;width:100%;min-width:0;margin:0;padding:20rpx 0;border-bottom:1rpx solid var(--line);background:transparent;text-align:left;line-height:1.6;white-space:normal;box-sizing:border-box;border-radius:0}.history-row::after{border:0}.history-title{font-weight:700;font-size:16px;overflow-wrap:anywhere}.history-summary{display:block;font-size:15px;overflow-wrap:anywhere;margin:8rpx 0}.history-meta{display:block;font-size:14px;overflow-wrap:anywhere}.history-pagination{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:24rpx}.history-pagination button{width:100%;min-height:44px;font-size:14px;box-sizing:border-box}
.history-mask{position:fixed;inset:0;background:rgba(24,36,32,.4);z-index:30;display:flex;align-items:flex-end}.history-sheet{width:100%;max-height:85vh;overflow-y:auto;padding:20px 20px calc(20px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:24px 24px 0 0;background:var(--surface,#FFFEFA)}.history-sheet .label{margin-top:14px}.history-sheet button{min-height:44px;font-size:14px}.history-sheet .picker{min-height:44px;box-sizing:border-box}.history-sheet .button{margin-top:20px;width:100%}
