/* 记录（D1~D6）：只写本页特有几何，其余全部复用 tokens / atoms / icons。 */
.record-page { padding-bottom: var(--pk-s6); }
.record-page.sticky-cta { padding-bottom: calc(376rpx + env(safe-area-inset-bottom)); }

/* 记录页是原生 Tab 页：固定主操作需同时避开 TabBar 和中央凸起按钮。 */
.record-cta {
  bottom: calc(var(--pk-tabbar-h) + var(--pk-s4) + env(safe-area-inset-bottom));
  padding-bottom: var(--pk-s3);
}

.pg-head .child-chip .chip-nm { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.child-chip.single { padding-right: 28rpx; }

/* 两行文案的提示条（错误态需要标题 + 说明） */
.pk-notice .n-txt .n-t { display: block; font-size: 14px; font-weight: 600; line-height: 1.45; }
.pk-notice .n-txt .n-c { display: block; margin-top: 4rpx; font-size: 13px; font-weight: 400; line-height: 1.5; opacity: .82; }

/* 实际学习时间卡 */
.time-card .time-val { display: block; margin-top: 4rpx; font-size: 15px; font-weight: 600; color: var(--pk-ink); }
.time-card .btn.sm { flex: none; }

/* 字段标题行 */
.field-head { margin: var(--pk-s4) 0 var(--pk-s2); }
.add-photo-tile { width: 100%; }

/* 文字记录输入区 */
.voice-input-shell { position: relative; min-height: 184rpx; }
.text-input { height: 184rpx; min-height: 184rpx; padding: 22rpx 112rpx 58rpx 24rpx; }
.text-counter { position: absolute; left: 24rpx; bottom: 18rpx; z-index: 2; }
.voice-touch { position: absolute; right: 8rpx; bottom: 4rpx; z-index: 4; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.voice-touch.is-disabled { opacity: .48; }
.voice-face { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--pk-primary-tint); border: var(--pk-border-primary); }
.voice-status { position: absolute; top: 1rpx; right: 1rpx; bottom: 1rpx; left: 1rpx; z-index: 3; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 24rpx 104rpx 24rpx 24rpx; border-radius: var(--pk-r-md); background: rgba(228, 237, 230, .96); color: var(--pk-primary-strong); font-size: 15px; font-weight: 500; pointer-events: none; }
.state-cancel_armed .voice-status { background: rgba(247, 232, 226, .97); color: var(--pk-danger); }
.state-recognizing .voice-status, .state-requesting_permission .voice-status { background: rgba(253, 251, 245, .97); color: var(--pk-ink-2); }
.voice-overflow { margin-top: var(--pk-s2); padding: var(--pk-s3); border: 1rpx solid var(--pk-attention-line); border-radius: var(--pk-r-md); background: var(--pk-attention-bg); }
.overflow-help { display: block; margin-top: 4rpx; }
.overflow-input { height: 180rpx; min-height: 180rpx; margin-top: var(--pk-s2); background: var(--pk-surface); }
.help.center { display: block; margin-top: var(--pk-s2); text-align: center; }
.submit-row { display: block; }
.submit-row > .btn { width: 100%; }
