.record-page{padding-bottom:120rpx}.compact-head{min-height:82rpx;margin-bottom:22rpx}.segmented.two{grid-template-columns:1fr 1fr}.time-summary{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);margin-bottom:28rpx}.time-summary text{display:block}.time-pickers{display:flex;gap:20rpx;color:var(--primary);font-size:24rpx}.field-label{margin-bottom:14rpx;font-weight:700}.upload-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:28rpx}.upload-actions button{min-height:172rpx;border:1rpx dashed #92B8AB;background:#F2F8F5;color:var(--primary-dark);font-size:26rpx}.upload-actions button::after{border:0}.upload-actions text{display:block}.upload-plus{font-size:46rpx}.photo-wrap{position:relative}.photo-remove{position:absolute;right:8rpx;top:8rpx;width:48rpx;height:48rpx;line-height:44rpx;padding:0;border:0;border-radius:50%;background:rgba(24,36,32,.72);color:#fff;font-size:30rpx}.photo-remove::after,.photo-add::after{border:0}.photo-add{height:190rpx;padding:0;border:1rpx dashed #92B8AB;background:#F2F8F5;color:var(--primary);font-size:48rpx}.compact-textarea{min-height:150rpx}.submit-button{margin-top:10rpx}.pending{margin-top:40rpx;border-top:1rpx solid var(--line)}.pending-title{display:block;padding:24rpx 0 10rpx;font-weight:700}.pending-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.pending-row text{display:block}.plain{padding:120rpx 0;color:var(--muted)}
