@import "../records/history.wxss";

/* 报表页（F1/F2/F3/F4）：图表全部用 WXSS 色块与柱条实现，不引入 canvas 或图表库。
   这里只补本页几何，颜色与字号一律走 tokens.wxss / atoms.wxss。 */

.report-page { padding-top: 0; }
.report-intro { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; padding: 32rpx 28rpx; }
.report-intro .head-intro { position: relative; z-index: 1; }
.report-intro .pg-title { display: block; overflow-wrap: anywhere; }
.report-intro .child-chip { margin-top: 20rpx; max-width: 100%; min-height: 44px; box-sizing: border-box; }
.report-intro .child-chip .chip-nm { min-width: 0; max-width: 160rpx; }
.report-intro-art { flex: none; width: 220rpx; height: 240rpx; pointer-events: none; }
.report-page .pk-card, .report-page .metric {
  background: radial-gradient(120% 130% at 100% 0%, rgba(127, 166, 92, .12), rgba(127, 166, 92, 0) 58%), linear-gradient(158deg, #FFFEFA 0%, #F7F4EA 100%);
}
.report-page .head-intro { flex: 1; min-width: 0; }
.report-page .child-chip .chip-nm { max-width: 190rpx; }
.report-page .child-chip.single { padding-right: 28rpx; }

/* 区间切换吸顶，滚动到图表深处也能随手换区间 */
.range-seg {
  position: sticky;
  top: 0;
  z-index: 12;
  margin-top: 8rpx;
  padding: 12rpx 0 16rpx;
  background: var(--pk-canvas);
}
.range-seg .seg.n3 { grid-template-columns:repeat(3,minmax(0,1fr)); }

.metrics .mv.zero { color: var(--pk-ink-4); }
.metrics .mv.tight { font-size: 20px; }
.metric-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-width: 0; }
.metric-trend { position: relative; flex: 0 0 128rpx; width: 128rpx; height: 52rpx; }
.trend-floor { position: absolute; left: 0; right: 0; top: 46rpx; height: 2rpx; background: var(--pk-line); }
.trend-tick { position: absolute; top: 46rpx; width: 1rpx; height: 6rpx; background: var(--pk-line); }
.trend-segment { position: absolute; height: 2rpx; border-radius: 2rpx; background: var(--pk-primary); transform-origin: 0 50%; }
.trend-dot { position: absolute; box-sizing: border-box; width: 6rpx; height: 6rpx; border: 2rpx solid var(--pk-primary); border-radius: 50%; background: var(--pk-surface); }
.trend-dot.last { width: 10rpx; height: 10rpx; margin: -2rpx 0 0 -2rpx; background: var(--pk-primary); }
.trend-missing { flex: 0 0 128rpx; font-size: 10px; line-height: 52rpx; text-align: center; color: var(--pk-ink-4); }

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 64rpx;
  padding: 0 4rpx;
}
.sec-head .s-t {
  flex: 1;
  min-width: 0;
  font-family: var(--pk-serif);
  font-size: 17px;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: .4px;
  color: var(--pk-ink);
}
.sec-head .s-r {
  flex: none;
  font-size: 12px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

.chart-card { padding: 24rpx 20rpx; box-shadow: var(--pk-e1); }
.chart-card .pager { margin-bottom: 8rpx; }
/* 翻屏按钮放大到触控下限，视觉圆点仍按设计保持小尺寸 */
.chart-card .pager .pbtn {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
}

.day-swiper { width: 100%; height: 470rpx; }
.day-swiper.short { height: 120rpx; }

/* 30 天一屏：6 列 × 5 行 */
.thirty-grid {
  display: grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  grid-template-rows:repeat(5,86rpx);
  gap: 8rpx;
  align-content: start;
  box-sizing: border-box;
  width: 100%;
  padding: 4rpx 4rpx 0;
}
.thirty-grid.week-grid {
  grid-template-columns: repeat(7, minmax(0, 1fr));
  grid-template-rows: 108rpx;
}

.ucell,
.hcell {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
}
.thirty-grid .udot { width: 52rpx; height: 52rpx; font-size: 12px; }
.thirty-grid.week-grid .udot { width: 72rpx; height: 72rpx; font-size: 14px; }
.thirty-grid .hbox { width: 52rpx; max-width: 52rpx; height: 52rpx; border-radius: 10rpx; }
.thirty-grid.week-grid .hbox { width: 100%; max-width: 72rpx; height: 72rpx; border-radius: 12rpx; }
.ucell .cell-label,
.hcell .cell-label { line-height: 1.2; }

.chart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: var(--pk-border-soft);
}
.chart-foot .legend { margin: 0; }
.chart-foot .legend .hbox.sw { max-width: 24rpx; }
.chart-foot .total {
  flex: none;
  font-size: 12px;
  color: var(--pk-ink-3);
}

.list-card { padding: 8rpx 24rpx; }
.list-card .bar-row + .bar-row { border-top: var(--pk-border-soft); }
.list-card .bar-row .bn { flex: 0 0 152rpx; max-width: 152rpx; }
.list-card .bar-row .chev { flex: none; margin-left: 4rpx; }

.quiet-card {
  padding: 32rpx 28rpx;
  background: var(--pk-surface-warm);
  border-style: dashed;
}
.quiet-card .q-t {
  display: block;
  font-size: 14px;
  line-height: 1.55;
  color: var(--pk-ink-2);
}
.quiet-card .q-s {
  display: block;
  margin-top: 6rpx;
  font-size: 12px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

/* 活动行与孩子行共用的圆形标记 */
.act-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--pk-primary-tint);
}
.act-mark .am-txt {
  font-family: var(--pk-serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-primary-strong);
}

/* 与真实 2×2 指标卡等高：168rpx × 2 行 + 16rpx 间距 */
.sk.metrics-sk { height: 352rpx; }
.sk.chart-sk { height: 420rpx; }
.report-page .report-disclosure { margin-top: var(--pk-s4); padding: 0 var(--pk-s4); }
/* 外层背景、阴影和装饰归 pk-card 所有；此处仅定义展开区内部几何。 */
.report-disclosure .history-toggle { padding: var(--pk-s4) 0; }
.report-disclosure.expanded .history-toggle { margin-bottom: 0; }
.report-disclosure .history-toggle .ico { flex: none; }
.disclosure-heading { min-width: 0; }
.disclosure-title { display: block; font-family: var(--pk-serif); font-size: 17px; font-weight: 600; line-height: 1.45; }
.disclosure-sub { display: block; margin-top: var(--pk-s1); font-size: 12px; line-height: 1.5; color: var(--pk-ink-3); overflow-wrap: anywhere; }
.disclosure-action { flex: none; font-size: 12px; color: var(--pk-primary); }
.disclosure-body { border-top: var(--pk-border-line); }
.disclosure-footer { display: flex; align-items: center; justify-content: center; gap: var(--pk-s2); min-height: 44px; padding: var(--pk-s2) 0; font-size: 12px; color: var(--pk-primary); }
.report-disclosure .h-search .s-box { border-radius: var(--pk-r-sm); }
.report-disclosure .h-search .s-filter { min-height: 44px; padding: 0 var(--pk-s2); }
.report-disclosure .chips { display: flex; gap: var(--pk-s1); padding: var(--pk-s1); border-radius: var(--pk-r-sm); background: var(--pk-surface-sunken); }
.report-disclosure .chips > view { flex: 1; min-width: 0; min-height: 44px; justify-content: center; padding: 0 var(--pk-s1); font-size: 13px; border: 0; border-radius: var(--pk-r-xs); background: none; }
.report-disclosure .chips > view.on { background: var(--pk-surface); color: var(--pk-primary); box-shadow: none; }
.report-disclosure .h-cap { gap: var(--pk-s2); }
.report-disclosure .h-cap > text { flex: 1; min-width: 0; }
.report-disclosure .h-cap .link-btn { flex: none; min-height: 44px; }
.report-disclosure .h-record-row { margin-top: 0; padding: var(--pk-s3) 0; border-bottom: var(--pk-border-line); }
.report-disclosure .h-record-row .grow { min-width: 0; }
.report-disclosure .h-record-row .h-title { font-size: 14px; font-weight: 500; line-height: 1.55; }
.report-disclosure .h-record-row .h-sum { font-size: 13px; }
.report-disclosure .h-record-meta { margin-top: var(--pk-s2); gap: var(--pk-s1); }
.h-meta-chip { display: flex; align-items: center; gap: var(--pk-s1); font-size: 12px; color: var(--pk-ink-3); line-height: 1.55; }
.h-meta-chip + .h-meta-chip::before { content: '·'; }
.report-disclosure .safe-tail { display: none; }
.report-disclosure review-inventory { display: block; width: 100%; }
