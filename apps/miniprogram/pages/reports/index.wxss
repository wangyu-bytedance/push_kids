/* 报表页（F1/F2/F3/F4）：图表全部用 WXSS 色块与柱条实现，不引入 canvas 或图表库。
   这里只补本页几何，颜色与字号一律走 tokens.wxss / atoms.wxss。 */

.report-page { padding-top: 0; }
.report-page .head-intro { flex: 1; min-width: 0; }
.report-page .child-chip .chip-nm { max-width: 190rpx; }
.report-page .child-chip.single { padding-right: 28rpx; }

/* 区间切换吸顶，滚动到图表深处也能随手换区间 */
.range-seg {
  position: sticky;
  top: 0;
  z-index: 12;
  margin-top: 8rpx;
  padding: 12rpx 0 16rpx;
  background: var(--pk-canvas);
}
.range-seg .seg.n3 { grid-template-columns:repeat(3,minmax(0,1fr)); }

.metrics .mv.zero { color: var(--pk-ink-4); }
.metrics .mv.tight { font-size: 20px; }

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 64rpx;
  padding: 0 4rpx;
}
.sec-head .s-t {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  line-height: 1.45;
  font-weight: 600;
  color: var(--pk-ink);
}
.sec-head .s-r {
  flex: none;
  font-size: 13px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}
.read-hint {
  display: block;
  margin: 0 4rpx 16rpx;
  font-size: 13px;
  line-height: 1.55;
  color: var(--pk-ink-3);
}

.chart-card { padding: 24rpx 20rpx; }
.chart-card .pager { margin-bottom: 8rpx; }
/* 翻屏按钮放大到触控下限，视觉圆点仍按设计保持小尺寸 */
.chart-card .pager .pbtn {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
}
.chev.left { transform: rotate(135deg); }

.day-swiper { width: 100%; height: 470rpx; }
.day-swiper.short { height: 120rpx; }

/* 30 天一屏：6 列 × 5 行 */
.thirty-grid {
  display: grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  grid-template-rows:repeat(5,86rpx);
  gap: 8rpx;
  align-content: start;
  box-sizing: border-box;
  width: 100%;
  padding: 4rpx 4rpx 0;
}
.thirty-grid.week-grid {
  grid-template-columns: repeat(7, minmax(0, 1fr));
  grid-template-rows: 108rpx;
}

.ucell,
.hcell {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
}
.thirty-grid .udot { width: 52rpx; height: 52rpx; font-size: 12px; }
.thirty-grid.week-grid .udot { width: 72rpx; height: 72rpx; font-size: 14px; }
.thirty-grid .hbox { width: 52rpx; max-width: 52rpx; height: 52rpx; border-radius: 10rpx; }
.thirty-grid.week-grid .hbox { width: 100%; max-width: 72rpx; height: 72rpx; border-radius: 12rpx; }
.ucell .cell-label,
.hcell .cell-label { line-height: 1.2; }

.chart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: var(--pk-border-soft);
}
.chart-foot .legend { margin: 0; }
.chart-foot .legend .hbox.sw { max-width: 24rpx; }
.chart-foot .total {
  flex: none;
  font-size: 12px;
  color: var(--pk-ink-3);
}

.list-card { padding: 8rpx 24rpx; }
.list-card .bar-row + .bar-row { border-top: var(--pk-border-soft); }
.list-card .bar-row .bn { flex: 0 0 152rpx; max-width: 152rpx; }
.list-card .bar-row .chev { flex: none; margin-left: 4rpx; }

.quiet-card {
  padding: 32rpx 28rpx;
  background: var(--pk-surface-warm);
  border-style: dashed;
}
.quiet-card .q-t {
  display: block;
  font-size: 15px;
  line-height: 1.55;
  color: var(--pk-ink-2);
}
.quiet-card .q-s {
  display: block;
  margin-top: 6rpx;
  font-size: 13px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

/* 活动行与孩子行共用的圆形标记 */
.act-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--pk-primary-tint);
}
.act-mark .am-txt {
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-primary-strong);
}

/* 与真实 2×2 指标卡等高：152rpx × 2 行 + 16rpx 间距 */
.sk.metrics-sk { height: 320rpx; }
.sk.chart-sk { height: 420rpx; }
