.report-page{padding-bottom:100rpx}.compact-head{min-height:82rpx}.range-tabs{display:grid;grid-template-columns:repeat(3,1fr);padding:7rpx;margin:12rpx 0 30rpx;background:#e9eae6;border-radius:18rpx}.range-tabs button{min-height:76rpx;padding:0;border:0;background:transparent;color:var(--muted);font-size:25rpx}.range-tabs button::after{border:0}.range-tabs button.active{background:#fff;color:var(--ink);font-weight:700;border-radius:14rpx;box-shadow:0 4rpx 12rpx rgba(30,45,39,.08)}.overview{display:grid;grid-template-columns:repeat(4,1fr);padding:26rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.overview view{text-align:center;border-right:1rpx solid var(--line)}.overview view:last-child{border-right:0}.overview text{display:block;font-size:20rpx;color:var(--muted)}.overview .metric-value{font-size:40rpx;color:var(--ink);font-family:serif}.report-section{padding:32rpx 0;border-bottom:1rpx solid var(--line)}.report-title{font-size:32rpx;font-weight:730}.chart-scroll{width:100%;margin-top:22rpx}.chart-pages{display:flex;gap:20rpx}.chart-page{width:calc(100vw - 56rpx);min-width:calc(100vw - 56rpx);padding:18rpx;box-sizing:border-box;background:#f3f4f1;border-radius:16rpx}.chart-label{display:block;margin-bottom:16rpx;color:var(--muted);font-size:22rpx}.urgency-grid,.activity-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10rpx}.urgency-cell{text-align:center;font-size:20rpx;color:var(--muted)}.urgency-dot{width:44rpx;height:44rpx;line-height:44rpx;margin:0 auto 6rpx;border-radius:50%;background:#e4eae7;color:#7b302a;font-weight:700}.urgency-dot.level-1{background:#f2d2ce}.urgency-dot.level-2{background:#e58f85;color:#fff}.urgency-dot.level-3{background:#b94b43;color:#fff}.urgency-dot.passed{background:#3f826d;color:#fff}.activity-cell,.legend view{display:block;min-width:32rpx;height:32rpx;border-radius:6rpx;background:#e4eae7}.activity-1{background:#cfe3db!important}.activity-2{background:#9cc8b8!important}.activity-3{background:#5b9b84!important}.activity-4{background:#216b58!important}.legend{display:flex;justify-content:flex-end;align-items:center;gap:8rpx;margin-top:14rpx;color:var(--muted);font-size:20rpx}.legend view{width:24rpx;min-width:24rpx;height:24rpx}.sr-value{font-size:0}.subject-bar{margin-top:22rpx}.subject-bar .bar-track{margin-top:8rpx}.plain,.empty.inline{padding:80rpx 0;color:var(--muted)}
