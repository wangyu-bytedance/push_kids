.page.report-page{padding-bottom:150rpx;overflow:visible}.compact-head{min-height:99rpx;margin-bottom:42rpx}.compact-head .screen-intro{margin:0}.range-tabs{position:sticky;top:0;z-index:10;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:8rpx;margin:0 0 38rpx;background:#e9ece5;border-radius:23rpx}.range-tabs button{display:flex;align-items:center;justify-content:center;width:100%!important;min-width:0!important;max-width:100%!important;min-height:79rpx;margin:0;padding:0;border:0;background:transparent;color:var(--muted);font-size:25rpx;line-height:1.2;box-sizing:border-box}.range-tabs button::after{border:0}.range-tabs button.active{background:#fff;color:var(--primary-dark);font-weight:600;border-radius:17rpx;box-sizing:border-box;box-shadow:0 4rpx 12rpx rgba(30,45,39,.06)}
.overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;border:1rpx solid var(--line);border-radius:31rpx;background:var(--surface)}.overview view{display:flex;align-items:center;gap:23rpx;padding:33rpx 35rpx;text-align:left;border-right:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.overview view:nth-child(2n){border-right:0}.overview view:nth-child(n+3){border-bottom:0}.overview text{display:block;font-size:23rpx;line-height:1.7;color:var(--muted)}.overview .metric-value{font-size:58rpx;color:var(--ink);font-family:Georgia,"Songti SC",serif;font-weight:500}.report-lead{display:block;margin:38rpx 0 0;color:var(--muted);font-size:23rpx;line-height:1.8}
.report-section{padding:46rpx 0;border-bottom:1rpx solid var(--line)}.report-title{font-size:35rpx;font-weight:650}.report-copy{display:block;margin-top:8rpx;line-height:1.8}.report-swiper-shell{width:100%;margin-top:27rpx;padding:33rpx 25rpx;overflow:hidden;border:1rpx solid var(--line);border-radius:35rpx;background:var(--surface);box-sizing:border-box}.swiper-head{display:grid;grid-template-columns:85rpx minmax(0,1fr) 85rpx;align-items:center;gap:8rpx;margin-bottom:13rpx}.pager-button{display:flex;align-items:center;justify-content:center;width:85rpx;min-width:85rpx;height:85rpx;min-height:85rpx;margin:0;padding:0;border:0;border-radius:50%;background:transparent;color:var(--primary);font-size:44rpx;line-height:1;box-sizing:border-box}.pager-button.disabled{color:#b4bab6}.pager-copy{text-align:center;min-width:0}.pager-copy text{display:block;font-size:23rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pager-copy .tiny{font-size:20rpx;font-weight:400}
.day-swiper{width:100%;height:462rpx}.day-swiper.short{height:100rpx}.thirty-grid,.activity-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));grid-template-rows:repeat(5,86rpx);gap:4rpx 6rpx;width:100%;height:100%;align-content:start}.thirty-grid.week-grid,.activity-grid.week-grid{grid-template-columns:repeat(7,minmax(0,1fr));grid-template-rows:86rpx}.urgency-cell,.activity-cell-wrap{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:19rpx;line-height:1.2;box-sizing:border-box}.urgency-dot{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;min-width:54rpx;min-height:54rpx;margin-bottom:5rpx;border-radius:50%;background:#e4eae7;color:#7b302a;font-size:20rpx;font-weight:700;line-height:1;box-sizing:border-box}.urgency-dot.level-1{background:#f2d2ce}.urgency-dot.level-2{background:#e58f85;color:#fff}.urgency-dot.level-3{background:#b94b43;color:#fff}.urgency-dot.passed{background:#3f826d;color:#fff}
.activity-cell{display:block;width:54rpx;height:54rpx;min-width:54rpx;min-height:54rpx;margin-bottom:5rpx;border-radius:12rpx;background:#e4eae7;box-sizing:border-box}.activity-1{background:#cfe3db!important}.activity-2{background:#9cc8b8!important}.activity-3{background:#5b9b84!important}.activity-4{background:#216b58!important}.page-indicator{display:flex;align-items:center;justify-content:center;gap:10rpx;min-height:42rpx}.indicator-dot{width:12rpx;height:12rpx;min-width:12rpx;min-height:12rpx;border-radius:50%;background:#ccd3cf;box-sizing:border-box}.indicator-dot.active{width:28rpx;border-radius:8rpx;background:var(--primary)}.page-indicator .tiny{margin-left:6rpx}.legend{display:flex;justify-content:flex-end;align-items:center;gap:8rpx;margin-top:14rpx;color:var(--muted);font-size:20rpx}.legend view{display:block;width:24rpx;min-width:24rpx;height:24rpx;border-radius:6rpx;background:#e4eae7}.sr-value{font-size:0}.subject-bar{margin-top:22rpx}.subject-bar .bar-track{margin-top:8rpx}.plain,.empty.inline{padding:80rpx 0;color:var(--muted)}
.history-link{min-height:44px;line-height:1.5;margin:0;padding:10px 8px;box-sizing:border-box;background:transparent;color:var(--primary);font-size:14px;white-space:normal;text-align:right}.history-link::after{border:0}
.pager-button{font-size:0}.pager-button .ui-chevron{width:17rpx;height:17rpx}
.metric-copy text{display:block}.single-chart-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13rpx;color:var(--muted);font-size:20rpx}.overview view{min-height:146rpx;box-sizing:border-box}
.overview .metric-copy{display:block;min-height:0;padding:0;border:0!important}.overview .metric-copy text{display:block}
