<view class="page report-page">
  <view class="pg-head">
    <view class="head-intro">
      <text class="pg-kicker">只统计已确认的学习</text>
      <text class="pg-title">一点一滴，看得见</text>
    </view>
    <view class="child-chip {{multiChild ? '' : 'single'}}" wx:if="{{children.length}}" aria-role="button" aria-label="切换孩子" bindtap="openChildSheet">
      <text class="ava">{{children[childIndex].avatar}}</text>
      <text class="chip-nm trunc">{{children[childIndex].name}}</text>
      <view class="chev" wx:if="{{multiChild}}"></view>
    </view>
  </view>

  <view class="pk-notice err" wx:if="{{error}}">
    <view class="ico ico-cloud-off-dan sm"></view>
    <text class="n-txt">{{error}}。已经读到的统计还能继续看。</text>
    <view class="ico ico-refresh-dan sm" aria-role="button" aria-label="重新加载报表" bindtap="load"></view>
  </view>

  <view class="range-seg" wx:if="{{children.length}}">
    <view class="seg n3">
      <view class="{{days === item ? 'on' : ''}}" wx:for="{{ranges}}" wx:key="*this" aria-role="button" aria-label="看近 {{item}} 天" data-days="{{item}}" bindtap="changeRange">近 {{item}} 天</view>
    </view>
  </view>

  <block wx:if="{{loading && !report}}">
    <view class="sk metrics-sk mt3"></view>
    <view class="sk chart-sk mt4"></view>
    <view class="sk chart-sk mt4"></view>
  </block>

  <view class="pk-empty" wx:elif="{{!children.length}}">
    <view class="em"><view class="ico ico-family-pri lg"></view></view>
    <text class="et">还没有学习档案</text>
    <text class="ec">在设置里建立学习档案后，这里会开始统计已确认的学习与复习。</text>
    <view class="ea">
      <view class="btn" aria-role="button" aria-label="前往设置" bindtap="openSettings"><text>前往设置</text></view>
    </view>
  </view>

  <block wx:elif="{{report}}">
    <view class="metrics mt3">
      <view class="metric {{item.actionable ? '' : 'quiet'}}" wx:for="{{metrics}}" wx:key="label" hover-class="is-press" hover-stay-time="80" aria-role="button" aria-label="{{item.ariaLabel}}" data-target="{{item.target}}" bindtap="openMetric">
        <text class="mv tnum {{item.zero ? 'zero' : ''}} {{item.tight ? 'tight' : ''}}">{{item.text}}</text>
        <view class="m-foot">
          <text class="ml">{{item.label}}</text>
          <view class="chev right" wx:if="{{item.actionable}}"></view>
        </view>
      </view>
    </view>

    <view class="pk-empty" wx:if="{{isEmpty}}">
      <view class="em"><view class="ico ico-list-pri lg"></view></view>
      <text class="et">还没有已确认的学习记录</text>
      <text class="ec">记录并确认之后，这里会逐渐留下学习与复习的足迹。</text>
      <view class="ea">
        <view class="btn secondary" aria-role="button" aria-label="去记录学习" bindtap="goRecord">
          <view class="ico ico-camera-pri sm"></view><text>去记录学习</text>
        </view>
      </view>
    </view>

    <block wx:else>
      <view class="sec">
        <view class="sec-head">
          <text class="s-t">哪些内容最需要先复习</text>
          <text class="s-r">{{rangeLabel}}</text>
        </view>
        <text class="read-hint" wx:if="{{urgencyPages.length > 1}}">左右滑动查看，每屏最多 30 天。页面本身不会横向移动。</text>
        <text class="read-hint" wx:else>数字表示当天待复习知识数，绿色勾表示当天已全部通过。</text>
        <view class="pk-card chart-card">
          <view class="pager" wx:if="{{urgencyPages.length > 1}}">
            <view class="pbtn {{urgencyPage === 0 ? 'off' : ''}}" aria-role="button" aria-label="上一屏" data-chart="urgency" data-offset="-1" bindtap="shiftReportPage"><view class="chev left"></view></view>
            <view class="plabel">第 {{urgencyPage + 1}} / {{urgencyPages.length}} 屏<text class="psub tnum">{{urgencyPageLabel}}</text></view>
            <view class="pbtn {{urgencyPage >= urgencyPages.length - 1 ? 'off' : ''}}" aria-role="button" aria-label="下一屏" data-chart="urgency" data-offset="1" bindtap="shiftReportPage"><view class="chev right"></view></view>
          </view>
          <swiper class="day-swiper {{days === 7 ? 'short' : ''}}" current="{{urgencyPage}}" duration="180" bindchange="onUrgencyPageChange">
            <swiper-item wx:for="{{urgencyPages}}" wx:key="id" wx:for-item="pageItem">
              <view class="thirty-grid {{days === 7 ? 'week-grid' : ''}}">
                <view class="ucell" wx:for="{{pageItem.items}}" wx:key="day" wx:for-item="dayItem" aria-label="{{dayItem.reading}}">
                  <view class="udot {{dayItem.dotClass}}">
                    <view class="ico ico-check-inv xs" wx:if="{{dayItem.passed}}"></view>
                    <text class="tnum" wx:else>{{dayItem.display}}</text>
                  </view>
                  <text class="cell-label tnum">{{dayItem.dayLabel}}</text>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <view class="pdots" wx:if="{{urgencyPages.length > 1}}">
            <view class="pd {{index === urgencyPage ? 'on' : ''}}" wx:for="{{urgencyPages}}" wx:key="id"></view>
          </view>
        </view>
      </view>

      <view class="sec" id="sec-feedback">
        <view class="sec-head">
          <text class="s-t">复习活跃度</text>
          <text class="s-r">{{rangeLabel}}</text>
        </view>
        <text class="read-hint">每格一天，颜色越深表示当天记录的复习反馈越多。</text>
        <view class="pk-card chart-card">
          <view class="pager" wx:if="{{activityPages.length > 1}}">
            <view class="pbtn {{activityPage === 0 ? 'off' : ''}}" aria-role="button" aria-label="上一屏" data-chart="activity" data-offset="-1" bindtap="shiftReportPage"><view class="chev left"></view></view>
            <view class="plabel">第 {{activityPage + 1}} / {{activityPages.length}} 屏<text class="psub tnum">{{activityPageLabel}}</text></view>
            <view class="pbtn {{activityPage >= activityPages.length - 1 ? 'off' : ''}}" aria-role="button" aria-label="下一屏" data-chart="activity" data-offset="1" bindtap="shiftReportPage"><view class="chev right"></view></view>
          </view>
          <swiper class="day-swiper {{days === 7 ? 'short' : ''}}" current="{{activityPage}}" duration="180" bindchange="onActivityPageChange">
            <swiper-item wx:for="{{activityPages}}" wx:key="id" wx:for-item="pageItem">
              <view class="thirty-grid {{days === 7 ? 'week-grid' : ''}}">
                <view class="hcell" wx:for="{{pageItem.items}}" wx:key="day" wx:for-item="dayItem" aria-label="{{dayItem.reading}}">
                  <view class="hbox {{dayItem.boxClass}}"></view>
                  <text class="cell-label tnum">{{dayItem.dayLabel}}</text>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <view class="chart-foot">
            <view class="legend">
              <text>少</text>
              <view class="hbox h0 sw"></view><view class="hbox h1 sw"></view><view class="hbox h2 sw"></view><view class="hbox h3 sw"></view><view class="hbox h4 sw"></view>
              <text>多</text>
            </view>
            <text class="total tnum">共 {{feedbackTotal}} 次反馈</text>
          </view>
        </view>
      </view>

      <view class="sec" id="sec-subjects">
        <view class="sec-head">
          <text class="s-t">科目学习记录</text>
          <text class="s-r">可下钻</text>
        </view>
        <view class="pk-card list-card" wx:if="{{subjects.length}}">
          <view class="bar-row" wx:for="{{subjects}}" wx:key="id" aria-role="button" aria-label="查看{{item.name}}的学习记录" data-id="{{item.id}}" bindtap="openSubjectHistory">
            <text class="bn trunc">{{item.name}}</text>
            <view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"></view></view>
            <text class="bv tnum">{{item.countText}}</text>
            <view class="chev right"></view>
          </view>
        </view>
        <view class="pk-card quiet-card" wx:else>
          <text class="q-t">这个区间还没有已确认的科目记录。</text>
        </view>
      </view>

      <view class="sec" id="sec-activities">
        <view class="sec-head">
          <text class="s-t">课外活动投入</text>
          <text class="s-r">{{rangeLabel}}</text>
        </view>
        <view class="rowlist" wx:if="{{activityRows.length}}">
          <view class="rowitem" wx:for="{{activityRows}}" wx:key="id">
            <view class="act-mark"><view class="ico {{item.iconClass}} sm"></view></view>
            <view class="grow">
              <text class="r-t trunc">{{item.name}}</text>
              <text class="r-s">{{item.meta}}</text>
            </view>
          </view>
        </view>
        <view class="pk-notice quiet" wx:elif="{{activityDetailFailed}}">
          <view class="ico ico-cloud-off-mute sm"></view>
          <text class="n-txt">活动明细这次没读到，下拉刷新可以再试一次。</text>
        </view>
        <view class="pk-card quiet-card" wx:else>
          <text class="q-t">这个区间还没有活动练习记录。</text>
          <text class="q-s">课外活动只做记录，不进入复习曲线。</text>
        </view>
      </view>
    </block>
  </block>

  <view class="safe-tail"></view>
</view>

<view class="pk-mask" wx:if="{{showChildSheet}}" bindtap="closeChildSheet"></view>
<view class="pk-sheet child-sheet" wx:if="{{showChildSheet}}">
  <view class="handle"></view>
  <view class="sheet-head">
    <view class="grow">
      <text class="sheet-title">选择孩子</text>
      <text class="sheet-sub">切换后所有页面同步</text>
    </view>
    <view class="icon-btn" aria-role="button" aria-label="关闭" bindtap="closeChildSheet"><view class="ico ico-close sm"></view></view>
  </view>
  <view class="sheet-body">
    <view class="rowlist">
      <view class="rowitem" wx:for="{{children}}" wx:key="id" aria-role="button" aria-label="选择{{item.name}}" data-index="{{index}}" bindtap="chooseChild">
        <view class="act-mark"><text class="am-txt">{{item.avatar}}</text></view>
        <view class="grow">
          <text class="r-t">{{item.label}}</text>
        </view>
        <view class="ico ico-check-pri sm" wx:if="{{index === childIndex}}"></view>
      </view>
    </view>
    <view class="add-entry" wx:if="{{canAddChild}}" aria-role="button" aria-label="添加孩子" bindtap="addChild">
      <view class="ico ico-plus-pri sm"></view><text>添加孩子</text>
    </view>
  </view>
</view>
