<view class="page report-page">
  <view class="compact-head">
    <text class="eyebrow">已确认的学习记录</text>
    <picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild">
      <view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view>
    </picker>
  </view>
  <view class="range-tabs"><button wx:for="{{ranges}}" wx:key="*this" class="{{days === item ? 'active' : ''}}" data-days="{{item}}" bindtap="changeRange">近 {{item}} 天</button></view>
  <block wx:if="{{loading}}"><view class="skeleton"></view><view class="skeleton"></view></block>
  <view class="notice error" wx:elif="{{error}}" bindtap="load">{{error}} · 点此重试</view>
  <view class="empty plain" wx:elif="{{!report}}">当前没有可展示的真实记录</view>
  <block wx:else>
    <view class="overview"><view><text class="metric-value">{{report.overview.learning_records}}</text><text>学习记录</text></view><view><text class="metric-value">{{report.overview.new_knowledge_items}}</text><text>新增知识点</text></view><view><text class="metric-value">{{report.overview.review_feedback_count}}</text><text>复习反馈</text></view><view><text class="metric-value">{{report.overview.activity_records}}</text><text>活动练习</text></view></view>
    <view class="report-section">
      <view class="row between"><text class="report-title">哪些内容最需要先复习</text><text class="muted small">近 {{days}} 天</text></view>
      <text class="muted small">数字为待复习知识数；红色越深越紧迫，绿色勾表示已通过。</text>
      <scroll-view class="chart-scroll" scroll-x enhanced show-scrollbar="false" scroll-into-view="urgency-{{lastChunkId}}"><view class="chart-pages"><view class="chart-page" wx:for="{{urgencyChunks}}" wx:key="id" id="urgency-{{item.id}}"><text class="chart-label">{{item.label}}</text><view class="urgency-grid"><view class="urgency-cell" wx:for="{{item.items}}" wx:key="day"><view class="urgency-dot level-{{item.level}} {{item.passed ? 'passed' : ''}}">{{item.display}}</view><text>{{item.dayLabel}}</text></view></view></view></view></scroll-view>
    </view>
    <view class="report-section">
      <view class="row between"><text class="report-title">复习活跃度</text><text class="muted small">近 {{days}} 天</text></view>
      <text class="muted small">每个方格代表一天，绿色越深表示当天记录的复习反馈越多。</text>
      <scroll-view class="chart-scroll" scroll-x enhanced show-scrollbar="false" scroll-into-view="activity-{{lastChunkId}}"><view class="chart-pages"><view class="chart-page" wx:for="{{activityChunks}}" wx:key="id" id="activity-{{item.id}}"><text class="chart-label">{{item.label}}</text><view class="activity-grid"><view class="activity-cell activity-{{item.level}}" wx:for="{{item.items}}" wx:key="day"><text class="sr-value">{{item.day}} {{item.count}} 次</text></view></view></view></view></scroll-view>
      <view class="legend"><text>少</text><view class="activity-0"></view><view class="activity-1"></view><view class="activity-2"></view><view class="activity-3"></view><view class="activity-4"></view><text>多</text></view>
    </view>
    <view class="report-section">
      <view class="row between"><text class="report-title">科目学习记录</text><text class="muted small">近 {{days}} 天</text></view>
      <view class="subject-bar" wx:for="{{report.subjects}}" wx:key="name"><view class="row between"><text>{{item.name}}</text><text class="muted small">{{item.occurrences}} 条</text></view><view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"></view></view></view>
      <view class="empty inline" wx:if="{{!report.subjects.length}}">这个范围内还没有学习记录</view>
    </view>
  </block>
</view>
