<view class="{{theme.classes}} theme-page" style="{{theme.style}}">
<view class="page child-edit-page">
  <view class="pk-notice err" wx:if="{{error}}">
    <theme-icon class="ico  sm" name="cloud-off" tone="danger" size="sm"></theme-icon>
    <text class="n-txt">{{error}}</text>
  </view>

  <view class="pk-notice quiet mt2" wx:if="{{mode === 'edit' && !active}}">
    <theme-icon class="ico  sm" name="eye" tone="muted" size="sm"></theme-icon>
    <text class="n-txt">这个档案已归档，不会出现在切换列表里，也不能再新增记录。已有的记录和报表仍可查看，归档前留下的待确认草稿和复习反馈也仍能完成。</text>
  </view>

  <view class="pk-notice quiet mt2" wx:if="{{mode === 'create' && limitReached}}">
    <theme-icon class="ico  sm" name="info" tone="primary" size="sm"></theme-icon>
    <text class="n-txt">{{limitHint}}</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="sk card-sk mt3"></view>
  </block>

  <block wx:else>
    <view class="pk-card form-card mt3">
      <view class="pk-field">
        <text class="lbl">名字</text>
        <input class="pk-input" value="{{nameDraft}}" bindinput="setName" maxlength="40" placeholder="孩子的名字或小名" placeholder-class="pk-ph" />
        <view class="help">切换孩子时按名字区分，同时在用的档案不能重名。</view>
      </view>
      <view class="pk-field">
        <text class="lbl">年级</text>
        <picker range="{{gradeChoices}}" range-key="label" value="{{gradeIndex}}" bindchange="chooseGrade">
          <view class="pk-picker"><text>{{gradeChoices[gradeIndex].label}}</text><view class="chev"></view></view>
        </picker>
      </view>
      <view class="pk-field">
        <text class="lbl">每天复习时长</text>
        <picker range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="chooseBudget">
          <view class="pk-picker"><text>{{budgetOptions[budgetIndex]}} 分钟</text><view class="chev"></view></view>
        </picker>
        <view class="help">用来安排每天的复习量，之后可以随时调整。</view>
      </view>
      <view class="pk-field" wx:if="{{mode === 'create'}}">
        <text class="lbl">已经在学的科目</text>
        <view class="subj-grid">
          <view class="subj {{item.selected ? 'on' : ''}}" wx:for="{{presetSubjects}}" wx:key="name" aria-role="button" aria-label="{{item.selected ? '取消' : '选择'}}{{item.name}}" data-index="{{index}}" bindtap="togglePreset">
            <text>{{item.name}}</text>
            <theme-icon class="ico  xs" wx:if="{{item.selected}}" name="check" tone="inverse" size="xs"></theme-icon>
          </view>
        </view>
        <view class="help">先选已经开始学的科目，其他科目和课外活动可以在设置里继续添加。</view>
      </view>
    </view>

    <view class="pk-card archive-card" wx:if="{{mode === 'edit' && isManager}}">
      <view class="archive-row" wx:if="{{active}}" aria-role="button" aria-label="{{working ? '正在归档' : '归档档案'}}" aria-disabled="{{working}}" bindtap="archive">
        <view class="archive-copy">
          <text class="archive-title">{{working ? '正在归档…' : '归档档案'}}</text>
          <text class="archive-description">保留全部记录，随时可恢复</text>
        </view>
        <view class="chev right" wx:if="{{!working}}" aria-hidden="true"></view>
      </view>
      <view class="archive-row" wx:else aria-role="button" aria-label="{{working ? '正在恢复' : '恢复档案'}}" aria-disabled="{{working}}" bindtap="restore">
        <view class="archive-copy">
          <text class="archive-title">{{working ? '正在恢复…' : '恢复档案'}}</text>
          <text class="archive-description">重新加入孩子列表，继续记录</text>
        </view>
        <view class="chev right" wx:if="{{!working}}" aria-hidden="true"></view>
      </view>
      <text class="archive-pending" wx:if="{{active && unfinishedHint}}">{{unfinishedHint}}</text>
    </view>

    <view class="form-foot">
      <view class="btn {{saving ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{mode === 'edit' ? '保存档案' : '建立档案'}}" aria-disabled="{{saving}}" bindtap="save">
        <text>{{saving ? '正在保存…' : (mode === 'edit' ? '保存' : '建立档案')}}</text>
      </view>
    </view>
  </block>

  <view class="safe-tail"></view>
</view>

</view>
