/* 学习档案表单（新建/编辑/归档恢复）：只补本页几何，颜色与字号走 tokens/atoms。 */

.child-edit-page { padding-top: 24rpx; }

.form-card { padding: 32rpx 28rpx; }

/* 初始科目：与设置页同一套三列几何，避免两处观感不一致 */
.form-card .subj-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.form-card .subj { display: flex; align-items: center; justify-content: center; gap: 10rpx; box-sizing: border-box; min-width: 0; height: 104rpx; border-radius: var(--pk-r-lg); background: var(--pk-surface-sunken); color: var(--pk-ink-2); font-size: 16px; line-height: 1.2; font-weight: 600; }
.form-card .subj.on { background: var(--pk-primary); color: var(--pk-on-primary); }

.archive-card { padding: 0; }
.archive-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 84px; padding: 16px 28rpx; box-sizing: border-box; border-radius: inherit; text-align: left; color: var(--pk-ink); }
.archive-copy { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.archive-title { font-size: 17px; line-height: 1.45; font-weight: 600; }
.archive-description { font-size: 14px; line-height: 1.5; color: var(--pk-ink-2); }
.archive-pending { display: block; padding: 0 28rpx 16px; text-align: left; font-size: 14px; line-height: 1.5; color: var(--pk-ink-2); }

.form-foot { margin-top: 32rpx; }
.form-foot .btn { width: 100%; min-width: 0; min-height: 44px; box-sizing: border-box; }

.sk.card-sk { height: 420rpx; }
