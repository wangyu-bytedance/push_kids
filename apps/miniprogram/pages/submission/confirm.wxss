.summary{min-height:160rpx}.section-title{margin:24rpx 0}.row>.button{margin:0}.point .field{margin-top:20rpx;margin-bottom:0}.remove{color:#a94f48;font-size:25rpx}
.point .notice{overflow-wrap:anywhere;word-break:break-word}.point .notice view{margin-top:8rpx}
.original-text { white-space:pre-wrap; overflow-wrap:anywhere; }
.detail-meta{font-size:14px;line-height:1.7;margin:4px 0;overflow-wrap:anywhere}.detail-section{margin:24px 0;border-top:1px solid var(--line);padding-top:16px}.detail-summary{display:block;font-size:16px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0}.detail-knowledge{font-size:15px;line-height:1.8;overflow-wrap:anywhere}.detail-toggle{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:44px;margin:0;padding:8px 0;font-size:16px;font-weight:700;background:transparent;box-sizing:border-box}.detail-toggle::after{border:0}.detail-toggle text{font-size:14px;color:var(--primary)}.detail-review{border-bottom:1px solid var(--line);padding:14px 0;overflow-wrap:anywhere}.detail-actions .button{margin-top:12px;width:100%;min-height:44px;font-size:14px;white-space:normal;box-sizing:border-box}
