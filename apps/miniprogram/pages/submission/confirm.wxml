<view class="page">
  <block wx:if="{{loading}}"><view class="skeleton"></view><view class="skeleton"></view></block>
  <view class="notice error" wx:elif="{{error}}">{{error}}<button class="button ghost" bindtap="load">重新读取</button></view>
  <block wx:else>
    <block wx:if="{{readOnly}}">
      <view class="row between"><text class="section-title">{{detail.record.subject_name || '上传记录'}}</text><text class="pill">{{statusLabel}}</text></view>
      <view class="muted detail-meta">学习于 {{submission.time_label}}</view><view class="muted detail-meta">提交于 {{submission.submitted_label}}</view>
      <view wx:if="{{detail.record}}" class="detail-section"><text class="section-title">这次学了什么</text><text class="detail-summary" selectable="{{true}}">{{detail.record.summary}}</text><view class="detail-knowledge" wx:for="{{detail.knowledge}}" wx:key="id">· {{item.name}}</view></view>
      <view wx:elif="{{submission.state === 'failed'}}" class="notice">AI 暂时不可用，可重试或人工录入</view>
      <view wx:elif="{{submission.state === 'cancelled'}}" class="notice">这条提交已取消，原图已删除或不可用。</view>
      <view wx:else class="notice">{{statusLabel}}，可稍后回来查看。<button class="button ghost" bindtap="load">刷新状态</button></view>
    </block>
    <submission-materials child-id="{{submission.child_id}}" submission-id="{{id}}" submission-state="{{submission.state}}" default-open="{{submission.state !== 'confirmed'}}" />
    <block wx:if="{{readOnly}}">
      <view wx:if="{{detail.record}}" class="detail-section"><button class="detail-toggle" bindtap="toggleReviews">复习情况 <text>{{reviewsOpen ? '收起' : '展开'}}</text></button>
        <block wx:if="{{reviewsOpen}}"><text class="muted detail-meta">以下是这些知识点截至现在的复习记录</text><view wx:if="{{reviewsLoading}}">正在读取…</view><view wx:if="{{reviewsError}}" class="notice error">{{reviewsError}}<button bindtap="loadReviews">重试</button></view>
          <view wx:for="{{reviews}}" wx:key="review_id" class="detail-review"><text>{{item.name}}</text><text class="muted detail-meta">{{!item.active ? '本轮计划已结束' : (item.is_due ? '已到复习时间' : '下次复习 ' + item.due_date)}}</text><view wx:for="{{item.feedback}}" wx:for-item="feedback" wx:key="id" class="detail-meta">{{feedback.time}} · {{feedback.label}}</view><text wx:if="{{!item.feedback.length}}" class="muted detail-meta">还没有复习反馈</text><button wx:if="{{item.next_before}}" class="button ghost" disabled="{{reviewsLoading}}" data-id="{{item.review_id}}" bindtap="loadReviews">查看更早反馈</button></view>
          <view wx:if="{{!reviewsLoading && !reviewsError && !reviews.length}}" class="muted detail-meta">{{detail.record.subject_kind === 'activity' ? '活动不参与复习计划' : '暂无关联复习计划'}}</view>
          <button wx:if="{{hasDue}}" class="button" bindtap="goReview">去今日复习</button>
        </block>
      </view>
      <view wx:if="{{canWrite && submission.state !== 'confirmed' && submission.state !== 'cancelled'}}" class="detail-actions">
        <button wx:if="{{submission.awaiting_upload && submission.media_count < 9}}" class="button" disabled="{{saving}}" loading="{{saving}}" bindtap="resumePhotos">补传照片</button>
        <button wx:if="{{submission.can_finalize_upload}}" class="button" data-action="finalize" disabled="{{saving}}" bindtap="runDraftAction">继续分析</button>
        <button wx:if="{{!submission.awaiting_upload}}" class="button" disabled="{{saving}}" bindtap="startManual">人工录入</button>
        <button wx:if="{{submission.state === 'failed'}}" class="button ghost" data-action="retry" disabled="{{saving}}" bindtap="runDraftAction">重试分析</button>
        <button class="button ghost" data-action="cancel" disabled="{{saving}}" bindtap="runDraftAction">取消提交</button>
      </view>
      <view wx:if="{{actionError}}" class="notice error">{{actionError}}</view>
    </block>
    <block wx:else>
    <view class="notice">{{manual ? '无需 AI 分析。请填写本次实际学过的内容，确认后保存。' : '这是 AI 整理草稿。请检查并修改，点击确认后才会进入学习档案和复习计划。'}}</view>
    <view class="notice" wx:if="{{manual && submission.input_text}}"><text>原始记录{{submission.input_text.length > 500 ? '（请在下方填写500字以内的总结）' : ''}}</text><view class="original-text">{{submission.input_text}}</view></view>
    <view class="notice" wx:if="{{proposal.uncertainties.length}}"><text>需要核对</text><view wx:for="{{proposal.uncertainties}}" wx:key="index">{{item}}</view></view>
    <view class="card">
      <view class="row between"><text class="pill">{{manual ? '人工录入' : 'AI 整理草稿'}}</text><text class="muted small">实际学习：{{submission.time_label}}</text></view>
      <view class="field"><text class="label">学习总结</text><textarea class="textarea summary" value="{{proposal.summary}}" data-field="summary" bindinput="setProposal" maxlength="500"></textarea></view>
      <view class="field"><text class="label">科目</text><picker wx:if="{{subjects.length}}" range="{{subjects}}" range-key="name" value="{{subjectIndex < 0 ? 0 : subjectIndex}}" bindchange="changeSubject"><view class="picker">{{proposal.subject_name || '选择已有学习科目'}} ›</view></picker><input class="input" value="{{proposal.subject_name}}" placeholder="填写或修改学习科目名称" data-field="subject_name" bindinput="setProposal" maxlength="40" /></view>
      <view class="field"><text class="label">来源</text><text wx:if="{{manual}}">人工录入</text><input wx:else class="input" value="{{proposal.source}}" data-field="source" bindinput="setProposal" /></view>
    </view>
    <view class="row between"><text class="section-title">知识点</text><button class="button ghost compact" disabled="{{saving || proposal.knowledge_points.length >= 20}}" bindtap="addPoint">＋ 添加</button></view>
    <view class="card point" wx:for="{{proposal.knowledge_points}}" wx:key="index">
      <view class="row between"><text style="font-weight:700">知识点 {{index + 1}}</text><button class="button ghost compact" disabled="{{saving}}" data-index="{{index}}" bindtap="removePoint">移除</button></view>
      <view class="notice" wx:if="{{!manual}}"><text>{{item.confidence_label || '家长补充，请核对'}}</text><view wx:for="{{item.evidence_labels}}" wx:for-item="evidence" wx:key="index">{{evidence}}</view><view wx:if="{{!item.evidence_labels.length}}">没有直接证据说明，请核对原始材料。</view><view wx:if="{{item.context_used.length}}">参考了 {{item.context_used.length}} 条近期记录，仅用于理解本次材料。</view></view>
      <view class="notice" wx:if="{{item.existing_knowledge_id}}">已关联已有知识点，保留其复习进度。请核对是否为同一概念。<button class="button ghost compact" disabled="{{saving}}" data-index="{{index}}" bindtap="unlinkPoint">取消关联</button></view>
      <view class="field"><text class="label">名称</text><input class="input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="setPoint" maxlength="120" /></view>
      <view class="row"><view class="field grow"><text class="label">类型</text><input class="input" value="{{item.category}}" data-index="{{index}}" data-field="category" bindinput="setPoint" /></view><view class="field grow"><text class="label">复习方式</text><input class="input" value="{{item.review_method}}" data-index="{{index}}" data-field="review_method" bindinput="setPoint" /></view></view>
      <view class="field"><text class="label">建议时长：{{item.estimated_minutes}} 分钟</text><slider min="1" max="20" value="{{item.estimated_minutes}}" data-index="{{index}}" data-field="estimated_minutes" bindchange="setPoint" activeColor="#2F766D" /></view>
    </view>
    <block wx:if="{{!manual && proposal.todo_matches.length}}"><text class="section-title">可能已完成的 Todo</text><view class="notice">以下只是 AI 匹配建议。保留后会在本次确认时标记为完成；已更新的任务不会重复推进。</view><view class="card" wx:for="{{proposal.todo_matches}}" wx:key="review_id"><view class="row between"><text>{{item.knowledge_name}}</text><button class="button ghost compact" disabled="{{saving}}" data-index="{{index}}" bindtap="removeTodoMatch">不标记</button></view><view class="muted small">{{item.evidence}}</view></view></block>
    <view class="notice error" wx:if="{{saveError}}">{{saveError}} · 内容已保留，可重试保存</view>
    <view wx:if="{{conflict}}" class="notice">这条记录已被处理；查看最新记录会离开当前编辑内容。<button class="button ghost" bindtap="load">查看最新记录</button></view>
    <button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="confirm">确认并保存学习记录</button><button class="button ghost" disabled="{{saving}}" bindtap="cancelDraft">删除草稿</button>
    </block>
  </block>
</view>
