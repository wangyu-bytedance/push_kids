<view class="page">
  <block wx:if="{{loading}}"><view class="skeleton"></view><view class="skeleton"></view></block>
  <view class="notice error" wx:elif="{{error}}">{{error}}</view>
  <block wx:else>
    <view class="notice">这是 AI 整理草稿。请检查并修改，点击确认后才会进入学习档案和复习计划。</view>
    <view class="card"><view class="row between"><text class="pill">AI 整理草稿</text><text class="muted small">实际学习：{{submission.time_label}}</text></view><view class="field"><text class="label">每日总结</text><textarea class="textarea summary" value="{{proposal.summary}}" data-field="summary" bindinput="setProposal" maxlength="500"></textarea></view><view class="field"><text class="label">科目</text><picker wx:if="{{subjects.length}}" range="{{subjects}}" range-key="name" value="{{subjectIndex < 0 ? 0 : subjectIndex}}" bindchange="changeSubject"><view class="picker">{{proposal.subject_name}} ›</view></picker><input wx:else class="input" value="{{proposal.subject_name}}" data-field="subject_name" bindinput="setProposal" /></view><view class="field"><text class="label">来源</text><input class="input" value="{{proposal.source}}" data-field="source" bindinput="setProposal" /></view></view>
    <view class="row between"><text class="section-title">知识点</text><button class="button ghost compact" bindtap="addPoint">＋ 添加</button></view>
    <view class="card point" wx:for="{{proposal.knowledge_points}}" wx:key="index"><view class="row between"><text style="font-weight:700">知识点 {{index + 1}}</text><text class="remove" data-index="{{index}}" bindtap="removePoint">移除</text></view><view class="field"><text class="label">名称</text><input class="input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="setPoint" /></view><view class="row"><view class="field grow"><text class="label">类型</text><input class="input" value="{{item.category}}" data-index="{{index}}" data-field="category" bindinput="setPoint" /></view><view class="field grow"><text class="label">复习方式</text><input class="input" value="{{item.review_method}}" data-index="{{index}}" data-field="review_method" bindinput="setPoint" /></view></view><view class="field"><text class="label">建议时长：{{item.estimated_minutes}} 分钟</text><slider min="1" max="20" value="{{item.estimated_minutes}}" data-index="{{index}}" data-field="estimated_minutes" bindchange="setPoint" activeColor="#2F766D" /></view></view>
    <block wx:if="{{proposal.todo_matches.length}}"><text class="section-title">可能已完成的今日 Todo</text><view class="notice">以下只是 AI 匹配建议。保留后会在本次确认时标记为完成。</view><view class="card" wx:for="{{proposal.todo_matches}}" wx:key="review_id"><view class="row between"><text>{{item.knowledge_name}}</text><text class="remove" data-index="{{index}}" bindtap="removeTodoMatch">不标记</text></view></view></block>
    <button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="confirm">确认并加入复习计划</button><button class="button ghost" disabled="{{saving}}" bindtap="cancelDraft">删除草稿</button>
  </block>
</view>
