.fp-button, .fp-text-button, .fp-more, .fp-tab, .fp-close, .fp-select, .fp-drafts, .fp-world-row, .fp-candidate { min-width: 0; max-width: none; margin: 0; border-radius: 10px; font-size: 14px; font-weight: 500; box-sizing: border-box; line-height: 1.45; white-space: normal; }
.fp-button::after, .fp-text-button::after, .fp-more::after, .fp-tab::after, .fp-close::after, .fp-select::after, .fp-drafts::after, .fp-world-row::after, .fp-candidate::after { border: none; }
.fp-toolbar, .fp-summary, .fp-stats, .fp-tabs, .fp-scope, .fp-place-title, .fp-sheet-head, .fp-pager, .fp-switch, .fp-draft-top, .fp-player-controls, .fp-review-tools, .fp-draft-actions, .fp-inline-actions { display: flex; align-items: center; gap: 8px; }
