.settings-page{padding-bottom:100rpx}.compact-head{min-height:82rpx}.plain{padding:120rpx 0;color:var(--muted)}.settings-title{display:block;font-size:31rpx;font-weight:730}.budget-row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0 30rpx;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.budget-options{display:flex;gap:8rpx}.budget-options button{min-width:70rpx;min-height:70rpx;padding:0 12rpx;border:1rpx solid var(--line);background:transparent;font-size:22rpx}.budget-options button::after{border:0}.budget-options button.active{background:var(--primary);color:#fff}.settings-section{display:grid;grid-template-columns:56rpx 1fr;gap:16rpx;padding:34rpx 0;border-bottom:1rpx solid var(--line)}.section-index{color:#94A19C;font-size:22rpx}.option-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}.option-card{position:relative;display:grid;grid-template-columns:56rpx 1fr;align-items:center;min-height:92rpx;padding:12rpx;text-align:left;border:1rpx solid var(--line);background:transparent;font-size:26rpx}.option-card::after,.activity-option::after,.custom-trigger::after,.weekday-row button::after{border:0}.option-card.selected{border-color:#7CAEA0;background:#E8F2EE;color:var(--primary-dark)}.option-short,.activity-short{width:50rpx;height:50rpx;line-height:50rpx;text-align:center;border-radius:14rpx;background:#E7F0EC;color:var(--primary);font-weight:700}.option-check{position:absolute;right:10rpx;top:7rpx;font-size:20rpx}.custom-trigger{width:100%;margin-top:14rpx;text-align:left;background:transparent;color:var(--primary);font-size:26rpx}.custom-row{display:grid;grid-template-columns:1fr 120rpx;gap:12rpx;margin-top:10rpx}.activity-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}.activity-option{display:flex;align-items:center;gap:12rpx;min-height:94rpx;padding:12rpx;text-align:left;border:1rpx solid var(--line);background:transparent;font-size:25rpx}.activity-option text{display:block}.activity-option.selected{border-color:#D6A477;background:#FAEFE4}.activity-short{background:#FAEBDD;color:#AE632F}.tiny{font-size:20rpx}.flexible-control{display:flex;align-items:center;gap:8rpx;font-size:22rpx}.day-label{margin-top:30rpx}.weekday-row{display:grid;grid-template-columns:repeat(7,1fr);gap:9rpx;margin:12rpx 0 24rpx}.weekday-row button{min-width:0;height:72rpx;padding:0;border:1rpx solid var(--line);border-radius:50%;background:transparent;font-size:24rpx}.weekday-row button.active{background:var(--primary);color:#fff}.time-separator{margin-top:42rpx}
