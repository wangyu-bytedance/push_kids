/* 设置主页（G1）+ 目录半屏（G2）+ 活动安排半屏（G3）：只补本页几何，颜色与字号走 tokens/atoms。 */

.settings-page { padding-top: 0; }
.settings-page .head-intro { flex: 1; min-width: 0; }
.settings-page .child-chip .chip-nm { max-width: 190rpx; }
.settings-page .child-chip.single { padding-right: 28rpx; }

.set-card { padding: 32rpx 28rpx 24rpx; }
.card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.card-head .c-t {
  display: block;
  font-size: 17px;
  line-height: 1.45;
  font-weight: 600;
  color: var(--pk-ink);
}
.card-head .c-s {
  display: block;
  margin-top: 4rpx;
  font-size: 13px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}
.card-head .c-r {
  flex: none;
  padding-top: 6rpx;
  font-size: 13px;
  color: var(--pk-ink-3);
}

/* 在学科目：三列等宽，选中即在学 */
.subj-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.subj {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  min-width: 0;
  height: 104rpx;
  border-radius: var(--pk-r-lg);
  background: var(--pk-surface-sunken);
  color: var(--pk-ink-2);
  font-size: 16px;
  line-height: 1.2;
  font-weight: 600;
}
.subj.on { background: var(--pk-primary); color: #fff; }
.subj.busy { opacity: .55; }
.subj.off { opacity: .6; }

.added-list { margin-top: 24rpx; border-top: var(--pk-border-soft); }
.added-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 8rpx 0;
}
.added-row + .added-row { border-top: var(--pk-border-soft); }
.added-row .a-n {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  line-height: 1.45;
}
.added-row .mini-btn {
  flex: none;
  box-sizing: border-box;
  min-width: 128rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-md);
  background: var(--pk-surface);
  color: var(--pk-ink-2);
  font-size: 14px;
  line-height: 88rpx;
  text-align: center;
}

/* 课外活动行 */
.act-list { margin-top: 4rpx; }
.act-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: var(--pk-row-min);
  padding: 16rpx 0;
}
.act-row + .act-row { border-top: var(--pk-border-soft); }
.act-row .a-t {
  display: block;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 500;
}
.act-row .a-s {
  display: block;
  margin-top: 4rpx;
  font-size: 13px;
  line-height: 1.45;
  color: var(--pk-ink-3);
}
.act-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--pk-r-lg);
  background: var(--pk-primary-tint);
}
.act-mark .am-txt {
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-primary-strong);
}
.inline-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 14px;
  color: var(--pk-ink-3);
}

/* 添加入口：虚线描边，不抢主 CTA 的注意力 */
.add-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border: 1rpx dashed var(--pk-primary-hairline);
  border-radius: var(--pk-r-md);
  color: var(--pk-primary);
  font-size: 15px;
  font-weight: 600;
}

.rowlist .rowitem .pill { flex: none; }

/* ---------------- G2 目录半屏 ---------------- */
.pk-sheet .seg { flex: none; }
.catalog-sheet { height: 85vh; }
.cat-body { padding-top: 24rpx; }
.search-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-pill);
  background: var(--pk-surface);
}
.search-field .search-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  font-size: 15px;
  color: var(--pk-ink);
}
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.cat-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  box-sizing: border-box;
  min-width: 0;
  height: 104rpx;
  padding: 0 24rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-md);
  background: var(--pk-surface);
  font-size: 15px;
  color: var(--pk-ink);
}
.cat-cell .c-name { min-width: 0; }
.cat-cell .c-state {
  flex: none;
  font-size: 13px;
  color: var(--pk-ink-4);
}
.cat-cell.on {
  border-color: var(--pk-primary-hairline);
  background: var(--pk-primary-tint);
  color: var(--pk-primary-strong);
}
.cat-cell.added {
  background: var(--pk-surface-sunken);
  border-color: transparent;
  color: var(--pk-ink-4);
}
.sheet-foot .foot-note {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 13px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}
.sheet-foot .err-text { margin: 0 0 16rpx; text-align: center; }

/* ---------------- G3 活动安排半屏 ---------------- */
.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 12rpx;
}
.day-head .lbl {
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-ink);
}
.wk-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 28rpx;
}
.wk {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 88rpx;
  border-radius: var(--pk-r-md);
  background: var(--pk-surface-sunken);
  color: var(--pk-ink-2);
  font-size: 15px;
  line-height: 1;
  font-weight: 600;
  aspect-ratio:1/1;
}
.wk.on { background: var(--pk-primary); color: #fff; }

.time-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.time-row .pk-field { margin-top: 0; }
.time-row .pk-field + .pk-field { margin-top: 0; }
.time-row .time-dash {
  flex: none;
  padding-bottom: 28rpx;
  color: var(--pk-ink-3);
}
.sum-note { margin-top: 28rpx; align-items: flex-start; }

.flex-note { padding: 48rpx 24rpx; text-align: center; }
.flex-note .fn-t {
  display: block;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 600;
}
.flex-note .fn-s {
  display: block;
  margin-top: 12rpx;
  font-size: 14px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

.danger-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.danger-row .danger-link {
  min-height: 88rpx;
  padding: 0 24rpx;
  color: var(--pk-danger);
  font-size: 15px;
  line-height: 88rpx;
  font-weight: 500;
}
