.settings-page{padding-bottom:calc(180rpx + env(safe-area-inset-bottom));overflow-x:hidden}.compact-head{min-height:112rpx}.compact-head .screen-intro{margin:0}.plain{padding:120rpx 0;color:var(--muted)}.block{display:block}.tiny{font-size:20rpx}.settings-title{display:block;font-size:31rpx;font-weight:730}.family-entry{display:flex;align-items:center;justify-content:space-between;min-height:112rpx;margin:22rpx 0 0;padding:28rpx}.family-arrow{flex:none;font-size:42rpx;line-height:1;color:var(--primary)}
.settings-section{margin-bottom:22rpx;padding:28rpx}.section-head{margin-bottom:20rpx}.base-grid{display:flex;gap:12rpx;width:100%;min-width:0}.base-option{position:relative;display:flex;align-items:center;justify-content:center;flex:1 1 0;width:0;min-width:0;height:88rpx;margin:0;padding:0;border:1rpx solid var(--line);border-radius:18rpx;background:transparent;font-size:26rpx;line-height:1.2;box-sizing:border-box}.base-option::after,.activity-row::after,.add-entry::after,.catalog-option::after,.weekday-row button::after,.danger-link::after,.remove-mini::after{border:0}.base-option.selected{border-color:#9dbd9b;background:var(--surface-soft);color:var(--primary-dark)}.option-check{position:absolute;right:10rpx;top:4rpx;font-size:18rpx}.added-list,.activity-list{border-top:1rpx solid var(--line)}.added-row{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;border-bottom:1rpx solid var(--line);font-size:27rpx}.remove-mini{display:flex;align-items:center;justify-content:center;flex:none;width:96rpx;min-width:96rpx;height:88rpx;min-height:88rpx;margin:0;padding:0;border:0;background:transparent;color:var(--muted);font-size:22rpx;line-height:1.2}.add-entry{display:flex;align-items:center;justify-content:center;width:100%;height:88rpx;margin:14rpx 0 0;padding:0;border:1rpx dashed #b8cbb7;border-radius:18rpx;background:transparent;color:var(--primary);font-size:25rpx;line-height:1.2;text-align:center}.activity-row{display:flex;align-items:center;gap:16rpx;width:100%;min-width:0;min-height:104rpx;margin:0;padding:14rpx 0;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;text-align:left;box-sizing:border-box}.activity-mark{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;border-radius:19rpx;background:#FAEBDD;color:#AE632F;font-weight:700}.activity-name{display:block;font-size:27rpx;font-weight:650}.inline-empty{padding:34rpx 0;text-align:center;color:var(--muted);font-size:24rpx}
.sheet-heading{display:flex;align-items:flex-start;gap:18rpx}.sheet-copy{margin:6rpx 0 20rpx}.catalog-sheet{display:flex;flex-direction:column;height:85vh;max-height:1080rpx;overflow:hidden}.catalog-modes{grid-template-columns:repeat(2,minmax(0,1fr));flex:none}.catalog-scroll{flex:1;min-height:0}.catalog-search{margin-bottom:18rpx}.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-bottom:24rpx}.catalog-grid .catalog-option{display:flex;align-items:center;justify-content:space-between;gap:8rpx;width:100%!important;max-width:100%!important;min-width:0!important;height:104rpx;min-height:104rpx;margin:0!important;padding:10rpx 20rpx;border:1rpx solid var(--line);border-radius:18rpx;background:#fff;font-size:25rpx;line-height:1.3;text-align:left;white-space:normal;box-sizing:border-box}.catalog-name{display:block;min-width:0;word-break:break-all}.catalog-status{flex:none;color:var(--primary);font-size:21rpx}.catalog-option.selected{border-color:#87aa89;background:var(--surface-soft);color:var(--primary-dark)}.catalog-option.added{color:#929994;background:#F2F2EF}.catalog-custom{flex:1;padding-top:18rpx}.sheet-footer{flex:none;padding-top:18rpx;border-top:1rpx solid var(--line);background:var(--surface)}.full-button{width:100%;margin:0}.day-label{margin-top:24rpx}.weekday-row{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx;width:100%;margin:12rpx 0 24rpx}.weekday-row button{display:flex;align-items:center;justify-content:center;justify-self:center;width:74rpx!important;min-width:74rpx!important;max-width:74rpx!important;height:74rpx;min-height:74rpx;margin:0!important;padding:0;border:1rpx solid var(--line);border-radius:16rpx;background:transparent;font-size:25rpx;line-height:1;box-sizing:border-box;aspect-ratio:1/1}.weekday-row button.active{background:var(--primary);color:#fff}.time-row{display:flex;align-items:center;gap:14rpx}.time-separator{flex:none;margin:14rpx 0 0}.schedule-summary{padding:18rpx 22rpx;border-radius:16rpx;background:var(--surface-soft);color:var(--primary-dark);font-size:22rpx}.flexible-note{padding:54rpx 20rpx;text-align:center}.danger-link{width:100%;height:82rpx;margin:12rpx 0;padding:0;border-top:1rpx solid var(--line);background:transparent;color:var(--muted);font-size:24rpx;line-height:82rpx}
@media(max-width:340px){.weekday-row{gap:4rpx}.weekday-row button{width:66rpx!important;min-width:66rpx!important;max-width:66rpx!important}.settings-section{padding:24rpx}.catalog-grid .catalog-option{padding:8rpx 14rpx}}
