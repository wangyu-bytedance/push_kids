/* 设置主页（G1）+ 目录半屏（G2）+ 活动安排半屏（G3）：只补本页几何，颜色与字号走 tokens/atoms。 */
.daily-task-setting-row { min-height: 44px; }
.daily-task-setting-copy { min-width: 0; overflow-wrap: anywhere; }
.subject-list .grow { min-width: 0; overflow-wrap: anywhere; }
.subject-list .act-row { min-height: 44px; }
.subject-list .a-s { font-size: 14px; }
.subject-sheet { height: 450px; max-height: 85vh; }
.subject-manager-body { box-sizing: border-box; max-height: 65vh; }
.subject-name { display: block; font-size: 18px; font-weight: 600; overflow-wrap: anywhere; }
.subject-status, .subject-note { display: block; margin-top: 16px; font-size: 14px; line-height: 1.5; color: var(--pk-ink-3); }
.subject-change { width: 100%; min-height: 44px; height: auto; margin: 32px 0 16px; }
.subject-change.subject-remove { color: var(--pk-danger); background: var(--pk-danger-bg); }
.subject-close { flex: none; min-width: 44px; min-height: 44px; margin: 0; padding: 0; }
.subject-close::after { border: 0; }
.daily-task-candidate { min-height: 44px; }
.daily-task-settings .c-s { font-size: 14px; }
.daily-task-settings .daily-task-add { min-height: 44px; height: auto; width: 100%; text-align: left; }
.daily-task-add::after { border: 0; }
.daily-task-form { margin-top: 28rpx; }
.daily-task-form .pk-input { min-height: 44px; }
.daily-task-form-actions { display: flex; gap: 12px; margin-top: 24rpx; }
.daily-task-form-actions .btn { flex: 1; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 12px 8px; font-size: 14px; }
.daily-task-form .daily-task-delete { width: 100%; margin: 24rpx 0; min-height: 44px; height: auto; }

.settings-page { padding-top: 0; }
.settings-page .head-intro { flex: 1; min-width: 0; }
.settings-page .child-chip .chip-nm { max-width: 190rpx; }

.profile-row {
  gap: 20rpx;
  min-height: 120rpx;
  padding: 16rpx 16rpx 16rpx 28rpx;
}
.profile-copy { min-width: 0; }
.profile-row .r-t { font-size: 16px; font-weight: 600; }
.profile-meta-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  margin-top: 4rpx;
  font-size: 12px;
  line-height: 1.5;
}
.profile-grade { min-width: 0; color: var(--pk-ink-3); }
.profile-current {
  flex: none;
  color: var(--pk-primary-strong);
  font-weight: 500;
}
.profile-edit-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: transparent;
}
.profile-edit-hit:active { background: var(--pk-primary-wash); }
.profile-add-row { min-height: 112rpx; color: var(--pk-primary-strong); }
.profile-add-row .r-t { color: var(--pk-primary-strong); font-weight: 600; }
.profile-sheet-section { margin-top: 28rpx; }
.profile-sheet-label {
  display: block;
  padding: 0 8rpx 12rpx;
  color: var(--pk-ink-3);
  font-size: 13px;
  line-height: 1.45;
}
.profile-restore { flex: none; color: var(--pk-primary-strong); font-size: 14px; }

.set-card { padding: 32rpx 28rpx 24rpx; }
.settings-paper > view, .settings-paper > button { position: relative; z-index: 1; }
.settings-paper .card-head { align-items: center; }
.settings-paper .card-head .grow { min-width: 0; overflow-wrap: anywhere; }
.settings-card-art { flex: none; width: 164rpx; height: 140rpx; pointer-events: none; }
.card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.card-head .c-t {
  display: block;
  font-size: 17px;
  line-height: 1.45;
  font-weight: 600;
  color: var(--pk-ink);
}
.card-head .c-s {
  display: block;
  margin-top: 4rpx;
  font-size: 13px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

/* 课外活动行 */
.act-list { margin-top: 4rpx; }
.act-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: var(--pk-row-min);
  padding: 16rpx 0;
}
.act-row + .act-row { border-top: var(--pk-border-soft); }
.act-row .a-t {
  display: block;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 500;
}
.act-row .a-s {
  display: block;
  margin-top: 4rpx;
  font-size: 13px;
  line-height: 1.45;
  color: var(--pk-ink-3);
}
.act-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--pk-r-lg);
  background: var(--pk-primary-tint);
}
.act-mark .am-txt {
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-primary-strong);
}
.inline-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 14px;
  color: var(--pk-ink-3);
}

.travel-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.travel-preset {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 120rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-pill);
  background: var(--pk-surface);
  color: var(--pk-ink-2);
  font-size: 14px;
}
.travel-preset.on {
  border-color: var(--pk-primary-hairline);
  background: var(--pk-primary-tint);
  color: var(--pk-primary-strong);
  font-weight: 600;
}
.travel-sheet .pk-picker.is-error { border-color: var(--pk-danger); }

.rowlist .rowitem .pill { flex: none; }

/* ---------------- G2 目录半屏 ---------------- */
.pk-sheet .seg { flex: none; }
.catalog-sheet { height: 85vh; }
.cat-body { padding-top: 24rpx; }
.search-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-pill);
  background: var(--pk-surface);
}
.search-field .search-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  font-size: 15px;
  color: var(--pk-ink);
}
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.cat-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  box-sizing: border-box;
  min-width: 0;
  height: 104rpx;
  padding: 0 24rpx;
  border: var(--pk-border);
  border-radius: var(--pk-r-md);
  background: var(--pk-surface);
  font-size: 15px;
  color: var(--pk-ink);
}
.cat-cell .c-name { min-width: 0; }
.cat-cell .c-state {
  flex: none;
  font-size: 13px;
  color: var(--pk-ink-4);
}
.cat-cell.on {
  border-color: var(--pk-primary-hairline);
  background: var(--pk-primary-tint);
  color: var(--pk-primary-strong);
}
.cat-cell.added {
  background: var(--pk-surface-sunken);
  border-color: transparent;
  color: var(--pk-ink-4);
}
.sheet-foot .err-text { margin: 0 0 16rpx; text-align: center; }

/* ---------------- G3 活动安排半屏 ---------------- */
.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 12rpx;
}
.day-head .lbl {
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-ink);
}
.wk-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 28rpx;
}
.wk {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 88rpx;
  border-radius: var(--pk-r-md);
  background: var(--pk-surface-sunken);
  color: var(--pk-ink-2);
  font-size: 15px;
  line-height: 1;
  font-weight: 600;
  aspect-ratio:1/1;
}
.wk.on { background: var(--pk-primary); color: var(--pk-ink-inv); }

.time-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.time-row .pk-field { margin-top: 0; }
.time-row .pk-field + .pk-field { margin-top: 0; }
.time-row .time-dash {
  flex: none;
  padding-bottom: 28rpx;
  color: var(--pk-ink-3);
}
.sum-note { margin-top: 28rpx; align-items: flex-start; }

/* 分别设置：逐星期一行，标签 + 起止时间选择器；三视口下纵向排列不横向滚动 */
.perday-list { display: flex; flex-direction: column; gap: 16rpx; }
.perday-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.perday-row .perday-day {
  flex: none;
  width: 72rpx;
  font-size: 15px;
  font-weight: 600;
  color: var(--pk-ink);
}
.perday-row .perday-picker { flex: 1; min-width: 0; }
.perday-row .perday-picker .pk-picker { min-height: 88rpx; }
.perday-row .time-dash { flex: none; padding: 0; color: var(--pk-ink-3); }
.perday-toggle {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-top: 8rpx;
  font-size: 14px;
  font-weight: 600;
  color: var(--pk-primary);
}

.flex-note { padding: 48rpx 24rpx; text-align: center; }
.flex-note .fn-t {
  display: block;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 600;
}
.flex-note .fn-s {
  display: block;
  margin-top: 12rpx;
  font-size: 14px;
  line-height: 1.5;
  color: var(--pk-ink-3);
}

.danger-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.danger-row .danger-link {
  min-height: 88rpx;
  padding: 0 24rpx;
  color: var(--pk-danger);
  font-size: 15px;
  line-height: 88rpx;
  font-weight: 500;
}
