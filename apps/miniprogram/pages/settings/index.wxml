<view class="page settings-page">
  <view class="compact-head"><text class="eyebrow">学习档案</text><picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view></picker></view>
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 点此重试</view><view class="empty plain" wx:if="{{!loading && !children.length}}">学习档案由后台配置，当前没有可用档案。</view>
  <block wx:if="{{children.length}}">
    <view class="budget-row"><view><text class="settings-title">每日复习计划</text><text class="muted small">用于划分“建议完成”和“有余力再做”</text></view><view class="budget-options"><button wx:for="{{budgetOptions}}" wx:key="*this" class="{{children[childIndex].daily_budget_minutes === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseBudget">{{item}} 分</button></view></view>
    <view class="settings-section"><view class="section-index">01</view><view class="section-body"><view class="row between"><text class="settings-title">在学科目</text><text class="muted small">点击即时生效</text></view><text class="muted small">只选择已经开始学习的科目</text><view class="option-grid"><button wx:for="{{learningOptions}}" wx:key="name" class="option-card {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleLearning"><text class="option-short">{{item.short}}</text><text>{{item.name}}</text><text class="option-check">{{item.selected ? '✓' : ''}}</text></button></view><button class="custom-trigger" bindtap="toggleCustom">＋ 添加其他科目</button><view class="custom-row" wx:if="{{showCustom}}"><input class="input" value="{{customName}}" data-field="customName" bindinput="setField" placeholder="物理、化学、生物、政治等"/><button class="button compact" bindtap="addCustom">添加</button></view></view></view>
    <view class="settings-section"><view class="section-index">02</view><view class="section-body"><text class="settings-title">活动安排</text><text class="muted small">选择常见活动后设置通常练习日和时间</text><view class="activity-grid"><button wx:for="{{activityOptions}}" wx:key="name" class="activity-option {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="chooseActivity"><text class="activity-short">{{item.short}}</text><view><text>{{item.name}}</text><text class="muted tiny">{{item.scheduleLabel}}</text></view></button></view></view></view>
  </block>
</view>
<view class="sheet-mask" wx:if="{{showSchedule}}" bindtap="closeSchedule"></view>
<view class="sheet" wx:if="{{showSchedule}}"><view class="sheet-handle"></view><view class="row between"><view><text class="sheet-title">{{scheduleSubject.name}}提醒</text><text class="muted small">固定安排同步展示在日程与今日</text></view><view class="flexible-control"><text>时间不固定</text><switch checked="{{flexible}}" color="#216B58" bindchange="toggleFlexible"/></view></view><view wx:if="{{!flexible}}"><text class="label day-label">通常哪天练习？</text><view class="weekday-row"><button wx:for="{{weekdayLabels}}" wx:key="index" class="{{weekdaySelected[index] ? 'active' : ''}}" data-value="{{index}}" bindtap="toggleWeekday">{{item}}</button></view><view class="row"><view class="field grow"><text class="label">开始时间</text><picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="setField"><view class="picker">{{startTime}}</view></picker></view><text class="time-separator">至</text><view class="field grow"><text class="label">结束时间</text><picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="setField"><view class="picker">{{endTime}}</view></picker></view></view></view><button class="button" loading="{{savingSchedule}}" bindtap="saveSchedule">保存提醒</button><button class="button ghost" wx:if="{{scheduleId}}" bindtap="removeActivity">移除活动</button></view>
