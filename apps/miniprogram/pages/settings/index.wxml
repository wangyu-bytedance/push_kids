<view class="page settings-page">
  <view class="compact-head"><view class="screen-intro"><text class="screen-kicker">让安排贴合孩子的日常</text><text class="screen-heading">学习设置</text></view><picker wx:if="{{children.length}}" range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view></picker></view>
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 点此重试</view>
  <view class="empty plain" wx:if="{{!loading && !children.length}}">还没有学习档案</view>
  <block wx:if="{{children.length}}">
    <view class="settings-section content-card">
      <view class="row between section-head"><view><text class="settings-title">在学科目</text><text class="muted small block">只保留孩子已经开始学习的科目</text></view><text class="muted tiny">点击切换</text></view>
      <view class="base-grid"><button wx:for="{{baseLearning}}" wx:key="name" class="base-option {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleBaseLearning"><text>{{item.name}}</text><text class="option-check">{{item.selected ? '✓' : ''}}</text></button></view>
      <view class="added-list" wx:if="{{addedLearning.length}}"><view class="added-row" wx:for="{{addedLearning}}" wx:key="id"><text>{{item.name}}</text><button class="remove-mini" data-id="{{item.id}}" bindtap="removeLearning">移出</button></view></view>
      <button class="add-entry" data-type="learning" bindtap="openCatalog">＋ 添加其他科目</button>
    </view>
    <view class="settings-section content-card activity-section">
      <view class="section-head"><text class="settings-title">课外活动</text><text class="muted small block">按实际参与情况添加，可设置固定时间</text></view>
      <view class="activity-list" wx:if="{{addedActivities.length}}"><button class="activity-row" wx:for="{{addedActivities}}" wx:key="id" data-index="{{index}}" bindtap="openActivitySchedule"><view class="activity-mark">{{item.short}}</view><view class="grow"><text class="activity-name">{{item.name}}</text><text class="muted tiny block">{{item.scheduleLabel}}</text></view><text class="family-arrow">›</text></button></view>
      <view class="inline-empty" wx:else>还没有添加课外活动</view>
      <button class="add-entry" data-type="activity" bindtap="openCatalog">＋ 添加课外活动</button>
    </view>
    <view class="family-entry content-card" bindtap="openFamily"><view class="grow"><text class="settings-title">家庭与成员</text><text class="muted small block">邀请家人，一起记录与陪伴</text></view><text class="family-arrow">›</text></view>
  </block>
</view>

<view class="sheet-mask" wx:if="{{showCatalog}}" bindtap="closeCatalog"></view>
<view class="sheet catalog-sheet" wx:if="{{showCatalog}}">
  <view class="sheet-handle"></view><view class="sheet-heading"><view class="grow"><text class="sheet-title">{{catalogTitle}}</text><text class="muted small block sheet-copy">只选择已经开始{{catalogType === 'activity' ? '参与' : '学习'}}的内容。</text></view><view class="icon-button" bindtap="closeCatalog" aria-role="button" aria-label="关闭">×</view></view>
  <view class="segmented two catalog-modes"><button class="{{catalogMode === 'catalog' ? 'active' : ''}}" data-mode="catalog" bindtap="changeCatalogMode">从目录选择</button><button class="{{catalogMode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="changeCatalogMode">自定义名称</button></view>
  <scroll-view class="catalog-scroll" scroll-y wx:if="{{catalogMode === 'catalog'}}"><input class="input catalog-search" value="{{catalogQuery}}" bindinput="filterCatalog" placeholder="搜索{{catalogType === 'activity' ? '课外活动' : '科目'}}"/><view class="catalog-grid"><button wx:for="{{catalogOptions}}" wx:key="name" disabled="{{item.added}}" class="catalog-option {{selectedCatalogName === item.name ? 'selected' : ''}} {{item.added ? 'added' : ''}}" data-index="{{index}}" bindtap="chooseCatalog"><text class="catalog-name">{{item.name}}</text><text class="catalog-status">{{item.added ? '已添加' : (selectedCatalogName === item.name ? '✓' : '＋')}}</text></button></view><view class="inline-empty" wx:if="{{!catalogOptions.length}}">没有找到这个名称，请使用自定义名称。</view></scroll-view>
  <view class="catalog-custom" wx:else><view class="field"><text class="label">{{catalogType === 'activity' ? '课外活动' : '科目'}}名称</text><input class="input" value="{{customCatalogName}}" data-field="customCatalogName" bindinput="setField" placeholder="例如：{{catalogType === 'activity' ? '陶艺' : '自然观察'}}" maxlength="30"/></view><text class="muted small block">不在目录里，也可以按实际名称添加。</text></view>
  <view class="sheet-footer"><view class="action-row"><button class="button full-button" loading="{{addingCatalog}}" disabled="{{addingCatalog || (!selectedCatalogName && !customCatalogName)}}" bindtap="addCatalog">{{selectedCatalogName ? '添加「' + selectedCatalogName + '」' : '添加' + (catalogType === 'activity' ? '课外活动' : '科目')}}</button></view></view>
</view>

<view class="sheet-mask" wx:if="{{showSchedule}}" bindtap="closeSchedule"></view>
<view class="sheet" wx:if="{{showSchedule}}">
  <view class="sheet-handle"></view><view class="sheet-heading"><view class="grow"><text class="sheet-title">{{scheduleSubject.name}}安排</text><text class="muted small block">固定安排会显示在日程与今日。</text></view><view class="icon-button" bindtap="closeSchedule" aria-role="button" aria-label="关闭">×</view></view>
  <view class="segmented two catalog-modes"><button class="{{!flexible ? 'active' : ''}}" data-mode="fixed" bindtap="chooseScheduleMode">固定时间</button><button class="{{flexible ? 'active' : ''}}" data-mode="flexible" bindtap="chooseScheduleMode">时间不固定</button></view>
  <view wx:if="{{!flexible}}"><view class="row between day-label"><text class="label">每周哪几天</text><text class="muted tiny">可多选</text></view><view class="weekday-row"><button wx:for="{{weekdayLabels}}" wx:key="index" class="{{weekdaySelected[index] ? 'active' : ''}}" data-value="{{index}}" bindtap="toggleWeekday">{{item}}</button></view><view class="time-row"><view class="field grow"><text class="label">开始时间</text><picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="setField"><view class="picker">{{startTime}}</view></picker></view><text class="time-separator">—</text><view class="field grow"><text class="label">结束时间</text><picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="setField"><view class="picker">{{endTime}}</view></picker></view></view><view class="schedule-summary">{{scheduleSummary}}</view></view>
  <view class="flexible-note" wx:else><text class="settings-title">按实际参与情况记录</text><text class="muted small block">暂不生成固定日程，参加后仍可以记录这次练习。</text></view>
  <button class="danger-link" bindtap="removeActivity">移除这项活动</button><view class="sheet-footer"><view class="action-row"><button class="button full-button" loading="{{savingSchedule}}" disabled="{{savingSchedule}}" bindtap="saveSchedule">保存安排</button></view></view>
</view>
