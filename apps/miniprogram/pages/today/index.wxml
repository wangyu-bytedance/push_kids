<view class="page">
  <block wx:if="{{loading}}"><view class="skeleton"></view><view class="skeleton"></view><view class="skeleton"></view></block>
  <view class="notice error" wx:elif="{{error}}" bindtap="load">{{error}} · 点此重试</view>
  <view class="empty plain" wx:elif="{{!children.length}}"><view class="empty-mark">芽</view><text>尚未配置学习档案</text><text class="muted small">请先通过后台配置，页面不会生成示例数据。</text><button class="button secondary" bindtap="load">重新读取</button></view>
  <block wx:elif="{{dashboard}}">
    <view class="compact-head"><text class="eyebrow">{{dashboard.day}}</text><picker range="{{children}}" range-key="name" value="{{childIndex}}" bindchange="changeChild"><view class="child-trigger"><text class="avatar-small">{{children[childIndex].avatar}}</text><text>{{children[childIndex].name}}</text><text class="chevron"></text></view></picker></view>
    <view class="notice" wx:if="{{dashboard.pending_confirmation_count || dashboard.analyzing_count}}" bindtap="openPending">{{dashboard.analyzing_count}} 条正在整理，{{dashboard.pending_confirmation_count}} 条等你确认 ›</view>
    <view class="notice error" wx:if="{{dashboard.failed_count}}" bindtap="openPending">{{dashboard.failed_count}} 条分析失败，可在记录页重试 ›</view>
    <view class="today-section"><button class="section-toggle" data-section="review" bindtap="toggleSection"><text>今日复习</text><text class="section-meta">{{dashboard.todo_count}} 项</text><text class="chevron {{sections.review ? 'up' : ''}}"></text></button><view wx:if="{{sections.review}}"><todo-card wx:for="{{dashboard.must_todo_groups}}" wx:key="id" group="{{item}}" bindfeedback="feedback" bindpractice="practice"></todo-card><view class="subheading" wx:if="{{dashboard.optional_todo_groups.length}}">有余力再做</view><todo-card wx:for="{{dashboard.optional_todo_groups}}" wx:key="id" group="{{item}}" bindfeedback="feedback" bindpractice="practice"></todo-card><view class="empty inline" wx:if="{{!dashboard.todo_groups.length}}">今天没有到期的复习</view></view></view>
    <view class="today-section"><button class="section-toggle" data-section="learning" bindtap="toggleSection"><text>今日学习</text><text class="section-meta">已确认 {{dashboard.daily_summary.record_count}} 条</text><text class="chevron {{sections.learning ? 'up' : ''}}"></text></button><view wx:if="{{sections.learning}}"><view class="fact-row" wx:for="{{dashboard.daily_summary.subjects}}" wx:key="subject_id"><text class="fact-subject">{{item.subject_name}}</text><text class="fact-summary">{{item.summary_text}}</text></view><view class="empty inline" wx:if="{{!dashboard.daily_summary.record_count}}">今天还没有确认过的学习记录</view></view></view>
    <view class="today-section"><button class="section-toggle" data-section="activity" bindtap="toggleSection"><text>今日活动</text><text class="section-meta">{{dashboard.schedule_items.length + dashboard.optional_activity_suggestions.length}} 项</text><text class="chevron {{sections.activity ? 'up' : ''}}"></text></button><view wx:if="{{sections.activity}}"><view class="activity-row {{item.past ? 'past' : ''}}" wx:for="{{dashboard.schedule_items}}" wx:key="id"><view class="grow"><text class="activity-time">{{item.start_time}}–{{item.end_time}}</text><text class="activity-name">{{item.name}}</text><text class="muted small" wx:if="{{item.past}}">已结束，仍可补记练习</text></view><button wx:if="{{item.kind === 'activity'}}" class="small-action" data-subject-id="{{item.subject_id}}" bindtap="openActivity">记录</button></view><view class="activity-row suggestion" wx:for="{{dashboard.optional_activity_suggestions}}" wx:key="schedule_id"><view class="grow"><text class="activity-name">{{item.subject_name}}</text><text class="muted small">{{item.message}}</text></view><button class="small-action" data-subject-id="{{item.subject_id}}" bindtap="openActivity">记录</button></view><view class="empty inline" wx:if="{{!dashboard.schedule_items.length && !dashboard.optional_activity_suggestions.length}}">今天没有活动安排或建议</view></view></view>
  </block>
</view>
