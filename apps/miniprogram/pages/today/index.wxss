.compact-head { display:flex; justify-content:space-between; align-items:center; min-height:99rpx; margin-bottom:42rpx; }.compact-head .screen-intro{margin:0}
.today-section { border-bottom:1rpx solid var(--line); }
.section-toggle,.section-header { width:100%; min-width:0; min-height:85rpx; padding:0; margin:0; display:flex; align-items:center; justify-content:space-between; text-align:left; background:transparent; color:var(--ink); font-size:35rpx; font-weight:650; box-sizing:border-box; }
.section-toggle::after,.section-link::after{border:0}.section-name{display:flex;align-items:baseline;gap:12rpx}.section-meta{font-size:23rpx;color:var(--muted);font-weight:400}.section-link{display:flex;align-items:center;gap:8rpx;min-height:85rpx;margin:0;padding:0;background:transparent;color:var(--primary);font-size:25rpx;font-weight:550}.section-link .ui-chevron{width:12rpx;height:12rpx;border-width:2rpx}.subheading{padding:18rpx 0 8rpx;color:var(--muted);font-size:24rpx}.empty.inline{display:flex;align-items:center;justify-content:center;min-height:86rpx;padding:12rpx 20rpx 23rpx;text-align:center;color:var(--muted);font-size:25rpx;box-sizing:border-box}
.fact-row{display:grid;grid-template-columns:100rpx 1fr;gap:18rpx;padding:22rpx 0;border-top:1rpx solid var(--line)}.fact-subject{font-weight:700;color:var(--primary)}.fact-summary{color:#48534f}
.activity-section{border-bottom:0}.activity-row{display:flex;gap:25rpx;align-items:flex-start;margin-bottom:18rpx;padding:35rpx;border:1rpx solid var(--line);border-radius:35rpx;background:var(--surface)}.activity-row.past{opacity:1}.activity-time,.activity-name,.activity-meta{display:block}.activity-time{flex:none;width:79rpx;padding-top:8rpx;font-size:25rpx;color:#A46133;font-weight:600}.activity-body{padding:4rpx 0 4rpx 25rpx;border-left:4rpx solid #CFA77B}.activity-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.activity-name{font-size:29rpx;font-weight:650}.activity-meta{margin-top:10rpx;font-size:23rpx;line-height:1.8}.activity-record{display:flex;align-items:center;gap:7rpx;min-height:67rpx;margin:0;padding:0;background:transparent;color:var(--primary);font-size:25rpx;font-weight:550}.activity-record::after{border:0}.activity-record .ui-chevron{width:12rpx;height:12rpx;border-width:2rpx}.status-badge{flex:none;padding:4rpx 13rpx;border-radius:10rpx;background:#eff1eb;color:var(--muted);font-size:21rpx;line-height:1.6}.small-action{min-height:70rpx;padding:0 24rpx;background:transparent;border:1rpx solid #D7B28F;color:#8B4F28;font-size:24rpx}.small-action::after{border:0}
.plain{background:transparent;padding-top:150rpx}.empty-title{display:block;font-size:32rpx;font-weight:700}.empty-copy,.guide-copy{display:block;margin-top:8rpx}.full-action{width:100%;margin-top:28rpx}.start-guide{position:relative;margin:0 0 29rpx;padding:38rpx;border:1rpx solid #dce7d9;border-radius:35rpx;background:var(--surface-soft);text-align:left;box-sizing:border-box;overflow:hidden}.guide-sprout{position:absolute;right:35rpx;top:36rpx;width:90rpx;height:90rpx;opacity:.6}.guide-kicker{display:inline-block;margin-bottom:6rpx;color:var(--primary);font-size:19rpx;letter-spacing:2rpx;font-weight:600}.guide-title{display:block;font-size:42rpx;line-height:1.5;font-weight:650;letter-spacing:1rpx}.guide-copy{max-width:75%;font-size:25rpx;line-height:1.8}.guide-primary{width:100%;min-height:85rpx;margin-top:30rpx}.start-guide .quiet-link{width:100%;min-height:68rpx;margin-bottom:-17rpx;gap:8rpx}
.history-link{min-height:44px;line-height:1.5;margin:0;padding:10px 8px;box-sizing:border-box;background:transparent;color:var(--primary);font-size:14px;white-space:normal;text-align:left}.history-link::after{border:0}.history-focus{display:block;border-left:3px solid var(--primary)}
.guide-primary{width:100%!important;max-width:none!important}
