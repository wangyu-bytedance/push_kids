/* 今日（B1~B5）：只写本页特有的几何，其余全部复用 tokens / atoms / icons。 */
.today-page { padding-top: 0; }
.pg-head .head-intro { flex: 1; min-width: 0; }
.child-chip .chip-nm { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.child-chip.single { padding-right: 28rpx; }

.pk-notice .back-link { flex: none; display: flex; align-items: center; gap: 8rpx; min-height: 88rpx; font-size: 13px; font-weight: 600; color: var(--pk-ink-2); }

/* 首次引导 Hero（B3）：三步说明必须写清「你确认后才生效」。 */
.pk-hero.guide .hero-line { font-size: 22px; line-height: 1.35; }
.pk-hero.guide .steps { margin-top: 24rpx; }
.pk-hero.guide .step { display: flex; align-items: flex-start; gap: 16rpx; min-height: 56rpx; }
.pk-hero.guide .step .sn { flex: none; width: 36rpx; height: 36rpx; margin-top: 6rpx; border-radius: 50%; background: rgba(46, 106, 86, .12); color: var(--pk-primary-strong); font-size: 12px; font-weight: 700; line-height: 36rpx; text-align: center; }
.pk-hero.guide .step .sc { flex: 1; min-width: 0; font-size: 14px; line-height: 1.5; color: #4C6459; }
.pk-hero.guide .guide-link { display: flex; justify-content: center; margin-top: 8rpx; }

/* 可选 Todo 分组小标题 */
.opt-head { display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; padding: 0 4rpx; }
.opt-head .opt-head-t { flex: none; font-size: 13px; color: var(--pk-ink-3); }
.opt-head .opt-head-line { flex: 1; min-width: 0; height: 1rpx; background: var(--pk-line-soft); }

.sec-body .todo-slot { display: block; }
.sec-body .todo-slot + .todo-slot { margin-top: 20rpx; }
.sec-body .opt-head + .todo-slot { margin-top: 20rpx; }
.sec-body .todo-slot.history-focus { border-left: 6rpx solid var(--pk-primary); border-radius: var(--pk-r-xs); }
.more-todo { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 88rpx; margin-top: 20rpx; border: 1rpx dashed var(--pk-line-strong); border-radius: var(--pk-r-lg); background: var(--pk-surface-warm); color: var(--pk-ink-2); font-size: 14px; font-weight: 500; box-sizing: border-box; }

.sec-body .tl-card .link-btn { min-height: 72rpx; }
.pk-empty.inline .ea { margin-top: 24rpx; display: flex; justify-content: center; }

/* 孩子切换半屏（B4） */
.child-sheet .rowitem.on { background: var(--pk-primary-tint); }
.child-sheet .ava-lg { flex: none; width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--pk-primary); color: #fff; font-size: 14px; font-weight: 600; line-height: 80rpx; text-align: center; }
.child-sheet .sheet-tip { display: block; padding: 24rpx 8rpx 8rpx; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); }
