.compact-head { display:flex; justify-content:space-between; align-items:center; min-height:108rpx; margin-bottom:18rpx; }.compact-head .screen-intro{margin:0}
.today-section { border-top:1rpx solid var(--line); }
.section-toggle { width:100%; min-width:0; min-height:112rpx; padding:0; margin:0; display:grid; grid-template-columns:auto 1fr 30rpx; gap:14rpx; align-items:center; text-align:left; background:transparent; color:var(--ink); font-size:34rpx; font-weight:700; box-sizing:border-box; }
.section-toggle::after{border:0}.section-meta{font-size:24rpx;color:var(--muted);font-weight:400}.subheading{padding:18rpx 0 8rpx;color:var(--muted);font-size:24rpx}.empty.inline{display:flex;align-items:center;justify-content:center;min-height:116rpx;padding:0 20rpx;text-align:center;color:var(--muted)}
.fact-row{display:grid;grid-template-columns:100rpx 1fr;gap:18rpx;padding:22rpx 0;border-top:1rpx solid var(--line)}.fact-subject{font-weight:700;color:var(--primary)}.fact-summary{color:#48534f}
.activity-row{display:flex;gap:16rpx;align-items:flex-start;margin-bottom:18rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface)}.activity-row.past{opacity:1}.activity-time,.activity-name{display:block}.activity-time{flex:none;width:84rpx;padding-top:2rpx;font-size:24rpx;color:#B0642E;font-weight:650}.activity-body{padding-left:18rpx;border-left:3rpx solid #D7B28F}.activity-name{font-size:28rpx;font-weight:700}.activity-record{display:flex;align-items:center;min-height:60rpx;margin:4rpx 0 0;padding:0;background:transparent;color:var(--primary);font-size:24rpx}.activity-record::after{border:0}.status-badge{flex:none;padding:6rpx 12rpx;border-radius:10rpx;background:#eef0ea;color:var(--muted);font-size:20rpx}.small-action{min-height:70rpx;padding:0 24rpx;background:transparent;border:1rpx solid #D7B28F;color:#8B4F28;font-size:24rpx}.small-action::after{border:0}
.plain{background:transparent;padding-top:150rpx}.empty-title{display:block;font-size:32rpx;font-weight:700}.empty-copy,.guide-copy{display:block;margin-top:8rpx}.full-action{width:100%;margin-top:28rpx}.start-guide{position:relative;margin:8rpx 0 28rpx;padding:34rpx;border:1rpx solid #d7e5da;border-radius:28rpx;background:var(--surface-soft);text-align:left;box-sizing:border-box;overflow:hidden}.start-guide::after{content:'芽';position:absolute;right:30rpx;top:22rpx;color:#94b08e;font-size:60rpx;opacity:.55}.guide-kicker{display:inline-block;margin-bottom:8rpx;color:var(--primary);font-size:21rpx;font-weight:650}.guide-title{display:block;font-size:36rpx;font-weight:720}.guide-copy{max-width:75%}.guide-primary{width:100%;margin-top:24rpx}.start-guide .quiet-link{width:100%;min-height:68rpx}
.history-link{min-height:44px;line-height:1.5;margin:0;padding:10px 8px;box-sizing:border-box;background:transparent;color:var(--primary);font-size:14px;white-space:normal;text-align:left}.history-link::after{border:0}.history-focus{display:block;border-left:3px solid var(--primary)}
