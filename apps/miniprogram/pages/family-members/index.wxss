.block{display:block}.tiny{font-size:20rpx}.family-banner{display:flex;align-items:center;gap:18rpx;margin:4rpx 0 24rpx}.family-emblem{display:flex;align-items:center;justify-content:center;flex:none;width:78rpx;height:78rpx;border-radius:24rpx;background:var(--surface-soft);color:var(--primary);font-size:26rpx;font-weight:700}.family-banner .title{font-size:42rpx}.manager-panel{display:grid;grid-template-columns:minmax(0,1fr);gap:14rpx;width:100%;margin:8rpx 0 18rpx;box-sizing:border-box}.invitation-card{padding:34rpx;border:1rpx solid #d5e4d8;border-radius:28rpx;background:var(--surface-soft)}.invite-title{display:block;font-size:34rpx;font-weight:720}.invite-copy{display:block;margin:10rpx 0 24rpx;max-width:560rpx;color:#526d59;font-size:24rpx;line-height:1.75}.invite-helper{display:block;margin-top:14rpx;text-align:center;color:var(--muted);font-size:20rpx}.invite-button,.share-button,.full-button{width:100%;min-width:0;max-width:none;margin-left:0;margin-right:0;box-sizing:border-box}.invite-button.disabled{opacity:.58}.request-entry{display:flex;align-items:center;gap:16rpx;width:100%;min-width:0;min-height:116rpx;margin:22rpx 0;padding:20rpx 24rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface);text-align:left;box-sizing:border-box}.request-entry::after,.revoke-button::after,.danger-button::after{border:0}.request-icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#eef1e5;color:var(--primary);font-weight:700}.entry-title{display:block;font-size:27rpx;font-weight:700}.request-count{display:flex;align-items:center;justify-content:center;flex:none;width:42rpx;height:42rpx;border-radius:50%;background:#A94F48;color:#fff;font-size:21rpx}.family-arrow{flex:none;font-size:42rpx;line-height:1;color:var(--primary)}.family-help{margin-bottom:24rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#f0f1ed;color:var(--muted);font-size:22rpx}.family-help text{display:block;margin-top:8rpx}.members-heading{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.members-heading .section-title{margin:0}
