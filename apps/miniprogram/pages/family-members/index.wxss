/* 家庭与成员（G4）：Hero + 申请入口 + 成员行列表 + 成员详情半屏。
   兼容既有断言：.manager-panel 保持 grid-template-columns:minmax(0,1fr)，.member-list 保持 width:100%。 */
.members-page { padding-top: 24rpx; }

/* 家庭 Hero */
.family-hero .fam-mark { flex: none; width: 88rpx; height: 88rpx; border-radius: var(--pk-r-lg); background: var(--pk-surface); display: flex; align-items: center; justify-content: center; }
.family-hero .fam-name { margin-top: 4rpx; font-size: 20px; }
.family-hero .icon-btn { background: rgba(255, 255, 255, .82); }
.family-hero .hero-note { text-align: center; }
.manager-panel{display:grid;grid-template-columns:minmax(0,1fr);gap:20rpx;width:100%;margin-top:32rpx;box-sizing:border-box}
.invite-button { width: 100%; min-width: 0; max-width: none; box-sizing: border-box; }

/* 邀请已准备好 */
.share-card .share-title { display: block; font-size: 17px; line-height: 1.45; font-weight: 600; }
.share-card .share-sub { display: block; margin-top: 8rpx; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); }
.share-card .btn-row > .btn { width: 100%; min-width: 0; }

/* 加入申请入口：整行可点，右侧 chevron */
.request-entry { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 132rpx; margin-top: 24rpx; padding: 24rpx 28rpx; box-sizing: border-box; background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-xl); }
.request-entry .req-mark { flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--pk-surface-sunken); display: flex; align-items: center; justify-content: center; }
.request-entry .req-mark.on { background: var(--pk-danger-bg); }
.request-entry .entry-title { display: block; font-size: 16px; line-height: 1.45; font-weight: 500; }
.request-entry .entry-sub { display: block; margin-top: 4rpx; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); }

/* 成员列表 */
.members-page .sec-bar .s-m { text-align: right; }
.member-list{width:100%;box-sizing:border-box;background:var(--pk-surface);border:var(--pk-border);border-radius:var(--pk-r-xl);overflow:hidden}
.member-row { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: var(--pk-row-min); padding: 24rpx 28rpx; box-sizing: border-box; }
.member-row + .member-row { border-top: var(--pk-border-soft); }
.member-row .mem-ava { flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--pk-surface-sunken); color: var(--pk-ink-2); font-size: 14px; font-weight: 600; line-height: 72rpx; text-align: center; }
.member-row .mem-ava.mine { background: var(--pk-primary); color: #fff; }
.member-row .mem-line { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.member-row .mem-name { font-size: 16px; line-height: 1.45; font-weight: 500; max-width: 320rpx; }
.member-row .mem-sub { display: block; margin-top: 4rpx; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); }

/* 成员详情半屏 */
.member-sheet .read-value { min-height: 92rpx; padding: 24rpx 28rpx; box-sizing: border-box; border-radius: var(--pk-r-lg); background: var(--pk-surface-sunken); color: var(--pk-ink-2); font-size: 16px; line-height: 1.4; }
.member-sheet .danger-zone { margin-top: 24rpx; padding-top: 24rpx; border-top: var(--pk-border-soft); text-align: center; }
.member-sheet .danger-copy { display: block; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); }
.member-sheet .danger-link { color: var(--pk-danger); }
.member-sheet .err-text { display: block; }

.sk.card-sk { height: 232rpx; }
