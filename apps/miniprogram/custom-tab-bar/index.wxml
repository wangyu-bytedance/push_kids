<view class="{{theme.classes}}" style="{{theme.style}}">
<view class="tabbar" wx:if="{{!renewalGuideVisible && !recordOverlayVisible && !gradeConfirmationVisible && !themePickerVisible}}">
  <view class="tab {{selected === index ? 'active' : ''}} {{item.center ? 'is-center' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab">
    <view class="key" wx:if="{{item.center}}">
      <theme-icon name="camera" tone="inverse" size="lg"></theme-icon>
      <text class="tab-badge on-key" wx:if="{{badges[item.icon]}}">{{badges[item.icon] > 99 ? '99+' : badges[item.icon]}}</text>
    </view>
    <view class="icon-slot" wx:else>
      <theme-icon name="{{item.glyph}}" tone="{{selected === index ? 'primary' : 'muted'}}"></theme-icon>
      <text class="tab-badge" wx:if="{{badges[item.icon]}}">{{badges[item.icon] > 99 ? '99+' : badges[item.icon]}}</text>
    </view>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>

</view>
