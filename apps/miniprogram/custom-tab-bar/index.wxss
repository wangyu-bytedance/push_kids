.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:flex-start;height:calc(98rpx + env(safe-area-inset-bottom));padding:12rpx 8rpx env(safe-area-inset-bottom);border-top:1rpx solid rgba(29,43,36,.08);background:#FFFEFA;color:#79857E;box-sizing:border-box}
.tab{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;flex:1;min-width:0;height:80rpx;gap:4rpx}
.tab.active{color:#2E6A56}
.icon-slot{position:relative;width:44rpx;height:44rpx}
.tab-icon{display:block;width:40rpx;height:40rpx;margin:2rpx}
.tab-badge{position:absolute;left:26rpx;top:-6rpx;min-width:32rpx;height:32rpx;padding:0 6rpx;border-radius:16rpx;background:#A6423B;color:#fff;font-size:10px;font-weight:600;line-height:32rpx;text-align:center;box-sizing:border-box}
.tab-label{font-size:10px;line-height:1.2;font-weight:500}
