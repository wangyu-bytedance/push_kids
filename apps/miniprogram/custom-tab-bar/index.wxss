.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:flex-start;height:calc(108rpx + env(safe-area-inset-bottom));padding:14rpx 4rpx env(safe-area-inset-bottom);border-top:1rpx solid rgba(34,38,31,.06);background:rgba(255,253,248,.92);backdrop-filter:blur(18px);box-shadow:0 -12rpx 40rpx -24rpx rgba(34,38,31,.3);color:#8E9686;box-sizing:border-box}
.tab{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;flex:1;min-width:0;height:88rpx;gap:6rpx}
.tab.active{color:#14402F}
.icon-slot{position:relative;display:flex;align-items:center;justify-content:center;width:56rpx;height:48rpx}
.icon-slot::before{content:"";position:absolute;left:50%;top:50%;width:56rpx;height:56rpx;margin:-28rpx 0 0 -28rpx;border-radius:50%;background:#E4EDE6;opacity:0;transform:scale(.6);transition:opacity 240ms cubic-bezier(.22,.75,.24,1),transform 240ms cubic-bezier(.34,1.42,.5,1)}
.tab.active .icon-slot::before{opacity:1;transform:scale(1)}
.tab-icon{position:relative;display:block;width:40rpx;height:40rpx}
.tab-label{font-size:10px;line-height:1.2;font-weight:500;letter-spacing:.5rpx}
.tab.active .tab-label{font-weight:600}
/* 中央凸起「记录」键：全局唯一的高饱和触点，让「记下今天学到的」永远一键可达 */
.tab.is-center{justify-content:flex-start}
.tab.is-center .key{position:relative;display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin-top:-46rpx;border-radius:50%;background:linear-gradient(150deg,#38826A,#14402F);border:6rpx solid rgba(255,253,248,.94);box-sizing:border-box;box-shadow:0 20rpx 44rpx -16rpx rgba(31,91,69,.66)}
.tab.is-center .key-icon{width:46rpx;height:46rpx}
.tab.is-center .tab-label{margin-top:2rpx;color:#14402F;font-weight:600}
.tab.is-center:active .key{transform:scale(.94)}
.tab-badge{position:absolute;left:30rpx;top:-4rpx;min-width:30rpx;height:30rpx;padding:0 7rpx;border-radius:15rpx;background:#A9762A;color:#FFFDF8;font-size:10px;font-weight:600;line-height:30rpx;text-align:center;box-sizing:border-box;box-shadow:0 0 0 4rpx rgba(255,253,248,.95)}
.tab-badge.on-key{left:auto;right:-2rpx;top:-2rpx}
