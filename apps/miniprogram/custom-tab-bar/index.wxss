.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:flex-start;height:calc(94rpx + env(safe-area-inset-bottom));padding:17rpx 13rpx env(safe-area-inset-bottom);border-top:1rpx solid #e2e7de;background:#fffefb;color:#69766f;box-sizing:border-box}.tab{position:relative;display:flex;align-items:center;justify-content:flex-start;flex:1;min-width:0;height:77rpx;gap:4rpx;flex-direction:column;font-size:20rpx;line-height:1.35}.tab.active{color:#296653;font-weight:650}.tab-icon{display:block;width:40rpx;height:40rpx}.active-line{position:absolute;left:50%;top:-18rpx;width:42rpx;height:6rpx;border-radius:6rpx;background:transparent;transform:translateX(-50%)}.tab.active .active-line{background:#296653}.home-indicator{position:absolute;left:50%;bottom:10rpx;width:200rpx;height:8rpx;border-radius:8rpx;background:#27322a;transform:translateX(-50%)}
