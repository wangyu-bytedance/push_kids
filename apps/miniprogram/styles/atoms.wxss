/* 知芽 Push Kids · PKDS-1.0 原子组件层
   规则：几何量 rpx，字号 px，发丝线 1rpx；类名前缀 pk- 的是新原子，无前缀的是与既有页面共用的通用原子。 */

/* ---------------- 字阶 ---------------- */
.t-display { font-size: 28px; line-height: 1.15; font-weight: 700; letter-spacing: -.4px; }
.t-h1 { font-size: 22px; line-height: 1.3; font-weight: 700; letter-spacing: -.2px; }
.t-h2 { font-size: 18px; line-height: 1.4; font-weight: 600; }
.t-h3 { font-size: 17px; line-height: 1.45; font-weight: 600; }
.t-body { font-size: 16px; line-height: 1.55; }
.t-body-m { font-size: 16px; line-height: 1.55; font-weight: 500; }
.t-sub { font-size: 14px; line-height: 1.5; }
.t-sub-m { font-size: 14px; line-height: 1.5; font-weight: 500; }
.t-cap { font-size: 13px; line-height: 1.45; }
.t-micro { font-size: 11px; line-height: 1.3; font-weight: 500; }
.c-ink { color: var(--pk-ink); }
.c-ink-2 { color: var(--pk-ink-2); }
.c-ink-3 { color: var(--pk-ink-3); }
.c-pri { color: var(--pk-primary); }
.c-att { color: var(--pk-attention); }
.c-dan { color: var(--pk-danger); }
.c-suc { color: var(--pk-success); }
.tnum { font-variant-numeric: tabular-nums; }
.block { display: block; }
.trunc { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------------- 页内头部 ---------------- */
.pg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 24rpx 0 32rpx; }
.pg-kicker { display: block; font-size: 13px; line-height: 1.4; color: var(--pk-ink-3); }
.pg-title { display: block; margin-top: 4rpx; font-size: 22px; line-height: 1.3; font-weight: 700; letter-spacing: -.2px; }

.child-chip {
  flex: 0 0 auto; height: 80rpx; box-sizing: border-box;
  display: inline-flex; align-items: center; gap: 12rpx;
  margin: 0; padding: 0 24rpx 0 10rpx; border-radius: var(--pk-r-pill);
  background: var(--pk-surface); border: var(--pk-border);
  font-size: 14px; line-height: 1.4; font-weight: 600; color: var(--pk-ink);
}
.child-chip::after { border: 0; }
.child-chip .ava {
  flex: none; width: 60rpx; height: 60rpx; border-radius: 50%;
  background: var(--pk-primary-tint); color: var(--pk-primary-strong);
  font-size: 13px; font-weight: 600; line-height: 60rpx; text-align: center;
}

.chev { flex: none; width: 14rpx; height: 14rpx; border-right: 3rpx solid var(--pk-ink-3); border-bottom: 3rpx solid var(--pk-ink-3); transform: rotate(45deg) translateY(-4rpx); transition: transform var(--pk-dur-fast) var(--pk-ease); }
.chev.up { transform: rotate(225deg) translate(-2rpx, -2rpx); }
.chev.right { transform: rotate(-45deg); }
.chev.pri { border-color: var(--pk-primary); }

/* ---------------- 卡片 ---------------- */
.pk-card { background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-xl); padding: var(--pk-s4); box-shadow: var(--pk-e0); box-sizing: border-box; }
.pk-card + .pk-card { margin-top: var(--pk-s3); }
.pk-card.flat { background: var(--pk-surface-warm); }
.pk-card.tight { padding: 28rpx; }
.pk-card.plain { border-radius: var(--pk-r-lg); }

.pk-hero {
  border-radius: var(--pk-r-2xl); padding: var(--pk-s5); box-sizing: border-box;
  background: linear-gradient(158deg, #E4EFE8 0%, #EDF1E4 100%);
  border: 1rpx solid #DAE7DE;
}
.pk-hero .hero-eyebrow { display: block; font-size: 13px; line-height: 1.45; color: #4C6459; }
.pk-hero .hero-line { display: block; margin-top: 12rpx; font-size: 20px; line-height: 1.35; font-weight: 700; color: var(--pk-primary-strong); }
.pk-hero .hero-num { font-size: 28px; font-weight: 700; letter-spacing: -.5px; font-variant-numeric: tabular-nums; }
.pk-hero .hero-note { display: block; margin-top: 12rpx; font-size: 13px; line-height: 1.5; color: #5A6E64; }

/* ---------------- 可折叠分区 ---------------- */
.sec { margin-top: var(--pk-s5); }
.sec-bar { min-height: 88rpx; display: flex; align-items: center; gap: 16rpx; padding: 0 4rpx; }
.sec-bar .s-t { font-size: 17px; line-height: 1.45; font-weight: 600; }
.sec-bar .s-m { flex: 1; min-width: 0; font-size: 13px; color: var(--pk-ink-3); }
.sec-rule { height: 1rpx; background: var(--pk-line); margin: 0 4rpx var(--pk-s3); }
.sec-body > view + view, .sec-body > .stack + .stack { margin-top: 20rpx; }

/* ---------------- 按钮 ---------------- */
.btn {
  box-sizing: border-box; width: 100%; height: var(--pk-cta-h); min-height: 88rpx;
  margin: 0; padding: 0 36rpx; border: 0; border-radius: var(--pk-r-lg);
  background: var(--pk-primary); color: #fff;
  font-size: 16px; line-height: 1.2; font-weight: 600;
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  transition: background var(--pk-dur-fast) var(--pk-ease);
}
.btn::after { border: 0; }
.btn.secondary { background: var(--pk-primary-tint); color: var(--pk-primary-strong); }
.btn.ghost { background: transparent; color: var(--pk-primary); border: var(--pk-border-primary); }
.btn.neutral { background: var(--pk-surface); color: var(--pk-ink); border: var(--pk-border); }
.btn.danger { background: var(--pk-danger-bg); color: var(--pk-danger); }
.btn.md { height: var(--pk-btn-md); min-height: var(--pk-btn-md); font-size: 15px; }
.btn.sm { height: var(--pk-btn-sm); min-height: var(--pk-btn-sm); width: auto; padding: 0 28rpx; border-radius: var(--pk-r-md); font-size: 14px; }
.btn.auto { width: auto; }
.btn.is-disabled, .btn[disabled] { background: var(--pk-surface-sunken); color: var(--pk-ink-4); border-color: transparent; }
.btn.is-pressed { background: var(--pk-primary-pressed); }
.btn.secondary.is-pressed { background: var(--pk-primary-tint-2); }
/* 添加入口：虚线描边，不抢主 CTA 的注意力。设置、切换孩子弹层等多处共用。 */
.add-entry { display: flex; align-items: center; justify-content: center; gap: 12rpx; box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 24rpx; border: 1rpx dashed var(--pk-primary-hairline); border-radius: var(--pk-r-md); color: var(--pk-primary); font-size: 15px; font-weight: 600; }

.btn-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.btn-row.one { grid-template-columns: minmax(0, 1fr); }
.btn-row > .btn { width: 100%; min-width: 0; }

.link-btn { display: inline-flex; align-items: center; gap: 8rpx; min-height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--pk-primary); font-size: 14px; font-weight: 500; }
.link-btn::after { border: 0; }
.icon-btn { flex: 0 0 72rpx; box-sizing: border-box; width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--pk-surface-sunken); display: flex; align-items: center; justify-content: center; }
.icon-btn::after { border: 0; }

/* ---------------- 标签 / 状态 ---------------- */
.pill { display: inline-flex; align-items: center; gap: 8rpx; height: 48rpx; padding: 0 18rpx; border-radius: var(--pk-r-pill); background: var(--pk-primary-tint); color: var(--pk-primary-strong); font-size: 12px; font-weight: 600; white-space: nowrap; }
.pill.att { background: var(--pk-attention-bg); color: var(--pk-attention); }
.pill.dan { background: var(--pk-danger-bg); color: var(--pk-danger); }
.pill.neutral { background: var(--pk-surface-sunken); color: var(--pk-ink-2); }
.pill.info { background: var(--pk-info-bg); color: var(--pk-info); }
.pill.suc { background: var(--pk-success-bg); color: var(--pk-success); }
.pill.line { background: transparent; border: 1rpx solid var(--pk-line-strong); color: var(--pk-ink-2); }
.pill .dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }

.tag-sub { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: var(--pk-r-sm); font-size: 12px; font-weight: 600; }
.sub-mark { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; border-radius: var(--pk-r-lg); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
.tag-sub.s-chinese, .sub-mark.s-chinese { background: var(--pk-sub-chinese-bg); color: var(--pk-sub-chinese); }
.tag-sub.s-math, .sub-mark.s-math { background: var(--pk-sub-math-bg); color: var(--pk-sub-math); }
.tag-sub.s-english, .sub-mark.s-english { background: var(--pk-sub-english-bg); color: var(--pk-sub-english); }
.tag-sub.s-activity, .sub-mark.s-activity { background: var(--pk-sub-activity-bg); color: var(--pk-sub-activity); }
.tag-sub.s-other, .sub-mark.s-other { background: var(--pk-sub-other-bg); color: var(--pk-sub-other); }

.confidence { display: inline-flex; align-items: center; gap: 8rpx; font-size: 12px; font-weight: 600; }
.confidence .bars { display: inline-flex; align-items: flex-end; gap: 4rpx; }
.confidence .bars .b { width: 8rpx; height: 20rpx; border-radius: 2rpx; background: currentColor; opacity: .28; }
.confidence .bars .b.on { opacity: 1; }
.confidence.high { color: var(--pk-success); }
.confidence.medium { color: var(--pk-attention); }
.confidence.low { color: var(--pk-danger); }

/* ---------------- 提示条 ---------------- */
.pk-notice { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; padding: 22rpx 24rpx; box-sizing: border-box; border-radius: var(--pk-r-lg); background: var(--pk-attention-bg); border: 1rpx solid var(--pk-attention-line); color: var(--pk-attention); font-size: 14px; line-height: 1.45; }
.pk-notice .n-txt { flex: 1; min-width: 0; }
.pk-notice.err { background: var(--pk-danger-bg); border-color: var(--pk-danger-line); color: var(--pk-danger); }
.pk-notice.info { background: var(--pk-info-bg); border-color: #D7E2E9; color: var(--pk-info); }
.pk-notice.ai { background: var(--pk-primary-tint); border-color: var(--pk-primary-hairline); color: var(--pk-primary-strong); }
.pk-notice.quiet { background: var(--pk-surface-warm); border-color: var(--pk-line); color: var(--pk-ink-2); }

/* ---------------- 分段控件 / chips ---------------- */
.seg { display: grid; padding: 6rpx; border-radius: var(--pk-r-lg); background: var(--pk-surface-sunken); box-sizing: border-box; }
.seg.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.seg.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.seg > button, .seg > view { box-sizing: border-box; width: 100%; min-width: 0; height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: var(--pk-r-md); background: transparent; color: var(--pk-ink-2); font-size: 14px; line-height: 1.2; font-weight: 500; display: flex; align-items: center; justify-content: center; }
.seg > button::after { border: 0; }
.seg > button.on, .seg > view.on { background: var(--pk-surface); color: var(--pk-primary-strong); font-weight: 600; box-shadow: var(--pk-e2); }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chips > view, .chips > button { box-sizing: border-box; height: 64rpx; margin: 0; padding: 0 26rpx; border: var(--pk-border); border-radius: var(--pk-r-pill); background: var(--pk-surface); color: var(--pk-ink-2); font-size: 13px; line-height: 1.2; font-weight: 500; display: inline-flex; align-items: center; gap: 10rpx; }
.chips > button::after { border: 0; }
.chips > view.on, .chips > button.on { background: var(--pk-primary); border-color: var(--pk-primary); color: #fff; font-weight: 600; }
.chips .cnt { font-size: 12px; opacity: .85; }

/* ---------------- 表单 ---------------- */
.pk-field + .pk-field { margin-top: 28rpx; }
.pk-field .lbl { display: block; margin-bottom: 12rpx; font-size: 13px; font-weight: 600; color: var(--pk-ink-2); }
.pk-field .lbl .opt { margin-left: 12rpx; font-weight: 400; color: var(--pk-ink-3); }
.pk-input, .pk-picker, .pk-textarea { box-sizing: border-box; width: 100%; min-height: 92rpx; padding: 24rpx 28rpx; background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-lg); font-size: 16px; line-height: 1.4; color: var(--pk-ink); }
.pk-picker { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pk-textarea { min-height: 208rpx; }
.pk-input.is-error, .pk-textarea.is-error { border-color: var(--pk-danger); }
.pk-ph { color: var(--pk-ink-4); }
.help { margin-top: 12rpx; font-size: 13px; line-height: 1.5; color: var(--pk-ink-3); }
.err-text { margin-top: 12rpx; font-size: 13px; line-height: 1.5; color: var(--pk-danger); }
.counter { font-size: 12px; color: var(--pk-ink-4); }

/* ---------------- 行列表 ---------------- */
.rowlist { background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-xl); overflow: hidden; }
.rowitem { display: flex; align-items: center; gap: 24rpx; min-height: var(--pk-row-min); padding: 24rpx 28rpx; box-sizing: border-box; }
.rowitem + .rowitem { border-top: var(--pk-border-soft); }
.rowitem .r-t { display: block; font-size: 16px; line-height: 1.45; font-weight: 500; }
.rowitem .r-s { display: block; margin-top: 4rpx; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); }

/* ---------------- 时间线 / 周条 ---------------- */
.tl { position: relative; padding-left: 116rpx; }
.tl::before { content: ""; position: absolute; left: 94rpx; top: 12rpx; bottom: 12rpx; width: 1rpx; background: var(--pk-line); }
.tl-item { position: relative; padding-bottom: 24rpx; }
.tl-time { position: absolute; left: -116rpx; top: 24rpx; width: 80rpx; text-align: right; font-size: 13px; font-weight: 600; color: var(--pk-ink-2); font-variant-numeric: tabular-nums; }
.tl-node { position: absolute; left: -26rpx; top: 34rpx; width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--pk-primary); border: 4rpx solid var(--pk-canvas); box-sizing: content-box; }
.tl-card { background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-lg); padding: 24rpx 28rpx; box-sizing: border-box; }
.tl-card.accent { border-left: 6rpx solid var(--pk-sub-activity); }
.tl-name { display: block; font-size: 16px; line-height: 1.45; font-weight: 600; }
.tl-sub { display: block; margin-top: 4rpx; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); }
.tl-item.past .tl-node { background: var(--pk-ink-4); }
.tl-item.past .tl-time { color: var(--pk-ink-4); }
.tl-item.past .tl-card { background: var(--pk-surface-warm); }
.tl-item.past .tl-name { color: var(--pk-ink-3); }
.tl-item.hint .tl-node { background: var(--pk-attention); }
.tl-item.hint .tl-time { color: var(--pk-attention); }

.week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8rpx; }
.wd { height: 124rpx; border-radius: var(--pk-r-lg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; box-sizing: border-box; }
.wd .w { font-size: 12px; line-height: 1.2; color: var(--pk-ink-3); }
.wd .d { font-size: 16px; line-height: 1.2; font-weight: 600; font-variant-numeric: tabular-nums; }
.wd .m { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--pk-primary-tint-2); }
.wd .m.void { background: transparent; }
.wd.on { background: var(--pk-primary); }
.wd.on .w { color: rgba(255, 255, 255, .78); }
.wd.on .d { color: #fff; }
.wd.on .m { background: rgba(255, 255, 255, .85); }
.wd.today .d { color: var(--pk-primary); }
.wd.dim .d, .wd.dim .w { color: var(--pk-ink-4); }

/* ---------------- FAB ---------------- */
.pk-fab { position: fixed; right: var(--pk-gutter); bottom: calc(var(--pk-s4) + 98rpx + env(safe-area-inset-bottom)); z-index: 12; height: 96rpx; padding: 0 36rpx 0 30rpx; margin: 0; border: 0; border-radius: var(--pk-r-pill); background: var(--pk-primary); color: #fff; font-size: 15px; font-weight: 600; display: inline-flex; align-items: center; gap: 14rpx; box-shadow: var(--pk-e-fab); }
.pk-fab::after { border: 0; }

/* ---------------- 数据展示 ---------------- */
.metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); background: var(--pk-surface); border: var(--pk-border); border-radius: var(--pk-r-xl); padding: 28rpx 8rpx; box-sizing: border-box; }
.metric { text-align: center; position: relative; min-width: 0; }
.metric + .metric::before { content: ""; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 1rpx; background: var(--pk-line-soft); }
.metric .mv { display: block; font-size: 24px; line-height: 1.1; font-weight: 700; letter-spacing: -.4px; font-variant-numeric: tabular-nums; }
.metric .ml { display: block; margin-top: 8rpx; font-size: 12px; line-height: 1.3; color: var(--pk-ink-3); }

.bar-row { display: flex; align-items: center; gap: 20rpx; min-height: 88rpx; }
.bar-row .bn { flex: 0 0 104rpx; font-size: 14px; font-weight: 500; }
.bar-track { flex: 1; min-width: 0; height: 16rpx; border-radius: var(--pk-r-xs); background: var(--pk-surface-sunken); overflow: hidden; }
.bar-fill { height: 100%; border-radius: var(--pk-r-xs); background: var(--pk-primary); }
.bar-row .bv { flex: none; font-size: 13px; color: var(--pk-ink-3); font-variant-numeric: tabular-nums; }

.udot { width: 68rpx; height: 68rpx; margin: 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
.udot.l0 { background: var(--pk-surface-sunken); color: var(--pk-ink-4); }
.udot.l1 { background: #F3EDDC; color: #7C6528; }
.udot.l2 { background: #F0DCC9; color: #8A5526; }
.udot.l3 { background: #E7C7BC; color: #8B4438; }
.udot.pass { background: var(--pk-primary); color: #fff; }
.hbox { width: 100%; max-width: 68rpx; height: 68rpx; margin: 0 auto; border-radius: var(--pk-r-md); }
.hbox.h0 { background: #EBEAE1; }
.hbox.h1 { background: #D5E5DB; }
.hbox.h2 { background: #A9CDBC; }
.hbox.h3 { background: #6DA894; }
.hbox.h4 { background: var(--pk-primary); }
.cell-label { display: block; margin-top: 6rpx; text-align: center; font-size: 11px; line-height: 1.3; color: var(--pk-ink-4); font-variant-numeric: tabular-nums; }
.legend { display: flex; align-items: center; gap: 10rpx; font-size: 12px; color: var(--pk-ink-3); }
.legend .sw { width: 24rpx; height: 24rpx; border-radius: 6rpx; }

.pager { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; }
.pager .pbtn { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; min-height: 60rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--pk-surface-sunken); display: flex; align-items: center; justify-content: center; }
.pager .pbtn::after { border: 0; }
.pager .pbtn.off { opacity: .35; }
.pager .plabel { flex: 1; min-width: 0; text-align: center; font-size: 13px; font-weight: 600; }
.pager .plabel .psub { display: block; font-size: 11px; font-weight: 400; color: var(--pk-ink-3); }
.pdots { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 16rpx; }
.pdots .pd { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--pk-line-strong); }
.pdots .pd.on { width: 28rpx; border-radius: 6rpx; background: var(--pk-primary); }

/* ---------------- 照片上传 ---------------- */
.upload-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.up-tile { box-sizing: border-box; height: 208rpx; margin: 0; padding: 0; border-radius: var(--pk-r-xl); border: 1rpx dashed var(--pk-primary-hairline); background: var(--pk-primary-tint); color: var(--pk-primary-strong); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; font-size: 14px; line-height: 1.3; font-weight: 600; }
.up-tile::after { border: 0; }
.up-tile.alt { background: var(--pk-surface); border: 1rpx dashed var(--pk-line-strong); color: var(--pk-ink-2); }
.pgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.pcell { position: relative; width: 100%; height: 0; padding-bottom: 100%; border-radius: var(--pk-r-lg); overflow: hidden; background: var(--pk-surface-sunken); }
.pcell .pimg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pcell .rm { position: absolute; top: 8rpx; right: 8rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: rgba(29, 43, 36, .62); color: #fff; font-size: 14px; display: flex; align-items: center; justify-content: center; }
.pcell .idx { position: absolute; left: 10rpx; bottom: 10rpx; height: 36rpx; padding: 0 12rpx; border-radius: 18rpx; background: rgba(29, 43, 36, .55); color: #fff; font-size: 11px; font-weight: 600; display: flex; align-items: center; font-variant-numeric: tabular-nums; }
.pcell .prog { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, .66); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: var(--pk-primary-strong); }
.pcell.add { border: 1rpx dashed var(--pk-line-strong); background: var(--pk-surface); }
.pcell.add .ph-center { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; color: var(--pk-ink-3); }
.prog-line { height: 8rpx; border-radius: 4rpx; background: var(--pk-surface-sunken); overflow: hidden; }
.prog-line .pf { display: block; height: 100%; border-radius: 4rpx; background: var(--pk-primary); transition: width var(--pk-dur-base) var(--pk-ease); }

/* ---------------- 浮层 ---------------- */
.pk-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 20; background: rgba(24, 36, 30, .45); }
.pk-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 85vh; box-sizing: border-box; background: var(--pk-surface); border-radius: var(--pk-r-2xl) var(--pk-r-2xl) 0 0; box-shadow: var(--pk-e-sheet); padding: 16rpx var(--pk-gutter) calc(24rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.pk-sheet .handle { flex: none; width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--pk-line-strong); margin: 0 auto 24rpx; }
.sheet-head { flex: none; display: flex; align-items: flex-start; gap: 20rpx; padding-bottom: 24rpx; }
.sheet-title { display: block; font-size: 18px; line-height: 1.4; font-weight: 700; }
.sheet-sub { display: block; margin-top: 6rpx; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); }
.sheet-body { flex: 1; min-height: 0; overflow-y: auto; }
.sheet-foot { flex: none; padding-top: 24rpx; }

.asheet { position: fixed; left: 16rpx; right: 16rpx; bottom: 16rpx; z-index: 21; }
.asheet .grp { background: rgba(252, 251, 246, .98); border-radius: var(--pk-r-xl); overflow: hidden; }
.asheet .grp .ttl { padding: 24rpx; text-align: center; font-size: 13px; line-height: 1.45; color: var(--pk-ink-3); border-bottom: var(--pk-border-soft); }
.asheet .grp .it { min-height: 112rpx; display: flex; align-items: center; justify-content: center; gap: 16rpx; font-size: 17px; font-weight: 500; color: var(--pk-ink); }
.asheet .grp .it + .it { border-top: var(--pk-border-soft); }
.asheet .grp .it.dan { color: var(--pk-danger); }
.asheet .cancel { margin-top: 16rpx; min-height: 112rpx; border-radius: var(--pk-r-xl); background: #fff; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 600; margin-bottom: env(safe-area-inset-bottom); }

/* ---------------- 吸底操作条 ---------------- */
.pk-cta-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 12; box-sizing: border-box; padding: 24rpx var(--pk-gutter) calc(24rpx + env(safe-area-inset-bottom)); background: rgba(244, 243, 236, .94); border-top: var(--pk-border); box-shadow: var(--pk-e1); }

/* ---------------- 空态 / 骨架 ---------------- */
.pk-empty { text-align: center; padding: 80rpx 48rpx; }
.pk-empty .em { width: 128rpx; height: 128rpx; margin: 0 auto 28rpx; border-radius: 50%; background: var(--pk-primary-tint); display: flex; align-items: center; justify-content: center; }
.pk-empty .et { display: block; font-size: 16px; line-height: 1.45; font-weight: 600; }
.pk-empty .ec { display: block; margin-top: 12rpx; font-size: 14px; line-height: 1.5; color: var(--pk-ink-3); }
.pk-empty .ea { margin-top: 32rpx; }
.pk-empty.inline { padding: 44rpx 24rpx; }
.pk-empty.inline .et { font-size: 14px; font-weight: 400; color: var(--pk-ink-3); }

.sk { border-radius: var(--pk-r-xl); background: linear-gradient(100deg, #EBEAE2 20%, #F4F3EC 42%, #EBEAE2 64%); background-size: 300% 100%; animation: pk-sk 1.4s ease infinite; }
.sk.hero-sk { height: 192rpx; border-radius: var(--pk-r-2xl); }
.sk.card-sk { height: 232rpx; }
.sk.h20 { height: 40rpx; border-radius: var(--pk-r-md); }
.sk.h14 { height: 28rpx; border-radius: 14rpx; }
.sk + .sk { margin-top: 20rpx; }
@keyframes pk-sk { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }

/* ---------------- 布局工具 ---------------- */
.flex { display: flex; align-items: center; gap: 16rpx; }
.flex.top { align-items: flex-start; }
.flex.between { justify-content: space-between; }
.flex.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.mt1 { margin-top: 8rpx; }
.mt2 { margin-top: 16rpx; }
.mt3 { margin-top: 24rpx; }
.mt4 { margin-top: 32rpx; }
.mt5 { margin-top: 40rpx; }
.mt6 { margin-top: 48rpx; }
.hairline { height: 1rpx; background: var(--pk-line-soft); }
.safe-tail { height: calc(40rpx + env(safe-area-inset-bottom)); }
