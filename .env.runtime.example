# Docker Compose 应用运行变量示例。复制为 .env.runtime 后填写；该真实文件被 Git 和 Docker 忽略。
# 只放应用进程确实需要的变量，禁止放 WECHAT_CLI_PRIVATE_KEY、云账号 Token 等开发者凭据。
PUSH_KIDS_ENV=development
PUSH_KIDS_DATABASE_URL=sqlite:///./data/push_kids.db
PUSH_KIDS_MEDIA_ROOT=./uploads
PUSH_KIDS_MEDIA_BACKEND=local
PUSH_KIDS_AI_PROVIDER=ark
PUSH_KIDS_RUN_WORKER=true
PUSH_KIDS_CORS_ORIGINS=http://localhost:3000
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260628

# 本地容器连接 MySQL 时改用下列变量，并移除 PUSH_KIDS_DATABASE_URL。
# MYSQL_ADDRESS=host.docker.internal:3306
# MYSQL_USERNAME=push_kids_app
# MYSQL_PASSWORD=
# MYSQL_DATABASE=push_kids
